layout {
    cwd "/Users/alexcollier/Documents/projects"
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        pane size="22%" name="worktrees" command="/Users/alexcollier/.local/bin/wt-sidebar"
        pane size="43%" name="hub" focus=true command="/usr/bin/env" {
            args "WT_HUB=1" "/Users/alexcollier/.local/bin/claude" "-n" "hub"
        }
        pane size="35%" name="review" command="/Users/alexcollier/.local/bin/wt-hub-pane" {
            args "idle" "/Users/alexcollier/Documents/projects"
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
