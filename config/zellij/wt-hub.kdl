layout {
    cwd "/Users/alexcollier/Documents/projects"
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:/Users/alexcollier/.local/share/wt-hub/zjstatus-v0.25.0.wasm" {
                format_left   "#[fg=#7E9CD8,bold] ◆ hub  {pipe_agents}"
                format_right  "{mode}{tabs}#[fg=#727169] {datetime} "
                format_space  ""
                pipe_agents_format     "{output}"
                pipe_agents_rendermode "raw"
                mode_locked          ""
                mode_normal          "#[fg=#1F1F28,bg=#E6C384,bold] {name} #[fg=#727169] Ctrl g: lock  "
                mode_default_to_mode "normal"
                tab_active    "#[fg=#DCD7BA,bold] {name} "
                tab_normal    "#[fg=#727169] {name} "
                tab_separator "#[fg=#54546D]│"
                datetime          "{format}"
                datetime_format   "%H:%M"
                datetime_timezone "America/Toronto"
            }
        }
    }
    tab name="hub" focus=true {
        pane split_direction="vertical" {
            pane size="22%" name="worktrees" command="/Users/alexcollier/.local/bin/wt-sidebar"
            pane size="43%" name="hub" focus=true command="/usr/bin/env" {
                args "WT_HUB=1" "/Users/alexcollier/.local/bin/claude" "-n" "hub"
            }
            pane size="35%" name="review" command="/Users/alexcollier/.local/bin/wt-hub-pane" {
                args "review"
            }
        }
    }
}
