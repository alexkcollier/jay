{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/jay-run --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JAY_NOTIFY_LOG=$HOME/.local/state/jay/notify.log $HOME/.local/bin/jay-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/jay-snapshot"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/jay-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/jay-snapshot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/jay-snapshot"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "JAY_NOTIFY_LOG=$HOME/.local/state/jay/notify.log $HOME/.local/bin/jay-notify"
          }
        ]
      }
    ]
  }
}
