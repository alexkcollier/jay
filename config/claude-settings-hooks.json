{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/hub-run --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "WT_NOTIFY_LOG=$HOME/.local/state/claude-notify.log $HOME/.local/bin/claude-notify"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-turn-snapshot"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-turn-snapshot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-turn-snapshot"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "WT_NOTIFY_LOG=$HOME/.local/state/claude-notify.log $HOME/.local/bin/claude-notify"
          }
        ]
      }
    ]
  }
}
