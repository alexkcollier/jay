#!/usr/bin/env bash
# wt-hub-edit <file|dir> [line] — open a file in the hub's Neovim (files pane).
set -uo pipefail
source "$HOME/.local/lib/wt-lib.sh"
target=$1 line=${2:-}
[[ "$target" == /* ]] || target="$PWD/$target"
wtl_hub_show_files
if [[ -d "$target" ]]; then
  wtl_nvim_send ":cd $(printf '%q' "$target")<CR>"
else
  wtl_nvim_send ":drop $(printf '%q' "$target")<CR>${line:+:$line<CR>zz}"
fi
