#!/usr/bin/env bash
# wt-hub-lazygit turns <chain id> | commits — lazygit as the hub's review (WT_REVIEW=lazygit in
# ~/.config/wt-hub/config). Run it in the worktree; wt-hub-pane does.
# turns:   lazygit cannot open a hidden ref: it logs HEAD and lists refs/heads only. So it runs
#          on a view repo, ~/.local/state/wt-hub/lazygit/views/<chain id>: a repo of its own that
#          borrows the worktree's objects (objects/info/alternates). Its branch `turns` is the
#          chain head (checked out), `turns-base` is the base and a main branch (in the view's
#          .git/lazygit.yml), so the turns show as unmerged and the history under them as merged.
#          Its index marks each file skip-worktree, so its empty work tree has no changes.
#          A commit, branch or rebase in lazygit changes only the view, never your repo.
#          Every 2 s the chain's tip goes into the view: the running turn (refs/wt-turns/<id>/live,
#          on top of head) while the agent works, else the head. At the end of the turn the live
#          commit goes and the turn's commit takes its place. lazygit sees the branch move and
#          refreshes by itself (git.autoDetectExternalChanges, 0.66). A refresh keeps the
#          selected commit, so when the newest turn was selected, the pane types `<` (top) and
#          the new turn is selected. A replaced live commit keeps its row. A chain that does not
#          exist yet gives an empty view that fills when the chain comes.
# commits: lazygit on the worktree itself, on its commits panel. lazygit refreshes on a new
#          commit by itself.
# Config:  CONFIG_DIR keeps lazygit's state (recent repos) out of yours; LG_CONFIG_FILE loads
#          your config.yml, then the hub's (~/.config/wt-hub/lazygit/hub.yml, from
#          config/lazygit) over it.
# claude-turn-snapshot --prune removes the view with its chain.
# --toggle (the hub's t in lazygit): switch turns ⇄ commits and stop lazygit; wt-hub-pane
#          starts the other mode.
set -uo pipefail
# Exported: lazygit's e runs wt-sidebar, which acts on this session.
export WT_HUB_SESSION=${ZELLIJ_SESSION_NAME:-${WT_HUB_SESSION:-hub}}
source "$HOME/.local/lib/wt-lib.sh"

if [[ "${1:-}" == --toggle ]]; then
  wtl_hub_toggle_mode
  [[ -n "${WT_HUB_LG_PID:-}" ]] && kill -TERM "$WT_HUB_LG_PID"
  exit 0
fi

mode=${1:-turns} id=${2:-}
root="$HOME/.local/state/wt-hub/lazygit"
mkdir -p "$root"
user_config="$(env -u CONFIG_DIR -u LG_CONFIG_FILE lazygit --print-config-dir 2>/dev/null)/config.yml"
hub_config="$HOME/.config/wt-hub/lazygit/hub.yml"
if [[ ! -f "$hub_config" ]]; then
  # wt-hub-pane clears the screen when this ends: wait until the message is read.
  printf '\n  %s is missing: run ./install.sh in wt-hub.\n  Enter: try again.\n' "$hub_config"
  read -r _
  exit 1
fi
configs=$hub_config
[[ -f "$user_config" ]] && configs="$user_config,$hub_config"
export CONFIG_DIR="$root/state" LG_CONFIG_FILE="$configs" WT_HUB_LG_PID=$$
mkdir -p "$CONFIG_DIR"

if [[ "$mode" == commits || -z "$id" ]]; then
  exec lazygit log
fi

view="$root/views/$id"
git_view() { GIT_DIR="$view/.git" GIT_WORK_TREE="$view" git "$@"; }

# The commits panel's position, "<selected> <count>", from its frame ("─3 of 8─╯").
position() {
  [[ -n "${ZELLIJ_PANE_ID:-}" ]] || return 1
  zellij -s "$WT_HUB_SESSION" action dump-screen -p "terminal_$ZELLIJ_PANE_ID" 2>/dev/null \
    | sed -nE 's/.*─([0-9]+) of ([0-9]+)─╯.*/\1 \2/p' | head -1
}

# The newest commit of the chain: the running turn (live, on top of head), else the last turn.
# When the turn ends, the live commit goes and the turn's commit takes its place.
tip() {
  git rev-parse -q --verify "refs/wt-turns/$id/live" || git rev-parse -q --verify "refs/wt-turns/$id/head"
}

# Put the chain's tip and base into the view. The index comes first and is complete before the
# branch moves: lazygit refreshes when the branch moves. Returns 1 when nothing changed.
sync_view() {
  local head base index
  head=$(tip) || return 1
  base=$(git rev-parse -q --verify "refs/wt-turns/$id/base") || return 1
  [[ "$(git_view rev-parse -q --verify refs/heads/turns 2>/dev/null)" == "$head" ]] && return 1
  index="$view/.git/index.wt-hub"
  GIT_INDEX_FILE="$index" git_view read-tree "$head" || return 1
  GIT_INDEX_FILE="$index" git_view ls-files -z | GIT_INDEX_FILE="$index" git_view update-index -z --skip-worktree --stdin
  mv -f "$index" "$view/.git/index"
  git_view update-ref refs/heads/turns-base "$base"
  git_view update-ref refs/heads/turns "$head"
}

if [[ ! -d "$view/.git" ]]; then
  git init -q -b turns "$view" || exit 1
  printf '%s\n' "$(git rev-parse --path-format=absolute --git-common-dir)/objects" >"$view/.git/objects/info/alternates"
  printf 'git:\n  mainBranches: [turns-base]\n' >"$view/.git/lazygit.yml"
fi
sync_view || true

# The view follows the chain while lazygit runs ($$ is lazygit after the exec), and stops in 2 s
# when lazygit ends (q, t, a retarget).
(
  trap 'exit 0' TERM
  last=$(tip)
  while kill -0 $$ 2>/dev/null; do
    sleep 2
    read -r sel count < <(position) || sel=""
    head=$(tip)
    [[ "$head" == "$last" ]] && continue
    last=$head
    sync_view
    # On the newest turn: wait for lazygit's refresh (the new turns push the selection down),
    # then go to the top. Not when the selection is elsewhere (or a popup hides the frame).
    [[ "$sel" == 1 ]] || continue
    for _ in 1 2 3 4 5 6 7 8; do
      sleep 0.5
      read -r now total < <(position) || continue
      if ((total > count)); then
        ((now == total - count + 1)) && zellij -s "$WT_HUB_SESSION" action write-chars -p "terminal_$ZELLIJ_PANE_ID" '<' >/dev/null 2>&1
        break
      fi
    done
  done
) &
cd "$view" && exec lazygit log
