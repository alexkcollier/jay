#!/usr/bin/env bash
# jay agents [path]  Claude sessions (all repos, or one worktree) in fzf; needs-input first.
# Enter: `jay go` — attach to a background agent, or select an interactive one's tab and pane.
# jay agents --json  `claude agents --json --all` with each agent's .phase (input, failed,
#                    unread, working, idle; see jay_agent_phases), for jay all and the mod.
# Only the sessions whose folder is in JAY_ROOTS, and the hub Claude (jay_claude_agents).
# jay agents --orchestrators [main checkout]  The orchestrator of each repo (◇ in the hub list),
# one line each: main checkout<TAB>id<TAB>name.
set -euo pipefail
source "$HOME/.local/lib/jay-lib.sh"

if [[ "${1:-}" == --orchestrators ]]; then
  jay_orchestrators "${2:+$(jay_toplevel "$2")}"
  exit 0
fi

agents=$(jay_claude_agents) || agents='[]'
agents=$(jay_agent_phases "$agents")
if [[ "${1:-}" == --json ]]; then
  printf '%s\n' "$agents"
  exit 0
fi

filter=${1:-}
[[ -n "$filter" ]] && filter=$(jay_toplevel "$filter")

# Two agents with the same name (made outside the hub, see jay_unique_name): the id after it.
list=$(jq -r --arg f "$filter" '
  def lname: .name // "" | ascii_downcase;
  (map(lname) | group_by(.) | map(select(length > 1 and .[0] != "") | .[0])) as $dup
  | .[] | select($f == "" or .cwd == $f or (.cwd | startswith($f + "/")))
  | ({input: 0, failed: 1, unread: 2, working: 3}[.phase] // 4) as $rank
  | [$rank, .phase, .kind, (.id // ""), .sessionId, .cwd,
     ((.name // "") + (if lname | IN($dup[]) then " " + (.id // .sessionId[0:8]) else "" end))] | @tsv' <<<"$agents" | sort -n)

[[ -n "$list" ]] || { echo "No Claude sessions${filter:+ in $filter}."; exit 0; }

rows=$(while IFS=$'\t' read -r _ state kind id sid cwd name; do
  IFS=$'\t' read -r client repo branch _ < <(jay_describe "$cwd")
  printf '%-8s %-10s %-11s %-36s %s\t%s\t%s\t%s\t%s\n' "$state" "$client" "$repo" "${branch:0:36}" "$name" "$kind" "$id" "$sid" "$cwd"
done <<<"$list")

choice=$(fzf --delimiter=$'\t' --with-nth=1 --no-sort --layout=reverse \
  --header='Enter: go to the agent' <<<"$rows") || exit 0
IFS=$'\t' read -r _ kind id sid cwd <<<"$choice"
exec jay-go "$sid"
