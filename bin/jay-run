#!/usr/bin/env bash
# jay run — long-running commands (dev servers, watchers, docker compose) in the hub, in a tab per
# worktree, where you and agents both see them. Each pane outside the "hub" tab is a task: a shell
# you type in, or a pane that jay run started. Output stays in the hub's scrollback (zellij or
# tmux): no log files. The tasks tabs are windows in the tmux hub.
#   jay run [-n name] [-w [-t s]] [--] <command...>   a new pane in this worktree's tab, in this
#                            folder. -w: wait until it listens (see wait). Without the hub: runs here.
#   jay run ls [--json]      the tasks: name, state, ports, worktree, command; and the ones that a
#                            hub restart took (state gone), with the command that starts them again
#   jay run log <task> [-n lines | --all]   what the pane shows, as plain text (default 100 lines)
#   jay run wait <task> [-t seconds]   wait until the task listens on a port; print its URLs
#   jay run stop <task>      Ctrl-C to the task; a pane that jay run started closes
#   jay run restart <task>   stop and start again, in the same pane (panes that jay run started)
#   jay run port <port>      who listens on a port
# <task>: a name, a pane id (terminal_3, %3 in tmux, or 3), or a part of the command or folder.
set -uo pipefail
source "$HOME/.local/lib/jay-lib.sh"

# The hub's own tab (list, agent, review); every other tab of the hub is a worktree's tasks tab.
HUB_TAB=hub
STATE_DIR="$JAY_HUB_STATE/tasks"
# A record of each task that jay run started (see record_task), and of the ones a hub restart took.
STARTED="$STATE_DIR/started"
GONE="$STATE_DIR/gone"
SELF="$HOME/.local/bin/jay-run"

die() { printf 'jay run: %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,15s/^# \{0,1\}//p' "$0"; }

# The values of jq array $1 on one line, split by \x1f: `read` with a tab IFS would merge empty
# fields.
fields() { jq -r "$1"' | map(tostring) | join("\u001f")'; }

hub_answers() {
  jay_mux_alive
}

# The number of pane id $1 (3 for terminal_3 or %3), for the names of state files.
pane_n() { printf '%s\n' "${1##*[!0-9]}"; }

# The command line of args "$@": one arg is a shell string as it is; several are quoted.
command_line() {
  if (($# == 1)); then
    printf '%s\n' "$1"
  else
    local out="" a
    for a in "$@"; do out+="${out:+ }$(printf '%q' "$a")"; done
    printf '%s\n' "$out"
  fi
}

# A short name for a command line: the program, and its first word when that is a short
# subcommand ("pnpm dev", "docker compose"); "run" and "exec" give way to the script after them.
short_name() {
  jq -rn --arg c "$1" '$c | split(" ") | map(select(length > 0 and (test("^[A-Za-z_][A-Za-z0-9_]*=") | not)))
    | (if .[0] == "env" then .[1:] else . end)
    | (if (.[1] == "run" or .[1] == "exec") and (.[2] // "" | test("^[^-]")) then [.[0]] + .[2:] else . end)
    | ((.[0] // "shell") | split("/") | last) as $a | (.[1] // "") as $b
    | if ($b | test("^[A-Za-z][A-Za-z0-9:_.-]{0,19}$")) then "\($a) \($b)" else $a end'
}

# --- The pane side: `jay-run --exec <command line>` runs in each pane that jay run starts ---

# The command runs in the foreground, in the pane's process group (no job control here), so
# Ctrl-C reaches it and all its children; this loop ignores it and goes on. `jay run restart`
# writes <pid>.stopping and <pid>.again and stops the command from outside; the loop then waits
# until the restart has stopped all of it (<pid>.stopping goes, at most 30 s) and starts it
# again. Else the restart, which waits for this loop's children to end, would stop the new run.
# The command runs as you would type it: zsh and bash read your rc file (aliases, mise), with
# job control off (+m), so the command stays in this group. JAY_TASK_SHELL overrides it.
run_pane() {
  local cmd=$1 rc r var line i sh=()
  for var in $(compgen -e | grep -E '^(CLAUDE|ANTHROPIC)'); do unset "$var"; done
  if [[ -n "${JAY_TASK_SHELL:-}" ]]; then
    read -ra sh <<<"$JAY_TASK_SHELL"
  else
    case $(basename "${SHELL:-zsh}") in
      zsh | bash) sh=("${SHELL:-/bin/zsh}" -i +m -c) ;;
      *) sh=("$SHELL" -l -c) ;;
    esac
  fi
  mkdir -p "$STATE_DIR"
  trap ':' INT
  while :; do
    for i in $(seq 300); do [[ -f "$STATE_DIR/$$.stopping" ]] || break; sleep 0.1; done
    rm -f "$STATE_DIR/$$.exit" "$STATE_DIR/$$.again" "$STATE_DIR/$$.stopping"
    printf '\e[2m$ %s\e[0m\n' "$cmd"
    "${sh[@]}" "$cmd"
    rc=$?
    [[ -f "$STATE_DIR/$$.again" ]] && { printf '\n'; continue; }
    printf '%s\n' "$rc" >"$STATE_DIR/$$.exit"
    printf '\n\e[2mexited (%s) · Enter: run again · q: close\e[0m\n' "$rc"
    # bash 3.2's read -t returns 1 on a time-out, as on end of input: read single keys, and
    # look for a restart each second.
    while :; do
      line=""
      read -r -s -n 1 -t 1 line; r=$?
      ((r == 0)) && [[ -z "$line" ]] && break
      [[ "$line" == q ]] && { rm -f "$STATE_DIR/$$.exit"; exit "$rc"; }
      [[ -f "$STATE_DIR/$$.again" ]] && break
    done
  done
}

# The pids of the processes under pid $1, one per line.
descendants() {
  local child IFS=$' \t\n'
  for child in $(pgrep -P "$1"); do
    printf '%s\n' "$child"
    descendants "$child"
  done
}

# Stop a command: Ctrl-C (SIGINT) to process group $1 first, so docker compose stops its
# containers; after 10 s TERM, after 5 s more KILL. With $2 (the pid of a jay run pane, which is
# in that group and ignores Ctrl-C), only its children are stopped, and the processes under them
# now: turbo's dev servers, on ptys of their own, can stop after turbo. Fails when they still run.
stop_group() {
  local group=$1 keep=${2:-} step tree=""
  [[ -n "$keep" ]] && tree=$(descendants "$keep")
  alive() {
    local p
    if [[ -n "$keep" ]]; then
      pgrep -P "$keep" >/dev/null && return 0
      for p in $tree; do kill -0 "$p" 2>/dev/null && return 0; done
      return 1
    fi
    kill -0 -- "-$group" 2>/dev/null
  }
  for step in INT TERM KILL; do
    case $step in
      INT) kill -INT -- "-$group" 2>/dev/null ;;
      TERM) if [[ -n "$keep" ]]; then jay_kill_children "$keep"; kill -TERM $tree 2>/dev/null; else kill -TERM -- "-$group" 2>/dev/null; fi ;;
      KILL) if [[ -n "$keep" ]]; then pkill -KILL -P "$keep"; kill -KILL $tree 2>/dev/null; else kill -KILL -- "-$group" 2>/dev/null; fi ;;
    esac
    for _ in $(seq $([[ $step == INT ]] && echo 100 || echo 50)); do alive || return 0; sleep 0.1; done
  done
  ! alive
}

# --- The tasks: panes of the tasks tab, with their processes and ports ---

# The pid of the hub's server.
hub_server() { jay_mux_server_pid; }

# One line per pane of the hub: root pid<TAB>tty<TAB>foreground pid<TAB>pids (,)<TAB>foreground command.
# The pids are the root's process tree, not the processes on its tty: turbo, for one, runs each
# dev server on a pty of its own.
pane_procs() {
  local srv
  srv=$(hub_server)
  [[ -n "$srv" ]] || return 0
  ps -ax -o pid=,ppid=,tpgid=,tty=,command= | awk -v srv="$srv" '
    { cmd = $0; sub(/^ *[0-9]+ +[0-9]+ +-?[0-9]+ +[^ ]+ +/, "", cmd)
      tty[$1] = $4; tp[$1] = $3; c[$1] = cmd
      kids[$2] = kids[$2] " " $1
      if ($2 == srv && $4 != "??") roots[$1] = 1 }
    END { for (r in roots) { fg = (tp[r] in c) ? tp[r] : r
            tree = r; todo = kids[r]
            while (todo != "") {
              n = split(todo, q, " "); todo = ""
              for (i = 1; i <= n; i++) { tree = tree "," q[i]; todo = todo kids[q[i]] }
            }
            printf "%s\t%s\t%s\t%s\t%s\n", r, tty[r], fg, tree, c[fg] } }'
}

# Ports that pids listen on: pid<TAB>port lines, from one lsof call.
listen_ports() {
  lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null | awk '
    /^p/ { p = substr($0, 2) } /^n/ { n = $0; sub(/.*:/, "", n); print p "\t" n }' | sort -u
}

# Current folders of pids $1 (comma list): pid<TAB>cwd lines.
proc_cwds() {
  [[ -n "$1" ]] || return 0
  lsof -a -d cwd -p "$1" -Fpn 2>/dev/null | awk '/^p/ { p = substr($0, 2) } /^n/ { print p "\t" substr($0, 2) }'
}

# Ports that docker publishes for a compose project in folder $1, or for `docker run -p` in
# command line $2.
docker_ports() {
  local dir=$1 cmd=$2
  if [[ "$cmd" =~ docker[[:space:]]+compose|docker-compose ]]; then
    (cd "$dir" 2>/dev/null && perl -e 'alarm 3; exec @ARGV' docker compose ps --format json 2>/dev/null) \
      | jq -r 'if type == "array" then .[] else . end | .Publishers[]? | select(.PublishedPort > 0) | .PublishedPort' 2>/dev/null
  fi
  grep -oE '(-p|--publish)[ =]+([0-9.]+:)?[0-9]+:[0-9]+' <<<"$cmd" | sed -E 's/.*[ =]([0-9.]+:)?([0-9]+):[0-9]+$/\2/'
}

# The tasks as one JSON array.
# The panes of the tasks tabs with their processes, one JSON object per line. --light: without
# the ports (no lsof for them), for the launcher.
panes_raw() {
  local panes procs fgs listen="" cwds
  hub_answers || return 1
  panes=$(jay_mux_panes) || return 1
  procs=$(pane_procs)
  fgs=$(cut -f3 <<<"$procs" | paste -sd, -)
  [[ "${1:-}" == --light ]] || listen=$(listen_ports)
  cwds=$(proc_cwds "$fgs")
  jq -sc --arg hub "$HUB_TAB" --arg procs "$procs" --arg listen "$listen" --arg cwds "$cwds" --arg self "jay-run --exec " '
    def lines: split("\n") | map(select(length > 0) | split("\t"));
    ($procs | lines | map({root: (.[0] | tonumber), tty: .[1], fg: (.[2] | tonumber),
                           pids: (.[3] | split(",") | map(tonumber)), fgcmd: .[4]}) | sort_by(.root)) as $R
    | ($listen | lines | reduce .[] as $l ({}; .[$l[0]] += [$l[1] | tonumber])) as $L
    | ($cwds | lines | map({key: .[0], value: .[1]}) | from_entries) as $C
    # Not the short-lived panes of the keys (jay-run --switch, --launcher; hub-run in old binds).
    | [.[] | select(.tab != $hub
                    and ((.launch // "") | test("(jay|hub)-run --(switch|launcher|pick)") | not))] | sort_by(.n)
    # A pane gets its own root process when the backend gives its pid (tmux). Else the first
    # free root process whose foreground command is the pane command, in the same folder when
    # there is one (panes and roots both go in start order). When zellij gives no command (it
    # can be null), the only free root in the pane folder.
    | reduce .[] as $p ({used: [], out: []};
        .used as $used
        | (if $p.exited then null
           elif $p.pid != null then first($R[] | select(.root == $p.pid)) // null
           else
            [$R[] | select(.root as $r | $used | index([$r]) | not)] as $free
            | ([$free[] | select(.fgcmd == ($p.command // "\u0000"))]
               | ((map(select($C[.fg | tostring] == $p.cwd)) + .) | first))
              // ([$free[] | select($C[.fg | tostring] == $p.cwd)] | if length == 1 then .[0] else null end)
          end) as $m
        | .used += (if $m then [$m.root] else [] end)
        | .out += [{pane: $p, proc: $m}])
    | .out[]
    | .pane as $p | .proc as $m
    # A shell at its prompt: a default pane, or a free shell that jay run opened ($SHELL -l).
    | ($m != null and $m.fg == $m.root
       and ($p.launch == null or ($m.fgcmd | test("^-?(/[^ ]*/)?(zsh|bash|fish|sh)( -l| -i| --login)*$")))) as $prompt
    | (($p.launch // "") | index($self)) as $at
    | ($at != null) as $owned
    | (if $owned then $p.launch[($at + ($self | length)):] else null end) as $line
    | {id: $p.n, pane: $p.pane, tab: $p.tab, tab_id: $p.tab_id, owned: $owned, title: $p.title,
       root: ($m.root // null), fg: ($m.fg // null), pids: ($m.pids // []),
       state: (if $p.exited then "exited"
               elif $m == null then "unknown"
               elif $owned then (if ($m.pids | length) > 1 then "running" else "exited" end)
               elif $prompt then "idle"
               else "running" end),
       exit: $p.exit,
       command: (if $owned then $line elif $m == null or $prompt then null else $m.fgcmd end),
       cwd: ($C[($m.fg // -1) | tostring] // $p.cwd),
       ports: ([$m.pids[]? | $L[tostring][]?] | unique)}' <<<"$panes"
}

tasks_json() {
  local raw srv
  raw=$(panes_raw) || return 1
  srv=$(hub_server)
  # Exit codes of panes whose command ended (jay-run --exec writes them), names, who started
  # them, worktrees and docker ports.
  local line id root rc name cwd cmd wt dport top branch repo agent project primary
  local -a out=()
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    IFS=$'\x1f' read -r id root name cwd cmd < <(fields '[.id, (.root // ""), (if .owned then .title else "" end), .cwd, (.command // "")]' <<<"$line")
    # The title of a pane that jay run started is its name, with its ports after " · :" (tidy_shells).
    name=${name% · :*}
    rc=""
    [[ -n "$root" && -f "$STATE_DIR/$root.exit" ]] && rc=$(cat "$STATE_DIR/$root.exit")
    agent=$(jq -r '.agent // ""' "$STARTED/$srv-$id.json" 2>/dev/null)
    # A console's command that the launcher typed: its name comes from that line (ps shows the
    # program behind it, as node for pnpm).
    local lf
    lf="$STATE_DIR/console-$id.line"
    if [[ -z "$name" && -n "$cmd" && -f "$lf" ]]; then name=$(short_name "$(cat "$lf")"); fi
    if [[ -z "$name" ]]; then
      if [[ -n "$cmd" ]]; then name=$(short_name "$cmd"); else name=shell; fi
    fi
    # The worktree (repo/branch), its folder, and the project the bar names: the repo for a main
    # checkout, repo/branch for a worktree.
    wt="" project="" primary=""
    if top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
      primary=$(jay_primary "$top")
      repo=$(basename "$primary")
      branch=$(git -C "$top" branch --show-current 2>/dev/null)
      wt="$repo/${branch:-$(basename "$top")}"
      project=$wt
      [[ "$top" == "$primary" ]] && project=$repo
    else
      top=""
    fi
    dport=""
    [[ "$cmd" == *docker* ]] && dport=$(docker_ports "$cwd" "$cmd" | paste -sd, -)
    out+=("$(jq -c --arg rc "$rc" --arg name "$name" --arg wt "$wt" --arg dport "$dport" --arg agent "$agent" \
      --arg top "$top" --arg project "$project" '
      .name = $name | .worktree = (if $wt == "" then null else $wt end)
      | .top = (if $top == "" then null else $top end)
      | .project = (if $project == "" then (.cwd | split("/") | last) else $project end)
      | .agent = (if $agent == "" then null else $agent end)
      | (if $rc != "" then .exit = ($rc | tonumber) else . end)
      | .ports = ((.ports + ($dport | split(",") | map(select(length > 0) | tonumber))) | unique)
      | .urls = [.ports[] | "http://localhost:\(.)"]' <<<"$line")")
  done <<<"$raw"
  # Exit files of panes that are gone.
  local f pid
  for f in "$STATE_DIR"/[0-9]*.exit; do
    [[ -f "$f" ]] || continue
    pid=${f##*/}; pid=${pid%.exit}
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
  [[ -n "$srv" ]] && tidy_records "$srv" " $(jq -r .id <<<"$raw" | tr '\n' ' ') "
  printf '%s\n' ${out[@]+"${out[@]}"} | jq -s .
}

# --- Task records: <server pid>-<pane id>.json in $STARTED, for each pane that jay run starts ---
# zellij starts the pane ids at 0 again in each new hub, so the hub's server pid is in the key. A
# record says who started the task (the agent's key, as a pick in the list has it: see
# cmd_switch) and how to start it again after a hub restart, which takes all panes with it.

# Record the task that jay run started in pane id $2 of server $1: name $3, command line $4.
record_task() {
  local srv=$1 id=$2 name=$3 line=$4 agent="" cwd f
  [[ -n "$srv" ]] || return 0
  [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]] && agent=$(jay_agent_key "$CLAUDE_CODE_SESSION_ID")
  cwd=$(pwd -P)
  mkdir -p "$STARTED"
  jq -nc --arg name "$name" --arg cwd "$cwd" --arg line "$line" --arg agent "$agent" \
    '{name: $name, cwd: $cwd, line: $line, agent: (if $agent == "" then null else $agent end), started: (now | floor)}' \
    >"$STARTED/$srv-$id.json"
  # The same task that a hub restart took: it runs again.
  for f in "$GONE"/*.json; do
    [[ -f "$f" ]] || continue
    jq -e --arg n "$name" --arg c "$cwd" '.name == $n and .cwd == $c' "$f" >/dev/null 2>&1 && rm -f "$f"
  done
  return 0
}

# Records of server $1, whose panes are ids $2 (" 3 4 "): a closed pane's record goes (not in its
# first 10 s: the list of panes may be older than the pane). A record of an earlier server is a
# task that a hub restart took: it moves to $GONE, whose file time is then the restart, for a day.
tidy_records() {
  local srv=$1 ids=$2 f key now
  now=$(date +%s)
  for f in "$STARTED"/*.json; do
    [[ -f "$f" ]] || continue
    key=${f##*/}; key=${key%.json}
    if [[ "${key%%-*}" != "$srv" ]]; then
      mkdir -p "$GONE"
      mv -f "$f" "$GONE/" && touch "$GONE/${f##*/}"
    elif [[ "$ids" != *" ${key#*-} "* ]] && ((now - $(stat -f %m "$f") > 10)); then
      rm -f "$f"
    fi
  done
  find "$GONE" -name '*.json' -mtime +1 -delete 2>/dev/null
  return 0
}

# The command that starts gone task $1 (a record, as JSON) again.
start_again() {
  local cwd name line sq="'" esc="'\\''"
  IFS=$'\x1f' read -r cwd name line < <(fields '[.cwd, .name, .line]' <<<"$1")
  # The line in single quotes: one arg, which jay run runs as a shell line.
  printf "cd %q && jay run -n %q -w -- '%s'\n" "$cwd" "$name" "${line//$sq/$esc}"
}

# The tasks that a hub restart took, as a JSON array, oldest first: the records, with .gone (the
# time of the restart), .file and .start (the command that starts the task again).
gone_tasks() {
  local f rec
  for f in "$GONE"/*.json; do
    [[ -f "$f" ]] || continue
    rec=$(jq -c --arg t "$(stat -f %m "$f")" --arg f "$f" '. + {gone: ($t | tonumber), file: $f}' "$f" 2>/dev/null) || continue
    jq -c --arg s "$(start_again "$rec")" '.start = $s' <<<"$rec"
  done | jq -s 'sort_by(.gone)'
}

# The text for gone task $1: when it went, and how to start it again.
gone_text() {
  jq -r '"\(.name) is gone: the hub started again at \(.gone | strflocaltime("%H:%M")), and its pane went with the old hub. Start it again with:\n  \(.start)"' <<<"$1"
}

# The task that selector $1 names, as JSON. Fails with a message when none or several match;
# for a task that a hub restart took, the message says how to start it again. --forget ($2, for
# stop): such a task is forgotten, and the output is a line that says so, not JSON.
find_task() {
  local sel=$1 tasks found n gone
  tasks=$(tasks_json) || die "the hub does not answer (start it with: jay)"
  found=$(jq -c --arg s "$sel" '
    ($s | ascii_downcase) as $l
    | ($s | sub("^(terminal_|%)"; "")) as $id
    | (map(select(.pane == $s or (.id | tostring) == $id))) as $byid
    | (map(select((.name | ascii_downcase) == $l))) as $byname
    | (map(select([.name, (.command // ""), .cwd, (.worktree // "")] | map(ascii_downcase) | any(contains($l))))) as $bypart
    | ([$byid, $byname, $bypart] | map(select(length > 0)) | first // [])
    | if length > 1 and any(.state != "idle") then map(select(.state != "idle")) else . end' <<<"$tasks")
  n=$(jq length <<<"$found")
  if ((n == 0)); then
    gone=$(gone_tasks | jq -c --arg s "$sel" '($s | ascii_downcase) as $l
      | (map(select((.name | ascii_downcase) == $l)) | last)
        // (map(select([.name, .line, .cwd] | map(ascii_downcase) | any(contains($l)))) | last) // empty')
    if [[ -n "$gone" && "${2:-}" == --forget ]]; then
      rm -f "$(jq -r .file <<<"$gone")"
      jq -r '"\(.name): gone already (the hub started again at \(.gone | strflocaltime("%H:%M"))); jay run forgets it"' <<<"$gone"
      exit 0
    fi
    [[ -n "$gone" ]] && die "$(gone_text "$gone")"
    die "no task matches \"$sel\" (jay run ls)"
  fi
  if ((n > 1)); then
    printf 'jay run: %s tasks match "%s"; use a pane id:\n' "$n" "$sel" >&2
    jq -r '.[] | "  \(.pane)  \(.name)  \(.worktree // .cwd)"' <<<"$found" >&2
    exit 1
  fi
  jq -c '.[0]' <<<"$found"
}

# The tasks tab of the worktree (or folder outside git) that holds $1: its name, and its label
# for the banner. "<repo>/<branch>", with the client when there is one, so that two clients'
# repos of the same name get two tabs.
tab_name() {
  local client repo branch top
  IFS=$'\t' read -r client repo branch top < <(jay_describe "$1")
  if [[ -n "$client" && "$client" != "$repo" ]]; then printf '%s/%s · %s\n' "$repo" "$branch" "$client"
  else printf '%s/%s\n' "$repo" "$branch"; fi
}

tab_id_of() {
  jay_mux_tab_id "$1"
}

# The id of the tasks tab of the worktree that holds $1. A worktree without one gets it, with
# the banner and the bar, without moving the view.
ensure_tab() {
  local top name tid
  top=$(jay_toplevel "$1")
  name=$(tab_name "$top")
  tid=$(tab_id_of "$name")
  [[ -n "$tid" ]] && { printf '%s\n' "$tid"; return 0; }
  tid=$(jay_mux_tab_new "$name" "$top")
  [[ -n "$tid" ]] && printf '%s\n' "$tid"
}

# Ctrl g Tab (a zellij Run binding, in a pane that closes at once): from the hub tab to the
# tasks tab of the worktree picked in the hub (made when it has none); from any other tab back
# to the hub tab. With an agent picked whose worktree runs no task, the tab of the newest task
# that agent started (a dev server in another worktree). Its pane shows a hidden review too (see
# jay_hub_keep_hidden).
cmd_switch() {
  local active dir agent tid="" tasks
  jay_hub_keep_hidden "$(jay_mux_self)"
  active=$(jay_mux_active_tab)
  if [[ "$active" != "$HUB_TAB" ]]; then
    jay_mux_tab_go "$HUB_TAB"
    return 0
  fi
  IFS=$'\t' read -r dir agent 2>/dev/null <"$(jay_hub_target_file review)"
  [[ -n "$dir" && -d "$dir" ]] || dir=${JAY_ROOTS%%:*}
  if [[ -n "$agent" ]] && tasks=$(tasks_json 2>/dev/null); then
    tid=$(jq -r --arg t "$(tab_name "$(jay_toplevel "$dir")")" --arg a "$agent" '
      if any(.[]; .tab == $t and .state == "running") then empty
      else [.[] | select(.agent == $a)] | max_by(.id) // empty | .tab_id end' <<<"$tasks")
  fi
  [[ -n "$tid" ]] || tid=$(ensure_tab "$dir") || return 0
  jay_mux_tab_go_id "$tid"
}

# Ctrl g t (zellij: a Run binding in a floating pane; tmux: a popup): all tasks of the hub in
# fzf, by project, name and state; Enter goes to that task's tab.
cmd_pick() {
  local tasks line
  jay_hub_keep_hidden "$(jay_mux_self)"
  if ! tasks=$(tasks_json 2>/dev/null); then
    printf 'The hub does not answer.\n'; sleep 2; return 1
  fi
  if [[ "$(jq '[.[] | select(.state == "running" or .state == "exited")] | length' <<<"$tasks")" == 0 ]]; then
    printf '\n  No tasks run. jay run <command> or Ctrl g r starts one.\n'
    read -r -s -n 1 -t 5 _ || true
    return 0
  fi
  line=$(jq -r '
    def c($x): "\u001b[" + $x + "m";
    def pad($n): (. + (" " * $n))[0:$n];
    [.[] | select(.state == "running" or .state == "exited")] | sort_by(.project, .name) | .[]
    | (if .state == "running" then c("32") + "● running" elif (.exit // 0) == 0 then c("2") + "○ ended  " else c("31") + "✗ failed " end) as $state
    | [(.tab_id | tostring), (.project | pad(28)) + "  " + (.name | pad(20)) + "  " + $state + c("0")
       + (if .ports != [] then c("2") + "  :" + (.ports | map(tostring) | join(",")) + c("0") else "" end)] | @tsv' <<<"$tasks" \
    | fzf --ansi --delimiter=$'\t' --with-nth=2 --no-sort --layout=reverse --info=hidden \
        --prompt='task ❯ ' --header='Enter: its tab · Esc: close' --pointer='▌' --color=pointer:173) || return 0
  jay_mux_tab_go_id "${line%%$'\t'*}"
}

# Ctrl g r (a zellij Run binding, in a floating pane): a prompt that starts a command with
# jay run, in the picked worktree (from the hub tab) or in the worktree of the tasks tab you are
# on. With zsh it is your own zsh (your .zshrc: completion, aliases, history, prompt) whose Enter
# hands the line to jay run and closes the pane; its prompt is only "❯". JAY_LAUNCHER (a command)
# replaces it, for other shells; else another shell gets a plain prompt. The pane is one line
# (the binding's size): its title says where the command runs.
cmd_launcher() {
  local tabs active tid dir name zd line
  jay_hub_keep_hidden "$(jay_mux_self)"
  tabs=$(jay_mux_tabs)
  active=$(jq -r 'select(.active) | .name' <<<"$tabs" | head -1)
  if [[ "$active" == "$HUB_TAB" || -z "$active" ]]; then
    dir=$(cut -f1 "$(jay_hub_target_file review)" 2>/dev/null)
  else
    tid=$(jq -r 'select(.active) | .id' <<<"$tabs" | head -1)
    dir=$(tasks_json 2>/dev/null | jq -r --arg t "$tid" 'first(.[] | select((.tab_id | tostring) == $t) | .cwd) // empty')
  fi
  [[ -n "$dir" && -d "$dir" ]] || dir=${JAY_ROOTS%%:*}
  dir=$(jay_toplevel "$dir")
  name=$(tab_name "$dir")
  cd "$dir" || exit 1
  jay_mux_rename "$(jay_mux_self)" "run in $name · Enter: run · Ctrl-C: cancel"
  if [[ -n "${JAY_LAUNCHER:-}" ]]; then
    JAY_LAUNCH_IN=$name exec /bin/sh -c "$JAY_LAUNCHER"
  fi
  if [[ "$(basename "${SHELL:-}")" != zsh ]]; then
    HISTFILE="$STATE_DIR/launcher.history"
    set -o history
    history -r "$HISTFILE" 2>/dev/null
    read -r -e -p '❯ ' line || exit 0
    [[ -n "${line//[[:space:]]/}" ]] || exit 0
    history -s "$line"; history -w "$HISTFILE" 2>/dev/null
    "$SELF" --launch -- "$line" || { read -r -s -n 1 -p 'Press a key.' _; }
    exit 0
  fi
  # zsh reads its startup files from ZDOTDIR: ours load yours ($HOME), then the .zshrc adds the
  # launcher's Enter.
  zd="$STATE_DIR/zdotdir"
  mkdir -p "$zd"
  for f in .zshenv .zprofile .zlogin; do
    printf '[[ -f "$HOME/%s" ]] && source "$HOME/%s"\n' "$f" "$f" >"$zd/$f"
  done
  cat >"$zd/.zshrc" <<'ZSH'
ZDOTDIR=$HOME
[[ -f "$HOME/.zshrc" ]] && source "$HOME/.zshrc"
# Enter: the line goes into your history and to jay run (in this worktree's tasks tab), and the
# launcher closes. An empty line or Ctrl-C closes it.
_jay_launch() {
  if [[ -z ${BUFFER//[[:space:]]/} ]]; then BUFFER=' exit'; zle .accept-line; return; fi
  print -s -- "$BUFFER"
  JAY_LINE=$BUFFER
  BUFFER=' _jay_run'
  zle .accept-line
}
_jay_run() {
  "$HOME/.local/bin/jay-run" --launch -- "$JAY_LINE" || read -sk1 '?Press a key.'
  exit
}
_jay_nohist() { [[ $1 != ' _jay_run'* && $1 != ' exit'* ]]; }
zshaddhistory_functions+=(_jay_nohist)
zle -N _jay_launch
bindkey '^M' _jay_launch
bindkey '^J' _jay_launch
TRAPINT() { exit 0; }
# One line: the pane title says where the command runs.
PROMPT='%F{green}❯%f ' RPROMPT=''
ZSH
  ZDOTDIR=$zd exec "$SHELL" -i -l
}

# The tasks tab of worktree $1, for the list's remove (jay-sidebar): --name prints its name (read
# it before `wt remove`: the name comes from git); --tasks prints its running tasks ("  name:
# command" lines, for the confirm). `--close-tab <name>` closes it.
cmd_worktree_tab() {
  local name
  name=$(tab_name "${1:?}")
  case ${2:-} in
    --name) printf '%s\n' "$name" ;;
    --tasks) tasks_json 2>/dev/null | jq -r --arg t "$name" '.[] | select(.tab == $t and .state == "running") | "  \(.name): \(.command // "")"' ;;
  esac
  return 0
}

cmd_close_tab() {
  local tid
  tid=$(tab_id_of "${1:?}")
  [[ -n "$tid" ]] && jay_mux_tab_close "$tid"
  return 0
}

# --- Commands ---

cmd_start() {
  local name="" wait=0 secs=120 launch=0 line tid pane
  while (($#)); do
    case $1 in
      -n) name=${2:-}; shift 2 || die "-n needs a name" ;;
      -w) wait=1; shift ;;
      --launch) launch=1; shift ;;
      -t) secs=${2:-}; shift 2 || die "-t needs seconds" ;;
      --) shift; break ;;
      -*) die "unknown option $1 (jay run -h)" ;;
      *) break ;;
    esac
  done
  (($#)) || { usage >&2; exit 2; }
  line=$(command_line "$@")
  [[ -n "$name" ]] || name=$(short_name "$line")
  if ! hub_answers; then
    if [[ -t 0 && -t 1 ]]; then
      printf '\e[2mjay run: the hub does not run; this runs here, where agents cannot see it\e[0m\n' >&2
      exec "${SHELL:-/bin/zsh}" -lc "$line"
    fi
    die "the hub does not run, so nobody would see this task. Ask the user to start it (jay)"
  fi
  ((launch)) && { console_run "$line"; return; }
  # The same command, running in the same folder: show that one, do not start a second one.
  local same
  same=$(tasks_json | jq -c --arg l "$line" --arg d "$(pwd -P)" \
    '[.[] | select(.state == "running" and .command == $l and .cwd == $d)] | first // empty')
  if [[ -n "$same" ]]; then
    jq -r '"jay run: this runs already: \(.name) (\(.pane))" + (if .urls != [] then " · " + (.urls | join(" ")) else "" end)' <<<"$same" >&2
    exit 1
  fi
  tid=$(ensure_tab "$PWD") || die "the hub did not open a tab for $(tab_name "$PWD")"
  pane=$(jay_mux_tab_pane "$tid" "$name" "$PWD" "$SELF" --exec "$line") || die "the hub did not open the pane"
  [[ -n "$pane" ]] && record_task "$(hub_server)" "$(pane_n "$pane")" "$name" "$line"
  printf '%s: started in the hub, tab %s (%s)\n' "$name" "$(tab_name "$PWD")" "$pane"
  if ((wait)); then
    sleep 1
    cmd_wait "$pane" -t "$secs"
  else
    printf 'jay run log %s · jay run wait %s\n' "$pane" "$pane"
  fi
}

# --- Consoles: the free shell of each tasks tab ---
# The launcher types its line into the console of the worktree's tab. A command that ends
# leaves no pane behind (its output stays in the console); one that runs on makes the console
# its task pane, and the tick opens a new console.

# A line that ends in a prompt sign: the shell waits for input.
PROMPT_END='(%|\$|#|>|❯|➜)[[:space:]]*$'

# The pane lines of $1 (a dump), without the blank rows under the last line.
trim_dump() { awk '{ a[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print a[i] }'; }

# The console of tab id $1: "<pane id><TAB>root pid<TAB>cwd" of its newest shell at its
# prompt; fails when it has none.
console_of() {
  panes_raw --light 2>/dev/null | jq -rs --arg t "$1" \
    '[.[] | select((.tab_id | tostring) == $t and .state == "idle" and (.owned | not))] | max_by(.id) // empty
     | "\(.pane)\t\(.root)\t\(.cwd)"' | grep .
}

# jay run --launch <line> (the launcher's Enter), in folder $PWD. The line goes into the console
# (Ctrl-E Ctrl-U first, to drop any typed text; a leading space keeps it out of the console's
# history, as the launcher saved it already; a cd when the console is elsewhere). For up to 2 s
# the launcher watches it: a command that ends shows the console's new lines in the launcher,
# which grows to fit them, until a key. One that runs on: the launcher closes.
console_run() {
  local line=$1 dir tid pane p root cwd before i started=0 ended=0 tp out h cd="" self
  dir=$(pwd -P)
  tid=$(ensure_tab "$dir") || die "the hub did not open a tab for $(tab_name "$dir")"
  if ! IFS=$'\t' read -r pane root cwd < <(console_of "$tid"); then
    # A new tab's console, or the one the tick opens, may still start: take the newest shell
    # pane of the tab that has no command, else open one; then wait up to 3 s for its prompt.
    pane=$(jay_mux_panes | jq -rs --arg t "$tid" \
      '[.[] | select((.tab_id | tostring) == $t and (.exited | not) and .title == "console")] | max_by(.n) // empty | .pane')
    if [[ -z "$pane" ]]; then
      pane=$(jay_mux_tab_pane "$tid" console "$dir" "${SHELL:-/bin/zsh}" -l 2>/dev/null)
    fi
    [[ -n "$pane" ]] || die "no console in $(tab_name "$dir")"
    root="" cwd=""
    for i in $(seq 15); do
      sleep 0.2
      IFS=$'\t' read -r p root cwd < <(console_of "$tid") && [[ "$p" == "$pane" ]] && break
      root="" cwd=""
    done
  fi
  [[ "$cwd" == "$dir" ]] || cd="cd -- $(printf '%q' "$dir") && "
  before=$(jay_mux_read "$pane" --full | trim_dump | wc -l)
  jay_mux_type "$pane" $'\x05\x15'" $cd$line"$'\r'
  printf '%s\n' "$line" >"$STATE_DIR/console-$(pane_n "$pane").line"
  # A console that did not reach its prompt in time gets the line too (its shell reads it when
  # it is ready), but the launcher does not wait for the output.
  [[ -n "$root" ]] || return 0
  # Ended: the shell has the terminal again, after the command took it; or, for a command too
  # short to see (or a builtin), a new prompt under the typed line. After 1 s at the latest.
  local now
  for i in $(seq 40); do
    sleep 0.05
    tp=$(ps -o tpgid= -p "$root" 2>/dev/null | tr -d ' ')
    [[ -n "$tp" ]] || break
    if [[ "$tp" != "$root" ]]; then started=1; continue; fi
    ((started || i >= 20)) && { ended=1; break; }
    now=$(jay_mux_read "$pane" --full | trim_dump)
    if (($(wc -l <<<"$now") > before + 1)) && tail -1 <<<"$now" | grep -qE "$PROMPT_END"; then ended=1; break; fi
  done
  ((ended)) || return 0
  sleep 0.1
  out=$(jay_mux_read "$pane" --full | trim_dump \
    | awk -v from="$((before > 0 ? before : 1))" 'NR >= from')
  self=$(jay_mux_self)
  if [[ -t 1 && -n "$self" ]]; then
    h=$(($(printf '%s\n' "$out" | wc -l) + 3))
    ((h > 30)) && h=30
    jay_mux_float_height "$self" "$h"
    sleep 0.1
    clear
    printf '%s\n\e[2many key: close\e[0m' "$out"
    read -r -s -n 1 _ </dev/tty
  elif [[ -t 1 ]] && jay_mux_popup_text "$out" "$(tab_name "$dir"): $line"; then
    # tmux: the launcher's popup cannot grow; a popup of the output's size follows it.
    :
  else
    printf '%s\n' "$out"
  fi
  return 0
}

# jay-run --show <file>: the text of a file and "any key: close", for a popup of the tmux hub
# (jay_mux_popup_text); the file goes after the key.
cmd_show() {
  local file=${1:?}
  cat "$file" 2>/dev/null
  printf '\e[2many key: close\e[0m'
  read -r -s -n 1 _ </dev/tty
  rm -f "$file"
}

cmd_ls() {
  local tasks gone
  tasks=$(tasks_json) || die "the hub does not answer (start it with: jay)"
  gone=$(gone_tasks)
  if [[ "${1:-}" == --json ]]; then
    # The gone tasks after the others, without a pane: .start starts one again.
    jq -n --argjson t "$tasks" --argjson g "$gone" '$t + [$g[] | {pane: null, tab: null, owned: true,
      name, state: "gone", command: .line, cwd, agent, ports: [], urls: [],
      gone: (.gone | todate), start}]'
    return
  fi
  if [[ "$(jq length <<<"$tasks")" == 0 ]]; then
    printf 'No tasks tabs in the hub (Ctrl g Tab, or jay run <command>, opens one).\n'
  else
    jq -r --arg home "$HOME" '
      ["PANE", "TAB", "NAME", "STATE", "PORTS", "WHERE", "COMMAND"],
      (.[] | [.pane, .tab, .name,
              (if .state == "exited" then "exited \(.exit // "?")" else .state end),
              (if .ports == [] then "-" else (.ports | map(tostring) | join(",")) end),
              (.worktree // (.cwd | sub("^" + $home; "~"))),
              (.command // "-" | sub("^/[^ ]*/"; ""))])
      | @tsv' <<<"$tasks" | column -t -s $'\t'
  fi
  [[ "$(jq length <<<"$gone")" == 0 ]] && return 0
  printf '\nGone with a hub restart (jay run stop <name> forgets one); start one again with its line:\n'
  jq -r '.[] | "  \(.name) (\(.gone | strflocaltime("%H:%M"))): \(.start)"' <<<"$gone"
}

cmd_log() {
  local sel="" lines=100 task pane
  while (($#)); do
    case $1 in
      -n) lines=${2:-}; shift 2 || die "-n needs a number" ;;
      --all) lines=all; shift ;;
      *) sel=$1; shift ;;
    esac
  done
  [[ -n "$sel" ]] || die "which task? (jay run ls)"
  task=$(find_task "$sel") || exit 1
  pane=$(jq -r .pane <<<"$task")
  # The screen and scrollback, without the blank rows under the last line.
  jay_mux_read "$pane" --full \
    | awk '{ a[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print a[i] }' \
    | if [[ "$lines" == all ]]; then cat; else tail -n "$lines"; fi
}

cmd_wait() {
  local sel="" secs=120 task end state
  while (($#)); do
    case $1 in
      -t) secs=${2:-}; shift 2 || die "-t needs seconds" ;;
      *) sel=$1; shift ;;
    esac
  done
  [[ -n "$sel" ]] || die "which task? (jay run ls)"
  task=$(find_task "$sel") || exit 1
  sel=$(jq -r .pane <<<"$task")
  end=$((SECONDS + secs))
  while :; do
    task=$(find_task "$sel") || exit 1
    state=$(jq -r .state <<<"$task")
    if [[ "$(jq '.ports | length' <<<"$task")" != 0 ]]; then
      sleep 1
      find_task "$sel" | jq -r '"\(.name) listens: " + (.urls | join(" "))'
      return 0
    fi
    if [[ "$state" == exited || "$state" == idle ]]; then
      printf 'jay run: %s ended (%s) before it listened. Its last lines:\n' "$(jq -r .name <<<"$task")" "$(jq -r '.exit // "?"' <<<"$task")" >&2
      cmd_log "$sel" -n 30 >&2
      return 1
    fi
    ((SECONDS >= end)) && { printf 'jay run: %s does not listen after %s s (jay run log %s)\n' "$(jq -r .name <<<"$task")" "$secs" "$sel" >&2; return 1; }
    sleep 1
  done
}

cmd_stop() {
  local task owned root fg state name pane
  [[ -n "${1:-}" ]] || die "which task? (jay run ls)"
  task=$(find_task "$1" --forget) || exit 1
  # A gone task: find_task forgot it and printed that.
  [[ "$task" == "{"* ]] || { printf '%s\n' "$task"; return 0; }
  IFS=$'\x1f' read -r owned root fg state name pane < <(fields '[.owned, (.root // ""), (.fg // ""), .state, .name, .pane]' <<<"$task")
  if [[ "$owned" == true ]]; then
    [[ -n "$root" ]] && { stop_group "$root" "$root" || die "$name: still runs after Ctrl-C, TERM and KILL"; }
    jay_mux_close "$pane"
    printf '%s: stopped, pane closed\n' "$name"
    return 0
  fi
  [[ "$state" == running && -n "$fg" ]] || die "$name: nothing runs in $pane"
  stop_group "$fg" || die "$name: still runs after Ctrl-C, TERM and KILL"
  printf '%s: stopped (the shell in %s stays)\n' "$name" "$pane"
}

cmd_restart() {
  local task owned root name pane
  [[ -n "${1:-}" ]] || die "which task? (jay run ls)"
  task=$(find_task "$1") || exit 1
  IFS=$'\x1f' read -r owned root name pane < <(fields '[.owned, (.root // ""), .name, .pane]' <<<"$task")
  if [[ "$owned" != true ]]; then
    # A console's command that the launcher typed: stop it, then type that line again.
    local lf fg i again
    lf="$STATE_DIR/console-$(pane_n "$pane").line"
    [[ -f "$lf" ]] || die "$name: a shell pane; stop it (jay run stop $pane) and type the command again there"
    again=$(cat "$lf")
    fg=$(jq -r '.fg // empty' <<<"$task")
    [[ -n "$fg" ]] && { stop_group "$fg" || die "$name: still runs after Ctrl-C, TERM and KILL"; }
    for i in $(seq 20); do [[ "$(ps -o tpgid= -p "$root" | tr -d ' ')" == "$root" ]] && break; sleep 0.1; done
    printf '%s\n' "$again" >"$lf"
    jay_mux_type "$pane" $'\x05\x15'" $again"$'\r'
    printf '%s: restarted in %s\n' "$name" "$pane"
    return 0
  fi
  [[ -n "$root" ]] || die "$name: its pane does not run"
  mkdir -p "$STATE_DIR"
  # The pane loop starts the command again only after .stopping goes (see run_pane).
  : >"$STATE_DIR/$root.stopping"
  : >"$STATE_DIR/$root.again"
  if ! stop_group "$root" "$root"; then
    rm -f "$STATE_DIR/$root.stopping" "$STATE_DIR/$root.again"
    die "$name: still runs after Ctrl-C, TERM and KILL"
  fi
  rm -f "$STATE_DIR/$root.stopping"
  printf '%s: restarted in %s\n' "$name" "$pane"
}

cmd_port() {
  local port=${1:-} pid cmd cwd task tasks ctr
  [[ "$port" =~ ^[0-9]+$ ]] || die "which port?"
  pid=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1)
  [[ -n "$pid" ]] || { printf 'port %s: free\n' "$port"; return 0; }
  if tasks=$(tasks_json 2>/dev/null); then
    task=$(jq -c --argjson pid "$pid" --argjson port "$port" 'first(.[] | select((.pids | index([$pid])) or (.ports | index([$port])))) // empty' <<<"$tasks")
    if [[ -n "$task" ]]; then
      jq -r --arg p "$port" '"port \($p): task \(.name) (\(.pane)) in \(.worktree // .cwd) · jay run stop \(.pane)"' <<<"$task"
      return 0
    fi
  fi
  cmd=$(ps -o command= -p "$pid" 2>/dev/null)
  if [[ "$cmd" == *com.docker* || "$cmd" == *vpnkit* || "$cmd" == *[Dd]ocker* ]]; then
    ctr=$(perl -e 'alarm 3; exec @ARGV' docker ps --filter "publish=$port" \
      --format '{{.Names}} (compose project {{.Label "com.docker.compose.project"}})' 2>/dev/null | head -1)
    printf 'port %s: docker container %s\n' "$port" "${ctr:-?}"
    return 0
  fi
  cwd=$(proc_cwds "$pid" | cut -f2)
  printf 'port %s: pid %s, not a hub task: %s (in %s)\n' "$port" "$pid" "$cmd" "${cwd/#$HOME/~}"
}

# The bar's tasks part, the same text for both hubs (ANSI colors; the tmux backend turns them
# into its styles): per task that runs or ended, its sign, the project it runs in (the repo for a
# main checkout, repo/branch for a worktree) and its name. The tasks of the picked worktree ($2,
# default: review's) come first and bright, the others dim. No ports: jay run ls and the panes'
# titles in the tasks tab have them.
cmd_bar() {
  local tasks=${1:-} picked=${2:-}
  [[ -n "$tasks" ]] || tasks=$(tasks_json 2>/dev/null) || return 0
  [[ -n "$picked" ]] || picked=$(cut -f1 "$(jay_hub_target_file review)" 2>/dev/null)
  jq -r --arg picked "$picked" '
    def c($x): "\u001b[" + $x + "m";
    [.[] | select(.state == "running" or .state == "exited") | . + {here: (.top != null and .top == $picked)}]
    | sort_by(.here | not)
    | map((if .state == "running" then ["32", "●"] elif (.exit // 0) == 0 then ["2", "○"] else ["31", "✗"] end) as [$col, $sign]
        | if .here then c($col) + $sign + c("0") + " " + .project + " " + (.name | .[0:24])
          else c("2") + $sign + " " + .project + " " + (.name | .[0:24]) + c("0") end)
    | join("  ")' <<<"$tasks"
}

# The note of the tasks tab of worktree $2 (a folder; tasks JSON $1): how many tasks run in other
# worktrees, and where. Plain text; empty when none do.
cmd_note() {
  jq -r --arg here "${2:-}" '[.[] | select(.state == "running" and (.top // "") != $here)] | group_by(.project)
    | if length == 0 then "" else
        "\(map(length) | add) running elsewhere: " + (map(.[0].project + (if length > 1 then " (\(length))" else "" end)) | join(", "))
      end' <<<"$1"
}

# Keep one free shell in each tasks tab: when a command takes the last shell at its prompt in a
# tab, open a new one there, in that tab's worktree, without moving the focus. Not while a
# pane's process is unknown (it may be that shell).
spare_shell() {
  local tasks=$1 tid cwd top
  while IFS=$'\t' read -r tid cwd; do
    [[ -n "$tid" ]] || continue
    top=$(jay_toplevel "$cwd")
    jay_mux_tab_pane "$tid" console "$top" "${SHELL:-/bin/zsh}" -l >/dev/null 2>&1
  done < <(jq -r 'group_by(.tab_id)[] | select(all(.[]; .state != "idle" and .state != "unknown"))
    | "\(.[0].tab_id)\t\(.[0].cwd)"' <<<"$tasks")
}

# Shell panes are named for what they are: "console" at the prompt, else the command's name. A
# task that listens has its ports after its name (" · :5173"; tasks_json takes them off again). A
# tab keeps one console (its newest): another one closes after 10 minutes at its prompt (a
# server that ended leaves its last lines there for that long). The idle times are in
# idle-<pane id> files.
tidy_shells() {
  local tasks=$1 pane title want id now since
  now=$(date +%s)
  while IFS=$'\t' read -r pane title want; do
    [[ -n "$pane" && "$title" != "$want" ]] || continue
    jay_mux_rename "$pane" "$want"
  done < <(jq -r '.[] | select(.owned or .state == "idle" or .state == "running")
    | [.pane, .title, (if .state == "idle" and (.owned | not) then "console"
                       else .name + (if .ports != [] then " · :" + (.ports | map(tostring) | join(",")) else "" end) end)]
    | @tsv' <<<"$tasks")
  # A console back at its prompt: the line the launcher typed is done.
  for id in $(jq -r '.[] | select(.state == "idle" and (.owned | not)) | .id' <<<"$tasks"); do
    rm -f "$STATE_DIR/console-$id.line"
  done
  for id in $(jq -r 'group_by(.tab_id)[] | map(select(.state == "idle" and (.owned | not))) | sort_by(.id) | .[:-1][] | .id' <<<"$tasks"); do
    since=$(cat "$STATE_DIR/idle-$id" 2>/dev/null)
    if [[ -z "$since" ]]; then
      printf '%s\n' "$now" >"$STATE_DIR/idle-$id"
    elif ((now - since >= 600)); then
      jay_mux_close "$(jq -r --argjson i "$id" 'first(.[] | select(.id == $i)) | .pane' <<<"$tasks")"
      rm -f "$STATE_DIR/idle-$id" "$STATE_DIR/console-$id.line"
    fi
  done
  # Idle times of panes that are no longer an extra console.
  local keep f
  keep=" $(jq -r 'group_by(.tab_id)[] | map(select(.state == "idle" and (.owned | not))) | sort_by(.id) | .[:-1][] | .id' <<<"$tasks" | tr '\n' ' ') "
  for f in "$STATE_DIR"/idle-*; do
    [[ -f "$f" ]] || continue
    [[ "$keep" == *" ${f##*/idle-} "* ]] || rm -f "$f"
  done
}

# The list's tick (jay-sidebar, every 3 s): a console in each tasks tab, names, the tabs' notes
# (each tab's own in tmux; in zellij one for all, from the picked worktree), then the bar text.
# A note goes out when it changes.
cmd_tick() {
  local tasks picked tid top note notes=""
  tasks=$(tasks_json 2>/dev/null) || return 0
  mkdir -p "$STATE_DIR"
  spare_shell "$tasks"
  tidy_shells "$tasks"
  picked=$(cut -f1 "$(jay_hub_target_file review)" 2>/dev/null)
  # The status line cuts the tasks to its width (jay_bar_fit): it reads them from here. A new
  # width draws the line again.
  jay_bar_set tasks.json "$tasks"
  local width
  width=$(jay_mux_width)
  if [[ "$width" != "$(cat "$JAY_BAR/width" 2>/dev/null)" ]]; then
    jay_bar_set width "$width"
    jay_mux_status
  fi
  while IFS=$'\t' read -r tid top; do
    [[ -n "$tid" ]] || continue
    note=$(cmd_note "$tasks" "$top")
    notes+="$tid	$note"$'\n'
    grep -qxF "$tid	$note" "$STATE_DIR/notes" 2>/dev/null || jay_mux_tab_note "$tid" "$note"
  done < <(jq -r 'group_by(.tab_id)[] | "\(.[0].tab_id)\t\(map(.top // empty) | first // "")"' <<<"$tasks")
  note=$(cmd_note "$tasks" "$picked")
  notes+="all	$note"$'\n'
  grep -qxF "all	$note" "$STATE_DIR/notes" 2>/dev/null || jay_mux_bar note "$note"
  printf '%s' "$notes" >"$STATE_DIR/notes"
  cmd_bar "$tasks" "$picked"
}

# The banner of the hub tab (see bin/jay) shows the picked worktree $1 as <repo>/<branch> (a pick
# sends it, see jay_hub_target); without $1, the worktree of the hub's review.
cmd_where() {
  local dir=${1:-} client repo branch top
  [[ -n "$dir" ]] || dir=$(cut -f1 "$(jay_hub_target_file review)" 2>/dev/null)
  [[ -n "$dir" && -d "$dir" ]] || return 0
  IFS=$'\t' read -r client repo branch top < <(jay_describe "$dir")
  jay_mux_bar where "$repo/$branch"
}

# Folder $1 in a linked git worktree (a worktrunk sibling such as ../repo.feat), not under
# .claude/worktrees/: says that it is isolated. Claude's background-job prompt counts only
# .claude/worktrees/ and tells the agent to call EnterWorktree, which makes a second worktree on a
# new branch from origin/main; its edit guard accepts any linked worktree. Nothing in a main
# checkout or outside a repo.
cmd_isolated() {
  local dir=$1 git common top where
  [[ -d "$dir" ]] || return 0
  { read -r git && read -r common && read -r top; } < <(git -C "$dir" rev-parse \
    --path-format=absolute --git-dir --git-common-dir --show-toplevel 2>/dev/null) || return 0
  [[ -n "$top" && "$git" != "$common" && "$top/" != */.claude/worktrees/* ]] || return 0
  if where=$(git -C "$dir" symbolic-ref -q --short HEAD 2>/dev/null); then
    where="the worktree of branch $where"
  else
    where="a worktree detached at $(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
  fi
  cat <<EOF
This folder is $where ($top):
a git worktree of its own, not the shared main checkout of the repo. It is isolated already:
edit here. Do not call EnterWorktree, also when a background-job instruction says to isolate
first (it counts only .claude/worktrees/ as isolated; its edit guard accepts any linked worktree).

EOF
}

# SessionStart hook: tells each Claude session about the tasks tab (stdout becomes context), and
# a session in a linked worktree that it is isolated already (cmd_isolated).
cmd_hook() {
  local input="" dir
  [[ -t 0 ]] || IFS= read -r -d '' -t 2 input || true
  dir=$(jq -r '.cwd // ""' <<<"$input" 2>/dev/null) || dir=""
  cmd_isolated "${dir:-$PWD}"
  cat <<'EOF'
Long-running commands (dev servers, watchers, `docker compose up`): when the user's hub runs, start
them with `jay run -n <name> -w -- <command>` in the folder they run in, not with a background Bash
call. They run in the hub, in the tab of that worktree, where the user sees them, and keep
running after you stop.
`jay run ls --json` lists the tasks (name, state, ports, URLs, worktree, command), also the ones the
user started by hand; `jay run log <task>` shows a task's recent output; `jay run wait <task>`
waits until it listens; `jay run stop|restart <task>`; `jay run port <n>` tells who holds a port
(for "address in use"). Stop or restart only tasks you started, unless the user asks. When
jay run says the hub does not run, use a background Bash call. The user sees a task with Ctrl g
Tab when you or its worktree is picked in the hub list. A hub restart stops all tasks: then
`jay run ls` lists them as gone, with the command that starts each one again.
EOF
}

case ${1:-} in
  -h | --help) usage ;;
  --exec) shift; run_pane "$*" ;;
  # The bar's text and a tab's note; [tasks JSON file [worktree]] in place of the hub's (tests).
  --bar) shift; cmd_bar "${1:+$(cat "$1")}" "${2:-}" ;;
  --note) shift; cmd_note "$(if [[ -n "${1:-}" ]]; then cat "$1"; else tasks_json; fi)" "${2:-}" ;;
  --tick) cmd_tick ;;
  --hook) cmd_hook ;;
  --where) shift; cmd_where "$@" ;;
  --switch) cmd_switch ;;
  --launcher) cmd_launcher ;;
  --pick) cmd_pick ;;
  --show) shift; cmd_show "$@" ;;
  --worktree-tab) shift; cmd_worktree_tab "$@" ;;
  --close-tab) shift; cmd_close_tab "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  log) shift; cmd_log "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  port) shift; cmd_port "$@" ;;
  "") usage >&2; exit 2 ;;
  *) cmd_start "$@" ;;
esac
