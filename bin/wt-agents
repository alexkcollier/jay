#!/usr/bin/env bash
# wt agents [path]  Claude sessions (all repos, or one worktree) in fzf; needs-input first.
# Enter: `wt go` — attach to a background agent, or select an interactive one's tab and pane.
set -euo pipefail
source "$HOME/.local/lib/wt-lib.sh"

filter=${1:-}
[[ -n "$filter" ]] && filter=$(wtl_toplevel "$filter")

list=$(claude agents --json --all 2>/dev/null | jq -r --arg f "$filter" '
  .[] | select($f == "" or .cwd == $f or (.cwd | startswith($f + "/")))
  | (if .state == "blocked" or .status == "waiting" then 0
     elif .state == "working" and .status == "idle" then 2
     elif .state == "working" or (.state == null and .status == "busy") then 1
     elif .state == "failed" then 3 else 4 end) as $rank
  | [$rank, (if $rank == 2 then "waits" else .state // .status end), .kind, (.id // ""), .sessionId, .cwd, (.name // "")] | @tsv' | sort -n)

[[ -n "$list" ]] || { echo "No Claude sessions${filter:+ in $filter}."; exit 0; }

rows=$(while IFS=$'\t' read -r _ state kind id sid cwd name; do
  IFS=$'\t' read -r client repo branch _ < <(wtl_describe "$cwd")
  printf '%-8s %-10s %-11s %-36s %s\t%s\t%s\t%s\t%s\n' "$state" "$client" "$repo" "${branch:0:36}" "$name" "$kind" "$id" "$sid" "$cwd"
done <<<"$list")

choice=$(fzf --delimiter=$'\t' --with-nth=1 --no-sort --layout=reverse \
  --header='Enter: go to the agent' <<<"$rows") || exit 0
IFS=$'\t' read -r _ kind id sid cwd <<<"$choice"
exec wt-go "$sid"
