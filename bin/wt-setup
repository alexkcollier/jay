#!/usr/bin/env bash
# wt setup [path] — copy env files and install deps in a worktree.
# Runs as the worktrunk pre-start hook; safe to re-run by hand.
set -uo pipefail
[[ "${1:-}" == -h || "${1:-}" == --help ]] && { sed -n '2,3s/^# \{0,1\}//p' "$0"; exit 0; }
exec 1>&2

root=$(git -C "${1:-$PWD}" rev-parse --show-toplevel) || exit 1
primary=$(git -C "$root" worktree list --porcelain | awk 'NR==1 { sub(/^worktree /, ""); print; exit }')
cd "$root" || exit 1

if [[ "$root" != "$primary" ]]; then
  if [[ -f .worktreeinclude ]]; then
    wt step copy-ignored --require-include || echo "wt setup: copy-ignored failed"
  else
    while IFS= read -r -d '' src; do
      rel=${src#"$primary"/}
      [[ -e "$root/$rel" ]] && continue
      git -C "$primary" check-ignore -q -- "$rel" || continue
      mkdir -p "$(dirname "$root/$rel")"
      cp -c "$src" "$root/$rel" 2>/dev/null || cp "$src" "$root/$rel"
      echo "wt setup: copied $rel"
    done < <(find "$primary" \( -name node_modules -o -name .git -o -name .claude -o -name .worktrees -o -name dist \) -prune \
      -o -type f -name '.env*' -print0)
  fi
fi

install() {
  local lockfile=$1
  shift
  local was_clean=false
  git diff --quiet -- "$lockfile" 2>/dev/null && was_clean=true
  echo "wt setup: $*"
  "$@" || echo "wt setup: install failed — run it by hand in $root"
  if $was_clean && ! git diff --quiet -- "$lockfile" 2>/dev/null; then
    git checkout -- "$lockfile" && echo "wt setup: install rewrote $lockfile; restored it"
  fi
}

if [[ -f pnpm-lock.yaml ]]; then install pnpm-lock.yaml pnpm install --frozen-lockfile --prefer-offline
elif [[ -f bun.lock ]]; then install bun.lock bun install --frozen-lockfile
elif [[ -f bun.lockb ]]; then install bun.lockb bun install --frozen-lockfile
elif [[ -f yarn.lock ]]; then install yarn.lock yarn install --frozen-lockfile
elif [[ -f package-lock.json ]]; then install package-lock.json npm ci --prefer-offline --no-audit --no-fund
elif [[ -f uv.lock ]]; then install uv.lock uv sync
fi
exit 0
