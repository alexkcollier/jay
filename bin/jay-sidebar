#!/usr/bin/env bash
# jay-sidebar — the hub's live list of worktrees and Claude agents, for a narrow left pane.
# Click: select the row (the keys below act on it). Double-click or Enter: an agent → shown in
# the hub's middle column, and review (tuicr,
# its turns) and files (yazi, when shown) switch to it; a worktree → review and files switch to
# it; "◆ hub" → the hub Claude (a background agent, started when it has none) in the middle
# column. An agent takes the focus to the middle; Enter on a worktree takes it to review. An
# agent that cannot wake ("home gone", "lost") goes on as a copy instead (asks first).
# n/N: new agent here (on a main checkout: the repo's orchestrator, ◇; when the repo has one,
# the hub shows it) / in a new worktree
# c: a fresh context (/clear) for an orchestrator or the hub Claude (asks first; idle only); with
# an old prompt (dim ⇡), also as a new agent with jay's current prompt (jay renew)
# o: own Ghostty tab. Keys act in the list only: review's mode (t) and files (e) are keys of the
# review pane.
# d: remove the agent, or the worktree with its idle agents (asks first; agents that came from
# it and are in another worktree go on there as copies first)
# a: hide/show idle repos (a main checkout row stays while its repo has other rows)
# JAY_ORCHESTRATE: a pick of a row of a listed repo without an orchestrator starts one
# b: an idle interactive session goes on as a background agent (asks first)
# p: prune dead agents (folder gone; asks first). The list also prunes them by itself, every
# 10 minutes, with plain `claude rm` (it keeps an agent whose worktree has work to lose), and
# then the turn chains of gone agents; log in ~/.local/state/jay/prune.log. An agent on an old
# Claude Code (↻) is respawned at a quiet moment (jay_respawn_auto, JAY_AUTO_RESPAWN), same log.
# r: reload this agent list (git signs now; the list starts again: new code and keys too)
# -/+ (= as +): narrower/wider
# ?: keys. No quit key: the list belongs to the hub. fzf's own quit keys (Esc, Ctrl-C, Ctrl-G,
# Ctrl-Q, Ctrl-D) do nothing, and when fzf ends anyway (killed, failed) the list starts again.
# jay-sidebar --files: show files over review (e in the review pane, through jay-keys).
# jay-sidebar --review toggle|show|back: hide or show review (Ctrl g v), show it (Ctrl g 3), close
# files over it (e in yazi).
# jay-sidebar --focus list|agent|review: bring back the hub's panes that are gone, then the focus
# to that column (Ctrl g 1 2 3 of the tmux hub, when a pane is missing).
set -uo pipefail
source "$HOME/.local/lib/jay-lib.sh"

STATE=$JAY_STATE
CACHE="$STATE/worktrees.ndjson"
HIDE_IDLE="$STATE/sidebar.hide-idle"
mkdir -p "$STATE"

# The git signs of the rows, one cell wide, as UTF-8 bytes because bash 3.2 has no \u: Nerd Font
# Octicons (private use) for states; plain arrows ↑ ↓ (East Asian ambiguous, not wide) for
# commits to push / pull, which the small repo-push/pull icons did not make clear; + for
# commits not in main yet, so it does not read as a push. The Octicon home marks the main
# checkout.
G_DIFF=$'\xef\x91\x80' G_UP='+' G_ALERT=$'\xef\x90\xa1' G_OK=$'\xef\x90\xae'
G_MERGE=$'\xef\x90\x99' G_PUSH=$'\xe2\x86\x91' G_PULL=$'\xe2\x86\x93' G_HOME=$'\xef\x91\xad'

refresh_worktrees() {
  jay-all --json >"$CACHE.$$" 2>/dev/null && mv "$CACHE.$$" "$CACHE"
}

# The folders of the agents in JSON $1 that no longer exist (a removed worktree), as a JSON array.
gone_dirs() {
  jq -r '.[] | .cwd // empty' <<<"$1" | sort -u | while IFS= read -r dir; do
    [[ -d "$dir" ]] || printf '%s\n' "$dir"
  done | jq -Rsc 'split("\n") | map(select(. != ""))'
}

rows() {
  local age=999
  [[ -s "$CACHE" ]] && age=$(($(date +%s) - $(stat -f %m "$CACHE")))
  if [[ ! -s "$CACHE" || "${1:-}" == --fresh ]]; then
    refresh_worktrees
  elif ((age > 30)); then
    (refresh_worktrees &) >/dev/null 2>&1
  fi
  local agents jobs stranded stale shown=""
  # The agent in the hub's middle column, marked with ▸ beside it.
  jay_hub_role agent >/dev/null && shown=$(cut -f1 "$(jay_hub_target_file agent)" 2>/dev/null)
  agents=$(jay_claude_agents) || agents='[]'
  agents=$(jay_agent_phases "$agents" "$shown") || agents='[]'
  jobs=$(jay_jobs "$agents")
  # The agents whose home is gone (see jay_stranded), as id: {fix, tree, runs}.
  stranded=$(jay_stranded "$agents" "$jobs" | jq -Rsc 'split("\n") | map(select(. != "") | split("\t")
    | {(.[0]): {tree: .[3], fix: .[4], runs: (.[5] == "1")}}) | add // {}')
  (auto_prune "$agents" &) >/dev/null 2>&1
  # The agents on an old Claude Code (↻), and their respawn at a quiet moment (jay_respawn_auto).
  stale=$(jay_stale "$agents" "$jobs") || stale='{}'
  (jay_respawn_auto "$agents" "$jobs" "$shown" "$stale" &) >/dev/null 2>&1
  # The orchestrators and the hub Claude with an older prompt than jay's (⇡, see jay_prompt_old).
  local oldp
  oldp=$(jay_old_prompts "$agents" "$jobs") || oldp='{}'
  local hideidle=false width
  [[ -f "$HIDE_IDLE" ]] && hideidle=true
  # The text width: fzf's (it sets FZF_COLUMNS for reloads) less the pointer column.
  width=${FZF_COLUMNS:-$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)}
  width=$((${width:-40} - 1))
  jq -rs --argjson agents "$agents" --arg shown "$shown" --arg hubid "$(jay_hub_claude_id)" \
    --argjson hideidle "$hideidle" --arg roots "$JAY_ROOTS" --argjson gone "$(gone_dirs "$agents")" \
    --argjson jobs "$jobs" --argjson orchs "$(jay_orch_ranks "$agents" "$jobs")" \
    --argjson stranded "$stranded" --argjson replaced "$(jay_replaced_ids)" --argjson stale "$stale" \
    --argjson notes "$(jay_agent_notes)" --argjson oldp "$oldp" \
    --argjson gl "$(jq -nc --arg diff "$G_DIFF" --arg up "$G_UP" --arg alert "$G_ALERT" --arg ok "$G_OK" \
      --arg merge "$G_MERGE" --arg push "$G_PUSH" --arg pull "$G_PULL" --arg home "$G_HOME" '$ARGS.named')" \
    --argjson width "$width" --argjson now "$(date +%s)" '
    def c($code): "\u001b[" + $code + "m";
    def age($ms): (($now - ($ms / 1000)) / 60 | floor) as $m
      | if $m < 60 then "\($m)m" elif $m < 2880 then "\($m / 60 | floor)h" else "\($m / 1440 | floor)d" end;
    # The phase comes from jay_agent_phases (jay-lib.sh), the rule of jay all and the mod too.
    def phase: .phase // "idle";
    # When Claude made the agent: a respawn (jay_respawn_auto) gives it a new startedAt.
    def born: $jobs[.id // ""].created // .startedAt // 0;
    # A dim ↻ after an agent that runs an old Claude Code: the list respawns it when it is quiet.
    def stalemark: if .stale then " " + c("2") + "↻" + c("0") else "" end
      # A dim ⇡ after an orchestrator or the hub Claude whose prompt is older than the one jay
      # gives now (jay_old_prompts): c renews it.
      + if .oldprompt then " " + c("2") + "⇡" + c("0") else "" end;
    def glyph: {input: (c("1;33") + "!"), failed: (c("31") + "✗"), unread: (c("1;35") + "✓"),
      working: (c("2;32") + "●"), idle: (c("2") + "○")}[.] + c("0");
    def narrow: [8986,8987,9001,9002,9193,9194,9195,9196,9200,9203,9725,9726,9748,9749,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9855,9875,9889,9898,9899,9917,9918,9924,9925,9934,9940,9962,9970,9971,9973,9978,9981,9989,9994,9995,10024,10060,10062,10067,10068,10069,10071,10133,10134,10135,10160,10175,11035,11036,11088,11093,11904,11905,11906,11907,11908,11909,11910,11911,11912,11913,11914,11915,11916,11917,11918,11919,11920,11921,11922,11923,11924,11925,11926,11927,11928,11929,11931,11932,11933,11934,11935,11936,11937,11938,11939,11940,11941,11942,11943,11944,11945,11946,11947,11948,11949,11950,11951,11952,11953,11954,11955,11956,11957,11958,11959,11960,11961,11962,11963,11964,11965,11966,11967,11968,11969,11970,11971,11972,11973,11974,11975,11976,11977,11978,11979,11980,11981,11982,11983,11984,11985,11986,11987,11988,11989,11990,11991,11992,11993,11994,11995,11996,11997,11998,11999,12000,12001,12002,12003,12004,12005,12006,12007,12008,12009,12010,12011,12012,12013,12014,12015,12016,12017,12018,12019,12032,12033,12034,12035,12036,12037,12038,12039,12040,12041,12042,12043,12044,12045,12046,12047,12048,12049,12050,12051,12052,12053,12054,12055,12056,12057,12058,12059,12060,12061,12062,12063,12064,12065,12066,12067,12068,12069,12070,12071,12072,12073,12074,12075,12076,12077,12078,12079,12080,12081,12082,12083,12084,12085,12086,12087,12088,12089,12090,12091,12092,12093,12094,12095,12096,12097,12098,12099,12100,12101,12102,12103,12104,12105,12106,12107,12108,12109,12110,12111,12112,12113,12114,12115,12116,12117,12118,12119,12120,12121,12122,12123,12124,12125,12126,12127,12128,12129,12130,12131,12132,12133,12134,12135,12136,12137,12138,12139,12140,12141,12142,12143,12144,12145,12146,12147,12148,12149,12150,12151,12152,12153,12154,12155,12156,12157,12158,12159,12160,12161,12162,12163,12164,12165,12166,12167,12168,12169,12170,12171,12172,12173,12174,12175,12176,12177,12178,12179,12180,12181,12182,12183,12184,12185,12186,12187,12188,12189,12190,12191,12192,12193,12194,12195,12196,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283] as $wide | explode | map(select(. < 4352 or (. > 4447 and . < 11904) or (. > 42191 and . < 44032) or (. > 55203 and . < 63744) or (. > 64255 and . < 65040) or (. > 65049 and . < 65072) or (. > 65135 and . < 65280) or (. > 65376 and . < 65504) or (. > 65510 and . < 126976)) | select(. != 65039) | select(. as $c | $wide | index([$c]) | not)) | implode;
    def rank: {input: 0, failed: 1, unread: 2, working: 3, idle: 4}[.];
    def shown: $shown != "" and (.id // .sessionId) == $shown;
    # Names that two agents of the list share (made outside the hub, see jay_unique_name): their
    # rows have the short id after the name.
    ($agents | map(select(.state != "stopped") | .name // "" | ascii_downcase) | group_by(.)
      | map(select(length > 1 and .[0] != "") | .[0])) as $dup
    | def dupid: if (.name // "" | ascii_downcase | IN($dup[])) then " " + c("2") + (.id // .sessionId[0:8]) + c("0") else "" end;
      # An orchestrator (see $mains below) has a cyan ◇ before its name, an extra one a yellow ◇.
      def title: ({main: (c("36") + "◇ " + c("0")), extra: (c("33") + "◇ " + c("0"))}[.orch] // "")
      + (if shown then c("1;36") + (.name | narrow) + c("0") else (.name | narrow) end) + dupid;
    . as $wts
    | ($wts | map(.path) | sort_by(length) | reverse) as $paths
    | def owner($cwd): first($paths[] | select($cwd == . or ($cwd | startswith(. + "/")))) // "";
      # An agent from a main checkout in a worktree it entered stays under its main checkout, and
      # .away is the folder it is in. .orch: main for the orchestrator of the repo (the oldest
      # agent with the orchestrator prompt that belongs to the main checkout, see jay_orch_ranks),
      # extra for another one there, else empty. An agent whose home is gone ($stranded, see
      # jay_stranded) shows also when it is stopped: under the worktree it is in, or, when that is
      # gone too, under the "(gone)" row of its home. A replaced one (a copy goes on) does not show.
      ($wts | map(select(.main) | .path)) as $mains
    | ($wts | map({(.path): .branch}) | add // {}) as $branchof
    | ($agents | map(select(.state != "stopped" or $stranded[.id // ""] != null)
        | select(.id as $i | $replaced | index([$i]) | not)
        | ($jobs[.id // ""].home // "") as $from
        | ($mains | index([$from]) != null) as $o
        | $stranded[.id // ""] as $s
        | (.cwd as $d | $gone | any(. == $d)) as $g
        | $orchs[.sessionId] as $r
        | . + {gone: ($g and ($o | not) and $s.fix != "move"),
               wt: (if $o then $from elif $s.fix == "move" then owner($s.tree) elif $g then "" else owner(.cwd) end),
               stranded: $s, stale: ($stale[.id // ""] != null),
               away: (if $o then $jobs[.id].tree else "" end), phase: phase,
               orch: (if $r == null or ($mains | index([$r.home]) == null) then ""
                      elif $r.rank == 0 then "main" else "extra" end)}
        | .oldprompt = ($oldp[.id // ""] != null and (.orch != "" or .id == $hubid)))) as $all
    # The hub Claude has its own row at the top ("◆ hub"), not one in its folder.
    | (first($all[] | select(.id == $hubid)) // null) as $hubag
    | ($all | map(select(.id != $hubid))) as $ag
    | ($all | map(.phase)) as $phases
    | (["input", "failed", "unread", "working", "idle"] | map(. as $p | ($phases | map(select(. == $p)) | length) as $n
        | select($n > 0) | "\($p | glyph) \($n) \($p)") | join("  ")
        # The count of ↻ goes last, dim: a narrow list cuts it first.
        | . + ($all | map(select(.stale)) | length | if . > 0 then "  " + c("2") + "↻ \(.)" + c("0") else "" end)) as $summary
    # Client › repo › worktree › agent. A client is the folder above the repo; repos right under
    # a root go to "Other" at the bottom. A repo row has its worktrees under it, the main checkout
    # first, then the removed worktrees that still have agents (dim, "(gone)": a folder
    # <repo>.<branch> or one in the repo). Agents in no repo go last, under "no repo". A main
    # checkout without an agent is idle, and so is a repo with only an idle main checkout: both
    # are dim. $hideidle (key a) hides such a repo; an idle main checkout of a repo that shows
    # stays.
    | ($roots | split(":") | map(rtrimstr("/"))) as $rootdirs
    | def byrank: sort_by((.phase | rank), -born);
      ($wts | map(. as $w | . + {agents: ($ag | map(select(.wt == $w.path)) | byrank)}
                 | . + {idle: (.main and (.agents | length == 0))})
        | group_by(.client + "/" + .repo | ascii_downcase)
        | map(first(.[] | select(.main)) as $main | ($main.path // "//none") as $m
              | {client: .[0].client, repo: .[0].repo, main: $main, trees: .,
                 loose: ($rootdirs | index([$m | sub("/[^/]*$"; "")]) != null),
                 dead: ($ag | map(select(.gone and (.cwd | startswith($m + ".") or startswith($m + "/")))) | group_by(.cwd)
                   | map({path: .[0].cwd, agents: byrank,
                          label: (.[0].cwd | if startswith($m + ".") then .[($m | length) + 1:] else split("/") | last end)}))}
              | . + {idle: (all(.trees[]; .idle) and .dead == []),
                     # Two or more workers (agents in its other worktrees) and no orchestrator:
                     # its main checkout row hints at n.
                     hint: (([.trees[] | select(.main | not) | .agents[] | select(.state != "stopped")] | length) >= 2
                            and (any(.trees[] | select(.main) | .agents[]; .orch == "main") | not))})
        | map(select(.main != null))) as $repos
    | ($repos | map(select(.idle)) | length) as $idle
    | ($repos | [.[].dead[].agents[].sessionId]) as $housed
    | ($ag | map(select(.wt == "" and (.sessionId as $s | $housed | index([$s]) | not))) | byrank) as $stray
    | def lead($col): (" " * ($col - 2)) + (if shown then c("1;36") + "▸ " + c("0") else "  " end);
      # A fourth field "repair" (not shown) on an agent that cannot wake: a pick repairs it
      # (jay-sidebar --pick, --repair).
      def agrow($col; $tail): "ag\t" + .sessionId + "\t" + lead($col) + (.phase | glyph) + " " + title + stalemark + " " + c("2") + $tail + c("0")
        + (if .stranded != null and (.stranded.runs | not) then "\trepair" else "" end);
      # An orchestrator in a worktree it entered: "→ <branch>" of that worktree.
      def away: if .away != "" then " → " + (($branchof[owner(.away)] // (.away | split("/") | last)) | split("/") | last | narrow) else "" end;
      # Its home is gone: yellow "home gone" (it can go on in its worktree), red "lost" (that
      # worktree is gone too).
      def homegone: if .stranded == null then "" elif .stranded.fix == "lost" then c("0") + " " + c("31") + "lost"
        else c("0") + " " + c("33") + "home gone" end;
      def bgage: (if .kind == "background" then "bg " else "" end) + age(born) + away + homegone;
      # Git signs: conflicts now or a rebase/merge in progress, uncommitted
      # changes, commits to push / to pull when the branch is on the remote (its tracking branch
      # or origin/<branch>, as for a PR) else commits not in the default branch yet, a merge into
      # the default branch would conflict, safe to remove (empty or integrated).
      def safe: .git.state == "empty" or .git.state == "integrated";
      def gitsigns: .git as $g | [
          (if $g.conflicted or $g.operation != null then c("31") + $gl.merge + c("0") else empty end),
          (if $g.added + $g.deleted > 0 or $g.modified or $g.staged or $g.untracked then c("33") + $gl.diff + c("0") else empty end),
          (if $g.remote then
             (if $g.push > 0 then c("36") + $gl.push + "\($g.push)" + c("0") else empty end),
             (if $g.pull > 0 then c("36") + $gl.pull + "\($g.pull)" + c("0") else empty end)
           elif $g.ahead > 0 and (safe | not) then c("32") + $gl.up + "\($g.ahead)" + c("0") else empty end),
          (if $g.state == "would_conflict" then c("31") + $gl.alert + c("0") else empty end),
          (if safe then c("2") + $gl.ok + c("0") else empty end)
        ] | join(" ");
      def signs: if .git then gitsigns else c("2") + (.symbols | narrow) + c("0") end;
      def cells: gsub("\u001b\\[[0-9;]*m"; "") | length;
      def fit($n): if length > $n then .[:([$n - 1, 1] | max)] + "…" else . end;
      # The tail of an agent row in a worktree that two or more agents share: the age, then the
      # own task note of the agent (jay_agent_notes) in the room left, as a worktree row has its note.
      def notetail($col): bgage as $a | ($notes[.id // ""] // "") as $n
        | if $n == "" then $a else
            ($width - $col - 2 - (title | cells) - (stalemark | cells) - 1 - ($a | cells) - 3) as $room
            | if $room >= 6 then $a + " · " + ($n | narrow | fit($room)) else $a end
          end;
      # A worktree row fits the list ($width): the git signs always show, a long branch name is
      # cut, and the task note shows only in the room left. The main checkout has a home sign
      # before its branch. $hint: the dim "n: orchestrator" at the end, in the room left after
      # the task note.
      def treerow($hint): signs as $s | ($s | cells | if . > 0 then . + 1 else 0 end) as $sw
        | (if .main then $gl.home + " " else "" end) as $m
        | (.branch | split("/") | last | fit([$width - 2 - ($m | length) - $sw, 6] | max)) as $b
        | ($width - 2 - ($m | length) - ($b | length) - $sw - 3) as $room
        | (if .task != "" and $room >= 6 then " · " + (.task | narrow | fit($room)) else "" end) as $t
        | ($room + 2 - ($t | length)) as $left
        | "wt\t" + .path + "\t  " + (if .idle or (.git and safe) then c("2") else "" end) + $m + $b + c("0")
          + (if $sw > 0 then " " + $s else "" end)
          + (if $t != "" then c("2") + $t + c("0") else "" end)
          + (if $hint and $left >= 6 then c("2") + " " + ("n: orchestrator" | fit($left)) + c("0") else "" end);
      # With $hideidle, an idle repo goes; the main checkout row stays while its repo shows: it is
      # the anchor of the other rows of the repo.
      def reporows: select((.idle and $hideidle) | not)
        | .hint as $hint
        | ("repo\t" + .main.path + "\t " + (if .idle then c("2") else c("1") end) + .repo + c("0")),
          (.trees[]
            | treerow(.main and $hint),
              (if (.agents | length) > 1 then (.agents[] | agrow(4; notetail(4))) else (.agents[] | agrow(4; bgage)) end)),
          (.dead[] | ("gone\tgone:" + .path + "\t  " + c("2") + .label + " (gone)" + c("0")),
                     (.agents[] | agrow(4; bgage)));
      def heading($key; $name; $idle): " \tgap:" + $key + "\t ",
        "hdr\thdr:" + $key + "\t" + (if $idle then c("2") else c("1;38;5;173") end) + $name + c("0");
    "sum\tsum\t" + (if $summary == "" then c("2") + "No agents" + c("0") else $summary end),
      ("hub\thub\t" + (if $hubid != "" and $shown == $hubid then c("1;36") + "▸ " + c("0") else "  " end)
         + c("1;36") + "◆ hub" + c("0") + (if $hubag then " " + ($hubag.phase | glyph) + ($hubag | stalemark) else "" end)),
      ($repos | map(select(.loose | not)) | group_by(.client | ascii_downcase)[]
        | select((all(.[]; .idle) and $hideidle) | not)
        | heading(.[0].client; .[0].client; all(.[]; .idle)), (.[] | reporows)),
      ($repos | map(select(.loose))
        | select((map(select((.idle and $hideidle) | not)) | length) + ($stray | length) > 0)
        | heading("other"; "Other"; all(.[]; .idle) and $stray == []), (.[] | reporows),
          ($stray | select(length > 0)
            | ("hdr\thdr:norepo\t " + c("2") + "no repo" + c("0")),
              (.[] | agrow(3; .cwd + (if .gone then " (gone)" else "" end))))),
      (if $hideidle and $idle > 0 then " \tgap:idle\t ",
         "idle\tidle\t" + c("2") + "a shows \($idle) idle repo" + (if $idle > 1 then "s" else "" end) + c("0")
       else empty end)
  ' "$CACHE" | tee >(head -1 | cut -f3 >"${JAY_SIDEBAR_SUM:-/dev/null}") | tail -n +2 \
    | tee >(wc -l | tr -d ' ' >"${JAY_SIDEBAR_COUNT:-/dev/null}")
  # The first row (the agent counts) goes to the status line only (send_sum), not to the list.
}

# Move the focus from the list $1 columns to the right (the hub's middle column is 1, review
# and files are 2).
focus_column() {
  jay_in_hub || return 0
  case $1 in 1) jay_mux_focus agent list ;; 2) jay_mux_focus review list ;; esac
}

# The JSON of the agent with session id $1 (empty when it is gone).
agent_json() {
  jay_claude_agents | jq -c --arg s "$1" 'first(.[] | select(.sessionId == $s)) // empty'
}

# Ctrl g v (toggle: hide or show review) and Ctrl g 3 (show: a hidden review comes back with
# the focus): zellij Run bindings, in a floating pane of one cell that closes when this ends.
# The work waits in the background until that pane is gone, so the focus moves act on the hub's
# own panes. back: e in files (the hub's yazi keys, config/yazi) closes files at once; yazi's
# own quit can wait 5 s for its terminal probe in the tmux hub. The call comes from yazi in the
# files pane, which closes: no wait for that.
review_key() {
  (
    trap '' HUP
    [[ "${1:-}" == back ]] && { jay_hub_locked jay_hub_show_review; exit 0; }
    jay_mux_wait_gone "$(jay_mux_self)"
    case ${1:-toggle} in
      toggle) jay_hub_locked jay_hub_toggle_review ;;
      show) [[ -f "$JAY_HIDDEN" ]] && jay_hub_locked jay_hub_unhide_review --focus ;;
    esac
  ) </dev/null >/dev/null 2>&1 &
}

# Ctrl g 1 2 3 when a pane of the hub is missing (tmux, config/tmux/jay.conf): bring it back, then
# the focus to column $1 (a hidden review is shown).
focus_key() {
  jay_hub_locked jay_hub_repair >/dev/null
  if [[ "$1" == review && -f "$JAY_HIDDEN" ]]; then
    jay_hub_locked jay_hub_unhide_review --focus
  else
    jay_mux_focus "$1"
  fi
}

# Pick row kind $1 with id $2. An agent always moves the focus to the middle
# column (jay_hub_show); a worktree with --focus (Enter) moves it to review. A repo row acts as
# its main checkout. An interactive agent runs in its own terminal, so in the hub the middle
# column only says so, and review shows its turn chain (named after the session id); `o` goes
# to its tab.
pick_interactive() {
  jay_hub_show "$1" "$2" "$3" interactive && jay_hub_target "$3" "${1:0:8}"
}

act() {
  local agent
  case $1 in ag|wt|repo) orchestrate "$1" "$2" ;; esac
  case $1 in
    ag) agent=$(agent_json "$2")
        if jay_in_hub && [[ -n "$agent" && "$(jq -r .kind <<<"$agent")" != background ]]; then
          jay_hub_locked pick_interactive "$2" "$(jq -r '.name // .sessionId[0:8]' <<<"$agent")" "$(jq -r .cwd <<<"$agent")"
        else
          JAY_LIST_PICK=1 jay-go "$2" >/dev/null 2>&1
        fi ;;
    wt|repo) if jay_in_hub; then
          jay_hub_locked jay_hub_target "$2"
          # Enter goes to review, also when it is hidden (Ctrl g v).
          if [[ "${3:-}" == --focus ]]; then
            if [[ -f "$JAY_HIDDEN" ]] && jay_hub_review_hidden >/dev/null; then
              jay_hub_locked jay_hub_unhide_review --focus
            else
              focus_column 2
            fi
          fi
        else
          jay-open "$2" >/dev/null 2>&1
        fi ;;
    hub) JAY_LIST_PICK=1 jay-go hub >/dev/null 2>&1 ;;
  esac
  return 0
}

# JAY_ORCHESTRATE (jay_orchestrate_wanted): the pick of row kind $1 with id $2, in a listed repo
# that has no orchestrator, starts one as n on its main checkout row does, but without a
# question. Only on a pick, never by itself. After a worktree or repo row, the middle column
# says so (mid_note), then shows the new orchestrator, without the focus. After an agent row,
# that agent goes to the middle column as usual, and the orchestrator only comes into the list.
# A repo that Claude does not trust yet gets none: the middle column says to press n (it asks).
# The start runs in the background, so the list does not wait for claude; a stamp per repo keeps
# a second pick in the next minute from starting a second one.
orchestrate() {
  local kind=$1 path primary client repo branch stamp out agent name i
  [[ -n "${JAY_ORCHESTRATE:-}" ]] || return 0
  path=$(path_of "$kind" "$2")
  [[ -n "$path" && -d "$path" ]] || return 0
  primary=$(jay_primary "$(jay_toplevel "$path")")
  [[ -n "$primary" ]] || return 0
  IFS=$'\t' read -r client repo branch _ < <(jay_describe "$primary")
  jay_orchestrate_wanted "$client" "$repo" || return 0
  stamp="$STATE/orchestrate.$(printf '%s' "$primary" | cksum | cut -d' ' -f1)"
  [[ -n "$(find "$stamp" -mmin -1 2>/dev/null)" ]] && return 0
  [[ -z "$(jay_orchestrators "$primary")" ]] || return 0
  if ! jay_trusted "$primary"; then
    [[ "$kind" == ag ]] || mid_note "$repo is in JAY_ORCHESTRATE, but Claude does not trust it yet. n on its main checkout row asks, then starts the orchestrator." "$primary" "$repo"
    return 0
  fi
  touch "$stamp"
  [[ "$kind" == ag ]] || mid_note "Starting the orchestrator of $repo (JAY_ORCHESTRATE)..." "$primary" "$repo"
  (
    trap '' HUP
    out=$(jay_orchestrator_start "$primary" "$repo" "$branch")
    agent=$(jay_bg_id "$out")
    if [[ -z "$agent" ]]; then
      rm -f "$stamp"
      mid_noted "$primary" && mid_note "The orchestrator of $repo did not start: $(grep -m1 . <<<"$out")" "$primary" "$repo"
      exit 0
    fi
    [[ "$kind" == ag ]] && exit 0
    for i in $(seq 20); do
      name=$(jay_claude_agents | jq -r --arg i "$agent" 'first(.[] | select(.id == $i) | .name // .id) // empty')
      [[ -n "$name" ]] && break
      sleep 0.5
    done
    jay_hub_locked show_quiet "$agent" "${name:-$agent}" "$primary"
  ) </dev/null >/dev/null 2>&1 &
  return 0
}

# Show note $1 about main checkout $2 in the hub's middle column, under pane title $3, without
# the focus. A note has no agent: id -, kind note (jay-pane prints it).
mid_note() {
  local viewer changed
  jay_in_hub || return 0
  IFS=$'\t' read -r viewer changed < <(jay_hub_locked jay_hub_point agent "$(printf -- '-\t%s\tnote\t%s' "$2" "$1")") || return 0
  [[ "$changed" == 1 ]] && jay_mux_rename "$viewer" "$3"
  return 0
}

# The middle column shows a note about main checkout $1 (mid_note).
mid_noted() {
  local cwd kind
  IFS=$'\t' read -r _ cwd kind _ 2>/dev/null <"$(jay_hub_target_file agent)" || return 1
  [[ "$kind" == note && "$cwd" == "$1" ]]
}

# Show background agent $1 named $2 from folder $3 in the middle column, without the focus, while
# it still shows the note about $3: a pick since then wins.
show_quiet() {
  local viewer changed
  mid_noted "$3" || return 0
  IFS=$'\t' read -r viewer changed < <(jay_hub_point agent "$(printf '%s\t%s\tbackground\t%s' "$1" "$3" "$2")") || return 0
  [[ "$changed" == 1 ]] && jay_mux_rename "$viewer" "$2"
  return 0
}

# The fzf action of a pick (Enter, double-click; through transform): a row with the fourth field
# "repair" ($2, an agent that cannot wake) repairs it after a confirm, any other row acts.
# $1: --focus (Enter) or empty. fzf fills in {1} {2} when it runs the action.
pick_action() {
  if [[ "${2:-}" == repair ]]; then
    printf '%s' 'execute(jay-sidebar --repair {2})+reload-sync(jay-sidebar --rows --fresh)+clear-screen'
  else
    printf 'execute-silent(jay-sidebar --quick --act {1} {2}%s)+reload-sync(jay-sidebar --rows)' "${1:+ $1}"
  fi
}

# Run jay-sidebar with options "$@" for an execute-silent of fzf, and return within half a
# second. fzf (0.74) turns the terminal's mouse modes off when such a command runs over a second,
# and does not turn them on again after it: the list did not take clicks any more. A command that
# runs longer goes on in the background, and the list reloads when it ends (through fzf's
# socket).
quick() {
  local late="$STATE/sidebar.late.$$" i=0 pid
  ( "$0" "$@"
    if [[ -f "$late" ]]; then
      rm -f "$late"
      curl -s --max-time 2 --unix-socket "${JAY_SIDEBAR_SOCK:-}" -X POST http://localhost \
        -d 'reload-sync(jay-sidebar --rows)' >/dev/null 2>&1
    fi ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    ((i++ < 5)) || { : >"$late"; return 0; }
    sleep 0.1
  done
}

# Repair the agent with session id $1 that cannot wake because its home is gone (see
# jay_stranded), after a confirm. It goes on as a copy in the worktree it is in (jay_continue_in);
# then the old entry goes, or stays hidden while `claude rm` would delete that worktree
# (jay_drop_replaced). When that worktree is gone too: a copy in the repo's main checkout, or
# `claude rm`.
repair() {
  local sid=$1 agents agent id line name home tree fix runs main out answer
  agents=$(jay_claude_agents) || agents='[]'
  agent=$(jq -c --arg s "$sid" 'first(.[] | select(.sessionId == $s)) // empty' <<<"$agents")
  id=$(jq -r '.id // empty' <<<"${agent:-null}")
  [[ -n "$id" ]] && line=$(jay_stranded "$agents" "$(jay_jobs "$agents")" | awk -F'\t' -v i="$id" '$1 == i')
  if [[ -z "${line:-}" ]]; then
    pause "Nothing to repair: this agent can wake, or it is gone."
    return 0
  fi
  IFS=$'\t' read -r id name home tree fix runs <<<"$line"
  if [[ "$runs" == 1 ]]; then
    pause "\"$name\" runs in ${tree/#$HOME/~}. The folder it came from (${home/#$HOME/~}) is gone, so it cannot wake after it stops. Pick it again when it does not run: then the list continues it."
    return 0
  fi
  if [[ "$fix" == move ]]; then
    say "\"$name\" ($id) cannot wake: Claude wakes an agent in the folder it came from, and that folder is gone:

  ${home/#$HOME/~}

It worked in ${tree/#$HOME/~}.

y: continue it there. Claude starts a copy with the same conversation and options, and a new id. The old entry goes, or stays hidden until that worktree goes.
h: hide the old entry only (you continued it already, say with claude --bg --resume). It goes with that worktree."
    printf 'other key: cancel\n'
    read -rsn1 answer </dev/tty
    case $answer in
      y) say "Continuing \"$name\" in ${tree##*/}..."
         continue_in "$id" "$name" "$tree" ;;
      h) jay_state_dir
         mkdir -p "$JAY_STATE/replaced" && printf -- '-\n' >"$JAY_STATE/replaced/$id"
         jay_drop_replaced "$id" || true ;;
    esac
    return 0
  fi
  main=$(jay_repo_main "$tree")
  [[ -n "$main" ]] || main=$(jay_repo_main "$home")
  say "\"$name\" ($id) cannot wake: the folder it came from and the worktree it worked in are both gone.

  ${home/#$HOME/~}
  ${tree/#$HOME/~}
${main:+
m: continue it in the main checkout ${main/#$HOME/~} (a copy with the same conversation and options, and a new id)}
x: remove it (claude rm; its transcript stays)"
  printf 'other key: cancel\n'
  read -rsn1 answer </dev/tty
  case $answer in
    m) [[ -n "$main" ]] || return 0
       say "Continuing \"$name\" in ${main##*/}..."
       continue_in "$id" "$name" "$main" ;;
    x) out=$(claude rm "$id" 2>&1) || pause "Not removed:

$out" ;;
  esac
  return 0
}

# Agent $1 (name $2) goes on as a copy in folder $3 (jay_continue_in); the old entry goes when that
# is safe. The hub then shows the copy.
continue_in() {
  local out
  if ! out=$(jay_continue_in "$1" "$3" 2>&1); then
    pause "\"$2\" did not go on in ${3/#$HOME/~}:

$out"
    return 1
  fi
  jay_drop_replaced "$1" || true
  show_started "$out"
}

path_of() {
  case $1 in
    wt|repo) printf '%s\n' "$2" ;;
    ag) jay_claude_agents | jq -r --arg s "$2" 'first(.[] | select(.sessionId == $s) | .cwd) // empty' ;;
  esac
}

view() {
  local path
  if [[ "$1" == open && "$2" == ag && "$(agent_json "$3" | jq -r '.kind // ""')" == interactive ]]; then
    jay-go "$3" >/dev/null 2>&1
    return 0
  fi
  path=$(path_of "$2" "$3")
  [[ -n "$path" ]] || return 0
  case $1 in
    open) jay-open "$path" >/dev/null 2>&1 ;;
  esac
}

# Start an idle background agent from row kind $2 with id $3: $1 = here (in the row's worktree)
# or worktree (a new worktree from the row's repo through `jay new`; asks for the branch). Here
# in a main checkout, the agent is an orchestrator (see jay_orchestrator_prompt); a repo has
# one, so when it has one already, the hub shows that one. The new agent shows in the hub's
# middle column, where you type its first prompt.
new_agent() {
  local mode=$1 kind=$2 id=$3 path top primary repo branch key out agent orch name i
  if [[ "$kind" == hdr || ("$mode" == here && "$kind" == repo) ]]; then
    pause "n starts an agent in a worktree: pick a worktree row. N on a repo or worktree row makes a new worktree of that repo."
    return 0
  fi
  path=$(path_of "$kind" "$id")
  [[ -n "$path" ]] || return 0
  top=$(jay_toplevel "$path")
  primary=$(jay_primary "$top")
  IFS=$'\t' read -r _ repo branch _ < <(jay_describe "$top")
  if [[ "$mode" == here && "$top" == "$primary" ]]; then
    orch=$(jay_orchestrators "$top" | head -1)
    if [[ -n "$orch" ]]; then
      IFS=$'\t' read -r _ agent name <<<"$orch"
      pause "$repo has an orchestrator: \"$name\" ($agent). A repo has only one, so n does not start a second one. The hub shows \"$name\" now.

c on its row gives it a fresh context."
      show_started "$agent"
      return 0
    fi
  fi
  if ! jay_trusted "$top"; then
    key=$(jay_trust_key "$top")
    confirm "Claude does not trust $repo yet, so no agent can start in it.

Trust ${key/#$HOME/~} and all its worktrees? This is the same as yes in the trust prompt of claude: Claude then uses the settings, hooks and MCP servers of the repo." "y: trust" || return 0
    if ! jay_trust "$top"; then
      pause "Could not change ~/.claude.json. Run claude in ${key/#$HOME/~} once and accept the trust prompt."
      return 0
    fi
  fi
  if [[ "$mode" == worktree ]]; then
    say "New worktree and agent in $repo."
    printf 'Branch, empty to cancel: '
    read -r -e branch </dev/tty
    [[ -n "$branch" ]] || return 0
    say "Starting an agent in a new worktree $branch..."
    out=$(cd "$primary" && jay-new "$branch" --agent 2>&1)
  elif [[ "$top" == "$primary" ]]; then
    say "Starting an orchestrator in $repo (main checkout)..."
    out=$(jay_orchestrator_start "$top" "$repo" "$branch")
  else
    # A second agent in the worktree: <repo>/<branch>-2 (jay_unique_name).
    say "Starting an agent in $repo/${branch##*/}..."
    out=$(cd "$top" && claude --bg --name "$(jay_unique_name "$(jay_tab_name "$repo" "$branch")")" 2>&1)
  fi
  agent=$(jay_bg_id "$out")
  if [[ -z "$agent" ]]; then
    pause "Not started:

$out"
    return 0
  fi
  show_started "$agent"
}

# Show background agent $1 (short id), just started, in the hub: jay-go fails until
# `claude agents` lists it.
show_started() {
  local i
  for i in $(seq 20); do
    jay-go "$1" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  pause "Started $1, but the hub cannot show it yet. Pick it in the list."
}

# Interactive session $1 (session id) goes on as a background agent, after a confirm. It must be
# idle: it ends in its tab (SIGTERM; two copies must never write one conversation), and
# `claude --bg --resume` continues the conversation under the same session id, so its short id
# and turn chain stay. Its tab goes back to the shell. The hub then shows the agent. It keeps its
# name and makes no second agent, so no jay_unique_name: with an option (--name), `claude --bg
# --resume` starts a copy with a new id.
to_background() {
  local sid=$1 agent name pid cwd out short i
  agent=$(agent_json "$sid")
  [[ -n "$agent" ]] || return 0
  name=$(jq -r '.name // .sessionId[0:8]' <<<"$agent")
  if [[ "$(jq -r .kind <<<"$agent")" == background ]]; then
    pause "\"$name\" is already a background agent."
    return 0
  fi
  if [[ "$(jq -r '.status // ""' <<<"$agent")" != idle ]]; then
    pause "\"$name\" is working or waits for you. Try again when it is idle."
    return 0
  fi
  pid=$(jq -r '.pid // empty' <<<"$agent")
  cwd=$(jq -r .cwd <<<"$agent")
  [[ -n "$pid" ]] || return 0
  confirm "Continue \"$name\" as a background agent?

It ends in its own tab and goes on in the background with the same conversation. Its tab goes back to the shell: close it, or run c there for a new agent." "y: continue" || return 0
  kill -TERM "$pid" 2>/dev/null
  for i in $(seq 40); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  if kill -0 "$pid" 2>/dev/null; then
    pause "\"$name\" did not end. Nothing changed."
    return 0
  fi
  out=$(cd "$cwd" && claude --bg --resume "$sid" 2>&1)
  short=$(jay_bg_id "$out")
  if [[ -z "$short" ]]; then
    pause "\"$name\" ended, but it did not start in the background:

$out

claude --bg --resume $sid tries again."
    return 0
  fi
  show_started "$short"
}

# A fresh context for the orchestrator (◇) in row kind $1 with id $2, or for the hub Claude (the
# "◆ hub" row), after a confirm and only when it is idle. jay-clear types /clear into it:
# Claude keeps the system prompt (the orchestrator or hub prompt), the name and the short id, so
# the turn chain, JAY_HUB_CLAUDE_FILE and the middle column stay right. When that prompt is older
# than jay's (jay_prompt_old), the confirm also offers jay-renew: a new agent with the current
# prompt and the same name in place of the old one. Not for an orchestrator in a worktree it
# entered: that worktree would stay its folder after the /clear.
clear_context() {
  local kind=$1 id=$2 agents agent short name jobs away out answer
  local what="c gives a fresh context to an orchestrator (◇) or to the hub Claude (◆ hub). For another agent, type /clear in it."
  agents=$(jay_claude_agents) || agents='[]'
  case $kind in
    hub)
      short=$(jay_hub_claude_id)
      agent=$(jq -c --arg i "$short" 'first(.[] | select(.id == $i and .state != "stopped")) // empty' <<<"$agents")
      if [[ -z "$short" || -z "$agent" ]]; then
        pause "The hub Claude does not run. A pick of \"◆ hub\" starts it, with a fresh context."
        return 0
      fi ;;
    ag)
      agent=$(jq -c --arg s "$id" 'first(.[] | select(.sessionId == $s)) // empty' <<<"$agents")
      [[ -n "$agent" ]] || return 0
      short=$(jq -r '.id // empty' <<<"$agent")
      jobs=$(jay_jobs "$agents")
      if [[ -z "$short" || "$(jq -r --arg i "$short" '.[$i].orch // false' <<<"$jobs")" != true ]]; then
        pause "$what"
        return 0
      fi
      away=$(jq -r --arg i "$short" '.[$i].tree // ""' <<<"$jobs")
      if [[ -n "$away" ]]; then
        pause "\"$(jq -r '.name // .id' <<<"$agent")\" is in a worktree it entered: ${away/#$HOME/~}. Tell it to leave it first (ExitWorktree), then press c again."
        return 0
      fi ;;
    *)
      pause "$what"
      return 0 ;;
  esac
  name=$(jq -r '.name // .id' <<<"$agent")
  # The phase rule of the list (jay_agent_phases): unread and idle are idle. An agent whose state
  # is working while its process is idle only waits for its workers, so it is idle too.
  case $(jay_agent_phases "[$agent]" "" | jq -r '.[0].phase') in
    input) pause "\"$name\" waits for you: it asks something, or it waits for a permission. Answer it first."; return 0 ;;
    failed) pause "\"$name\" failed. Look at it first (Enter on its row)."; return 0 ;;
    working) pause "\"$name\" is working. Try again when it is idle."; return 0 ;;
  esac
  if jay_prompt_old "$short"; then
    say "Give \"$name\" ($short) a fresh context?

Its system prompt is older than jay's prompt now, and /clear keeps it. The old conversation stays in its transcript.

y: fresh context with the current prompt (a new agent, same name; the old one is removed)
k: fresh context, keep the old prompt (/clear)
other key: cancel"
    read -rsn1 answer </dev/tty
    case $answer in
      y) say "Renewing \"$name\"..."
         out=$(jay-renew "$short" 2>&1) || pause "\"$name\" was not renewed:

$out"
         return 0 ;;
      k) ;;
      *) return 0 ;;
    esac
  else
    confirm "Give \"$name\" ($short) a fresh context?

The list types /clear into it. It starts a new conversation with the same system prompt, name and id. The old conversation stays in its transcript." "y: clear" || return 0
  fi
  say "Clearing the context of \"$name\"..."
  out=$(jay-clear "$short" 2>&1) || pause "The context of \"$name\" did not change:

$out"
  return 0
}

# The key hints under the list, keys in the headings' orange and labels in the plain text color
# (--color=footer:-1; fzf's own footer color is a dim blue-gray): short ones grouped, and with ?
# the full list, one key per line. Lines stay under 30 columns (the list is about 32 wide).
# --toggle switches between the two.
KEY=$'\e[38;5;173m' OFF=$'\e[0m'
YEL=$'\e[33m' GRN=$'\e[32m' RED=$'\e[31m' CYN=$'\e[36m' DIM=$'\e[2m' BYEL=$'\e[1;33m' BMAG=$'\e[1;35m'
DGRN=$'\e[2;32m'
# Only the list's own keys, plus the pane moves (zellij, from any pane); review shows its keys
# in its title. The signs are no keys: they come under their own heading, in their row colors.
HEAD=$'\e[1m' ROW=$'\e[1;36m'
FOOTER_SHORT="${KEY}⏎${OFF} open  ${KEY}n${OFF} new  ${KEY}d${OFF} remove
${KEY}?${OFF} all keys and signs"
FOOTER_FULL="${HEAD}Keys${OFF}
${KEY}⏎${OFF}      open, focus moves
${KEY}click${OFF}  select (keys act on it)
${KEY}2 clicks${OFF} open, as ⏎
${KEY}n${OFF}      new agent here
${KEY}N${OFF}      new worktree + agent
${KEY}o${OFF}      own Ghostty tab
${KEY}d${OFF}      remove agent/worktree
${KEY}b${OFF}      session to background
${KEY}c${OFF}      fresh context (◇, hub)
${KEY}a${OFF}      hide/show idle repos
${KEY}p${OFF}      prune dead agents
${KEY}r${OFF}      reload this agent list
${KEY}j k${OFF}    move
${KEY}- +${OFF}    narrower / wider
${KEY}?${OFF}      fewer keys

${HEAD}Panes${OFF} (${KEY}Ctrl g${OFF}, then)
${KEY}1 2 3${OFF}  list / middle / right
${KEY}h l${OFF}    pane left / right
${KEY};${OFF}      last pane
${KEY}v${OFF}      hide/show review

${HEAD}Signs${OFF}
${BYEL}!${OFF} agent needs input
${RED}✗${OFF} agent failed
${BMAG}✓${OFF} done, you did not see it
${DGRN}●${OFF} agent works
${DIM}○${OFF} idle: seen, or new
${ROW}▸${OFF} agent in the middle pane
${ROW}◆ hub${OFF} row: the hub Claude
${DIM}↻${OFF} old Claude Code, respawns
${DIM}⇡${OFF} old prompt: c renews it
${CYN}◇${OFF} orchestrator of the repo
${YEL}◇${OFF} second orchestrator (d it)
${DIM}n: orchestrator${OFF} 2+ workers
${YEL}home gone${OFF} cannot wake (⏎)
${RED}lost${OFF} worktree gone too (⏎)
${G_HOME} main checkout
${YEL}${G_DIFF}${OFF} uncommitted changes
${CYN}${G_PUSH}1${OFF} commits to push (remote)
${CYN}${G_PULL}2${OFF} commits to pull (remote)
${GRN}${G_UP}3${OFF} not in main (no remote)
${RED}${G_ALERT}${OFF} merge would conflict
${DIM}${G_OK}${OFF} safe to remove
${RED}${G_MERGE}${OFF} conflicts or a rebase"
footer() {
  local flag=${JAY_SIDEBAR_HELP:-/dev/null}
  if [[ "${1:-}" == --toggle ]]; then
    if [[ -f "$flag" ]]; then rm -f "$flag"; else : >"$flag"; fi
  fi
  if [[ -f "$flag" ]]; then printf '%s' "$FOOTER_FULL"; else printf '%s' "$FOOTER_SHORT"; fi
}

# Show text $1 on a clear pane, folded to its width.
say() {
  local cols
  cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
  clear
  printf '\n%s\n\n' "$1" | fold -s -w "$(( ${cols:-40} > 10 ? ${cols:-40} - 1 : 40 ))"
}

# Ask $1 and return 0 when the answer is y; $2 labels y (default "y: remove").
confirm() {
  local answer
  say "$1"
  printf '%s   other key: cancel\n' "${2:-y: remove}"
  read -rsn1 answer </dev/tty
  [[ "$answer" == y ]]
}

pause() {
  say "$1"
  printf 'Press a key.\n'
  read -rsn1 _ </dev/tty
}

# Remove the agent or worktree in row kind $1 with id $2, after a confirm. Never forced:
# `claude rm` and `wt remove` stop on unpushed or uncommitted work and the list shows why. A
# worktree goes with its idle background agents; a "(gone)" row removes its agents. An agent
# that works or an interactive session stops both. An agent in a worktree it entered goes with
# that worktree: `claude rm` keeps it while the worktree is on disk. $3: such an agent's id
# (from the agent row), which the worktree removal takes along.
remove() {
  local kind=$1 id=$2 agents agent out name short top main branch here idle pane tasks tab tree
  agents=$(jay_claude_agents) || agents='[]'
  case $kind in
    ag)
      agent=$(jq -c --arg s "$id" 'first(.[] | select(.sessionId == $s)) // empty' <<<"$agents")
      [[ -n "$agent" ]] || return 0
      name=$(jq -r '.name // .id' <<<"$agent")
      short=$(jq -r '.id // empty' <<<"$agent")
      if [[ "$(jq -r .kind <<<"$agent")" != background || -z "$short" ]]; then
        pause "\"$name\" is an interactive session. Close it in its own tab, or b: make it a background agent."
        return 0
      fi
      tree=$(jay_jobs "$agents" | jq -r --arg id "$short" '.[$id].tree // empty')
      if [[ -n "$tree" && -d "$tree" ]]; then
        remove wt "$tree" "$short"
        return 0
      fi
      confirm "Remove agent \"$name\" ($short)?

This deletes the background session, and the worktree it made, if any. Unpushed commits stop the removal." || return 0
      out=$(claude rm "$short" 2>&1) || pause "Not removed:

$out" ;;
    wt)
      top=$id
      IFS=$'\t' read -r main branch < <(jq -r --arg p "$top" 'select(.path == $p) | "\(.main)\t\(.branch)"' "$CACHE" | head -1)
      if [[ "$main" == true ]]; then
        pause "$top is a main checkout. The list never removes it."
        return 0
      fi
      here=$(agents_in "$agents" "$top" "${3:-}")
      agents_busy "$here" && return 0
      idle=$(awk -F'\t' '$1 == "idle" { print "  " $3 }' <<<"$here")
      away=$(awk -F'\t' -v h="$HOME" '$1 == "away" { t = $4; if (index(t, h "/") == 1) t = "~" substr(t, length(h) + 1); print "  " $3 " → " t }' <<<"$here")
      tasks=$(jay-run --worktree-tab "$top" --tasks 2>/dev/null)
      tab=$(jay-run --worktree-tab "$top" --name 2>/dev/null)
      confirm "Remove worktree ${branch:-$top}${idle:+ and its agents}?

$top
${idle:+
Agents (their transcripts stay):
$idle
}${away:+
Agents that came from here and work in another worktree now (EnterWorktree). Claude wakes an agent in the folder it came from, so after the removal they could not wake. They go on in their worktrees first, as copies: same conversation and options, new id. Their old entries go:
$away
}${tasks:+
Tasks that stop (its tab in the hub closes):
$tasks
}
The branch is deleted only if it is merged. Uncommitted changes stop the removal." || return 0
      if [[ -n "$away" ]]; then
        move_away "$here" || return 0
        # The old entries are replaced now: they go after the worktree.
        here=$(awk -F'\t' 'BEGIN { OFS = "\t" } $1 == "away" { $1 = "replaced" } { print }' <<<"$here")
      fi
      if [[ "$(cut -f1 "$(jay_hub_target_file review)" 2>/dev/null)" == "$top" ]]; then
        jay_hub_locked jay_hub_show_review
        pane=$(jay_hub_locked jay_hub_point review "" | cut -f1)
        [[ -n "$pane" ]] && jay_mux_rename "$pane" review
      fi
      # The worktree goes first: `claude rm` keeps an agent while its worktree is on disk.
      if out=$(wt -C "$top" remove --foreground 2>&1); then
        rm_agents "$here"
        [[ -n "$tab" ]] && jay-run --close-tab "$tab" >/dev/null 2>&1
      else
        pause "Not removed:

$out"
      fi
      refresh_worktrees ;;
    gone)
      here=$(agents_in "$agents" "${id#gone:}")
      [[ -n "$here" ]] || return 0
      agents_busy "$here" && return 0
      confirm "Remove the agents of the removed worktree ${id#gone:}?

$(cut -f3 <<<"$here" | sed 's/^/  /')

Their transcripts stay." || return 0
      rm_agents "$here" ;;
  esac
  return 0
}

# The agents in agents JSON $1 whose folder is $2 or in it, as what<TAB>id<TAB>name<TAB>tree<TAB>runs.
# what is open (an interactive session: the list cannot remove it), replaced (an old entry whose
# copy goes on, see jay_continue_in), busy (its phase is working or input, see jay_agent_phases:
# an agent that only waits for its workers is not busy), away (its home is $2, but it is in
# another worktree now, see jay_jobs; also when it does not run or is stopped: Claude would wake
# it in $2), visit (it entered the worktree; also when it does not run now) or idle. Agent id $3
# (optional) is idle when it is a visit: d on that agent takes its worktree with it. tree: the
# folder an away agent is in; runs: 1 while its process runs.
agents_in() {
  local jobs
  jobs=$(jay_jobs "$1")
  jq -r --arg p "$2" --arg take "${3:-}" --argjson jobs "$jobs" --argjson replaced "$(jay_replaced_ids)" '
    def inside($d): $d == $p or ($d | startswith($p + "/"));
    .[] | ($jobs[.id // ""] // {}) as $j
    | ($j.tree != null and inside($j.home // "") and (inside($j.tree) | not)) as $away
    | (.id as $i | $i != null and ($replaced | index([$i]) != null)) as $old
    | select($away or (($old or .state != "stopped") and (inside(.cwd // "") or inside($j.tree // ""))))
    | [(if .kind != "background" or .id == null then "open"
        elif $old then "replaced"
        elif .phase | IN("working", "input") then "busy"
        elif $away then "away"
        elif $j.tree != null and .id != $take then "visit"
        else "idle" end), (.id // ""), (.name // .id // .sessionId[0:8]), ($j.tree // ""),
       (if .pid != null then 1 else 0 end)] | @tsv' <<<"$(jay_agent_phases "$1" "")"
}

# Return 0 after a note when agents TSV $1 (from agents_in) has an agent that the list must not
# remove: an interactive session, an agent that works, or one that entered the worktree.
agents_busy() {
  local busy open visit
  busy=$(awk -F'\t' '$1 == "busy" { print "  " $3 }' <<<"$1")
  open=$(awk -F'\t' '$1 == "open" { print "  " $3 }' <<<"$1")
  visit=$(awk -F'\t' '$1 == "visit" { print "  " $3 }' <<<"$1")
  [[ -n "$busy$open$visit" ]] || return 1
  pause "Not removed. These agents use the folder:
${busy:+
Working (try again when they stop):
$busy
}${open:+
Interactive (close them in their own tabs, or b: make them background agents):
$open
}${visit:+
Came in from another folder (EnterWorktree). Tell them to leave it first (ExitWorktree), or d on the agent removes it with the worktree:
$visit
}"
  return 0
}

# The away agents in agents TSV $1 (from agents_in) go on in the worktrees they are in, as copies
# (jay_continue_in); one that runs stops first. Return 1 after a note when one did not: the
# removal then stops (the copies made so far go on; their old entries are hidden).
move_away() {
  local what id name tree runs out failed=""
  while IFS=$'\t' read -r what id name tree runs; do
    [[ "$what" == away ]] || continue
    say "\"$name\" goes on in ${tree##*/}..."
    if [[ "$runs" == 1 ]] && ! jay_stop_agent "$id"; then
      failed+="  $name: it did not stop"$'\n'
      continue
    fi
    out=$(jay_continue_in "$id" "$tree" 2>&1) || failed+="  $name: $out"$'\n'
  done <<<"$1"
  [[ -z "$failed" ]] && return 0
  pause "Not removed. These agents did not go on in their worktrees, and they need this folder to wake:

$failed"
  return 1
}

# Remove the idle agents in agents TSV $1 (from agents_in) with `claude rm`, and the replaced old
# entries when that is safe (jay_drop_replaced); show the failures.
rm_agents() {
  local what id name out failed=""
  while IFS=$'\t' read -r what id name _; do
    if [[ "$what" == replaced ]]; then
      jay_drop_replaced "$id" || true
      continue
    fi
    [[ "$what" == idle ]] || continue
    out=$(claude rm "$id" 2>&1) || failed+="  $name: $out"$'\n'
  done <<<"$1"
  [[ -z "$failed" ]] || pause "Agents not removed (p removes them later):

$failed"
  return 0
}

# The dead agents in agents JSON $1, as id<TAB>name: background agents whose folder is gone (a
# removed worktree) and that do not run now. An agent that entered the worktree (see jay_jobs)
# is not dead: it came from another folder (an orchestrator, say).
dead_agents() {
  jq -r --argjson gone "$(gone_dirs "$1")" --argjson jobs "$(jay_jobs "$1")" '.[]
    | select(.kind == "background" and .id != null and .state != "stopped"
        and (.state | IN("working", "blocked") | not) and (.status | IN("busy", "waiting") | not))
    | select($jobs[.id].tree == null)
    | (.cwd // "") as $d | select($gone | index([$d]))
    | [.id, (.name // .id)] | @tsv' <<<"$1"
}

# Remove the dead agents in agents JSON $1 without asking, at most every 10 minutes. `claude rm`
# deletes the session (its transcript stays) and the worktree Claude recorded for it; it keeps
# the agent when that worktree is still on disk without a WorktreeRemove hook, or has work to
# lose. The worktree can differ from the folder: an agent that moved on keeps its first folder.
auto_prune() {
  local stamp="$STATE/prune.stamp" id name out f
  [[ -n "$(find "$stamp" -mmin -10 2>/dev/null)" ]] && return 0
  touch "$stamp"
  while IFS=$'\t' read -r id name; do
    [[ -n "$id" ]] || continue
    out=$(claude rm "$id" 2>&1)
    printf '%s %s (%s): %s\n' "$(date '+%F %T')" "$id" "$name" "$(head -1 <<<"$out")" >>"$STATE/prune.log"
  done < <(dead_agents "$1")
  # The replaced old entries whose recorded worktree is gone now (jay_drop_replaced).
  for f in "$JAY_STATE"/replaced/*; do
    [[ -f "$f" ]] || continue
    id=${f##*/} name=$(cat "$f" 2>/dev/null)
    jay_drop_replaced "$id" && printf '%s %s: replaced by %s, removed\n' "$(date '+%F %T')" "$id" "$name" >>"$STATE/prune.log"
  done
  # Then the turn chains of agents that are gone (see jay-snapshot --prune), and old
  # seen/ended marks (jay_agent_phases): with both gone an agent is idle, and a seen mark goes
  # first only when a newer turn made the agent unread already.
  jay-snapshot --prune >>"$STATE/prune.log" 2>&1
  find "$JAY_MARKS/seen" "$JAY_MARKS/ended" -type f -mtime +14 -delete 2>/dev/null
  # The task notes and renewed marks of agents that are gone, after 14 days too. Every agent
  # counts, also one outside JAY_ROOTS: it is not gone.
  jay_prune_agent_files "$(claude agents --json --all 2>/dev/null)"
  return 0
}

# Remove the dead agents, after a confirm. `claude rm` deletes the session.
prune() {
  local agents dead id name failed="" out
  agents=$(jay_claude_agents) || agents='[]'
  dead=$(dead_agents "$agents")
  if [[ -z "$dead" ]]; then
    pause "No dead agents: every agent's folder exists, or the agent still runs."
    return 0
  fi
  confirm "Remove these agents? Their folders are gone.

$(cut -f2 <<<"$dead" | sed 's/^/  /')" || return 0
  while IFS=$'\t' read -r id name; do
    out=$(claude rm "$id" 2>&1) || failed+="  $name: $out"$'\n'
  done <<<"$dead"
  [[ -z "$failed" ]] || pause "Not removed:

$failed"
  return 0
}

case ${1:-} in
  --rows) shift; rows "$@"; exit 0 ;;
  --prune) prune; exit 0 ;;
  --act) shift; act "$@"; exit 0 ;;
  --quick) shift; quick "$@"; exit 0 ;;
  --pick) shift; pick_action "$@"; exit 0 ;;
  --repair) shift; repair "$@"; exit 0 ;;
  # For the tests: the agents that d on folder $2 finds (agents_in).
  --agents-in) agents_in "$(jay_claude_agents || echo '[]')" "$2" "${3:-}"; exit 0 ;;
  --view) shift; view "$@"; exit 0 ;;
  --remove) shift; remove "$@"; exit 0 ;;
  --new) shift; new_agent "$@"; exit 0 ;;
  --bg) [[ "${2:-}" == ag ]] && to_background "$3"; exit 0 ;;
  --clear) shift; clear_context "$@"; exit 0 ;;
  --files) jay_hub_locked jay_hub_show_files; exit 0 ;;
  --review) review_key "${2:-}"; exit 0 ;;
  --focus) focus_key "${2:-list}"; exit 0 ;;
  --idle) if [[ -f "$HIDE_IDLE" ]]; then rm -f "$HIDE_IDLE"; else : >"$HIDE_IDLE"; fi; exit 0 ;;
  --footer) shift; footer "$@"; exit 0 ;;
  -h|--help) sed -n '2,30s/^# \{0,1\}//p' "$0"; exit 0 ;;
  # An option this version does not have (say a bind of a list started before an update) must
  # not start a second list.
  -*) printf 'jay-sidebar: unknown option %s\n' "$1" >&2; exit 2 ;;
esac

# The files of lists that were killed (their EXIT trap did not run): their pid is gone.
for f in "$STATE"/sidebar.*.*; do
  [[ -e "$f" || -S "$f" ]] || continue
  pid=${f#"$STATE"/sidebar.}; pid=${pid%%.*}
  [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && rm -f "$f"
done

sock="$STATE/sidebar.$$.sock"
export JAY_SIDEBAR_SOCK=$sock JAY_SIDEBAR_COUNT="$STATE/sidebar.$$.count" JAY_SIDEBAR_SUM="$STATE/sidebar.$$.sum" \
  JAY_SIDEBAR_HELP="$STATE/sidebar.$$.help" JAY_SIDEBAR_RESTART="$STATE/sidebar.$$.restart"
post() { curl -s --max-time 2 --unix-socket "$sock" -X POST http://localhost -d "$1" >/dev/null 2>&1 || true; }

# Send the agent counts (rows makes them as its first row, which the list does not show) to the
# status line's middle part (jay_mux_bar) when they change, and every 30 s for a zjstatus that
# started again.
last_sum=""
send_sum() {
  local sum
  sum=$(cat "$JAY_SIDEBAR_SUM" 2>/dev/null)
  [[ -n "$sum" ]] || return 0
  [[ "$sum" != "$last_sum" || "${1:-}" == --again ]] || return 0
  last_sum=$sum
  (jay_mux_bar agents "$sum" &)
}

# The same for the tasks of the tasks tab. jay-run --tick also keeps a free shell in that tab.
# An empty text clears the bar's part.
last_tasks="-"
send_tasks() {
  local tasks
  tasks=$(jay-run --tick 2>/dev/null)
  [[ "$tasks" != "$last_tasks" || "${1:-}" == --again ]] || return 0
  last_tasks=$tasks
  (jay_mux_bar tasks "$tasks" &)
}

# Save the list's share of the hub's width when it changes (mouse drag, h/l), so `jay`
# starts it at that width.
last_cols=""
remember_width() {
  local cols share
  cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
  [[ -n "$cols" && "$cols" != "$last_cols" ]] || return 0
  last_cols=$cols
  share=$(jay_mux_list_share)
  [[ -n "$share" ]] && printf '%s\n' "$share" >"$STATE/sidebar.pct"
}

(
  tick=0
  while sleep 3; do
    tick=$((tick + 1))
    jay_in_hub && remember_width
    before=$(cat "$JAY_SIDEBAR_COUNT" 2>/dev/null)
    post 'reload-sync(jay-sidebar --rows)'
    sleep 1
    after=$(cat "$JAY_SIDEBAR_COUNT" 2>/dev/null)
    if [[ "$before" != "$after" ]] || ((tick % 10 == 0)); then post 'clear-screen'; fi
    if jay_in_hub; then
      if ((tick % 10 == 0)); then send_sum --again; send_tasks --again; else send_sum; send_tasks; fi
      # The tasks tab's banner: the review's worktree, at the start and every 30 s (a pick sends
      # it at once, see jay_hub_target).
      ((tick % 10 == 1)) && (jay-run --where >/dev/null 2>&1 &)
      # A hidden review that came back with the floating panes (say Ctrl g p w) goes again.
      [[ -f "$JAY_HIDDEN" ]] && jay_hub_rehide
    fi
  done
) &
loop=$!
cleanup() {
  kill $loop 2>/dev/null
  rm -f "$sock" "$JAY_SIDEBAR_COUNT" "$JAY_SIDEBAR_SUM" "$JAY_SIDEBAR_HELP" "$JAY_SIDEBAR_RESTART"
}
trap cleanup EXIT

rows | fzf --ansi --listen="$sock" --no-input --no-sort --layout=reverse --info=hidden --no-scrollbar \
  --delimiter=$'\t' --with-nth=3 --track --id-nth=2 --pointer='▌' --marker='' --gutter=' ' --highlight-line \
  --footer="$(footer)" --color=footer:-1,pointer:173,bg+:238 \
  --bind '?:transform-footer(jay-sidebar --footer --toggle)' \
  --bind 'd:execute(jay-sidebar --remove {1} {2})+reload-sync(jay-sidebar --rows)+clear-screen' \
  --bind 'b:execute(jay-sidebar --bg {1} {2})+reload-sync(jay-sidebar --rows)+clear-screen' \
  --bind 'c:execute(jay-sidebar --clear {1} {2})+reload-sync(jay-sidebar --rows)+clear-screen' \
  --bind 'n:execute(jay-sidebar --new here {1} {2})+reload-sync(jay-sidebar --rows --fresh)+clear-screen' \
  --bind 'N:execute(jay-sidebar --new worktree {1} {2})+reload-sync(jay-sidebar --rows --fresh)+clear-screen' \
  --bind 'enter:transform(jay-sidebar --pick --focus {4})' \
  --bind 'double-click:transform(jay-sidebar --pick --focus {4})' \
  --bind 'r:execute-silent(: >"$JAY_SIDEBAR_RESTART")+abort' \
  --bind 'o:execute-silent(jay-sidebar --quick --view open {1} {2})' \
  --bind 'a:execute-silent(jay-sidebar --idle)+reload-sync(jay-sidebar --rows)+clear-screen' \
  --bind 'p:execute(jay-sidebar --prune)+reload-sync(jay-sidebar --rows)+clear-screen' \
  --bind '-:execute-silent(jay-mux resize_list decrease)' \
  --bind '+:execute-silent(jay-mux resize_list increase)' \
  --bind '=:execute-silent(jay-mux resize_list increase)' \
  --bind 'j:down,k:up,q:ignore,esc:ignore,ctrl-c:ignore,ctrl-g:ignore,ctrl-q:ignore,ctrl-d:ignore'
rc=$?

# r: start again as the newest version of this script, with fresh git signs (same pid, so the
# state files keep their names). fzf that ended any other way (killed, an error) starts again
# too, after a pause that shows why: the list belongs to the hub. A close of the pane (HUP) or a
# kill of this script ends it before this point. Not when the hub is gone (the multiplexer
# ended: no parent, no terminal), and not after 5 quick ends in a row: then the pane keeps the
# error (tmux starts the pane's program again a second later, see jay_mux_repair).
trap - EXIT
cleanup
if [[ -f "$JAY_SIDEBAR_RESTART" ]]; then
  clear
  printf '\n  Reloading...\n'
  refresh_worktrees
  unset JAY_SIDEBAR_FAILS
else
  fails=0
  ((SECONDS < 5)) && fails=$((${JAY_SIDEBAR_FAILS:-0} + 1))
  [[ "$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ')" == 1 ]] && exit 1
  { : </dev/tty; } 2>/dev/null || exit 1
  printf '\n  The list ended (fzf exit %s). Starting it again...\n' "$rc"
  ((fails < 5)) || { printf '  It ended 5 times in a row: see the error above.\n'; exit 1; }
  export JAY_SIDEBAR_FAILS=$fails
  sleep 2
fi
exec "$0"
