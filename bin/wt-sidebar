#!/usr/bin/env bash
# wt sidebar — live list of worktrees and Claude agents for a narrow left pane.
# Click, double-click or Enter: an agent → shown in the hub's middle column (over the hub
# Claude), and review (tuicr, its turns) and files (yazi, when shown) switch to it; a worktree →
# review and files switch to it; "◆ hub" → the hub Claude (closes the agent viewer). Agents and
# the hub row take the focus to the middle; Enter on a worktree takes it to review. n/N: new agent
# here / in a new worktree  o: own Ghostty tab  t: review turns/commits
# d: remove the agent or worktree (asks first)  a: hide/show idle repos and main checkouts
# p: prune dead agents (folder gone; asks first)
# r: reload  h/l: narrower/wider  ?: keys  q: quit  (e for files is a key of the review pane)
# wt-sidebar --files: show files over review (e in the review pane, through wt-hub-keys).
set -uo pipefail
source "$HOME/.local/lib/wt-lib.sh"

STATE="$HOME/.local/state"
CACHE="$STATE/wt-worktrees.ndjson"
HIDE_IDLE="$STATE/wt-hub-sidebar.hide-idle"
mkdir -p "$STATE"

# The git signs of the rows: Nerd Font Octicons (one cell wide; private use, not East Asian
# wide), as UTF-8 bytes because bash 3.2 has no \u.
G_DIFF=$'\xef\x91\x80' G_NEW=$'\xef\x93\x90' G_UP=$'\xef\x90\xb1' G_DOWN=$'\xef\x90\xb3'
G_PUSH=$'\xef\x90\x83' G_PULL=$'\xef\x90\x84' G_ALERT=$'\xef\x90\xa1' G_OK=$'\xef\x90\xae'
G_MERGE=$'\xef\x90\x99' G_SYNC=$'\xef\x91\xaa'

refresh_worktrees() {
  wt-all --json >"$CACHE.$$" 2>/dev/null && mv "$CACHE.$$" "$CACHE"
}

# The folders of the agents in JSON $1 that no longer exist (a removed worktree), as a JSON array.
gone_dirs() {
  jq -r '.[] | .cwd // empty' <<<"$1" | sort -u | while IFS= read -r dir; do
    [[ -d "$dir" ]] || printf '%s\n' "$dir"
  done | jq -Rsc 'split("\n") | map(select(. != ""))'
}

rows() {
  local age=999
  [[ -s "$CACHE" ]] && age=$(($(date +%s) - $(stat -f %m "$CACHE")))
  if [[ ! -s "$CACHE" || "${1:-}" == --fresh ]]; then
    refresh_worktrees
  elif ((age > 30)); then
    (refresh_worktrees &) >/dev/null 2>&1
  fi
  local agents hub=""
  agents=$(claude agents --json --all 2>/dev/null) || agents='[]'
  [[ -f "$STATE/wt-hub.json" ]] && hub=$(jq -r '.sessionId // ""' "$STATE/wt-hub.json" 2>/dev/null)
  local inhub=false shown=""
  wtl_in_hub && inhub=true
  # The agent in the hub's middle column (empty: the hub Claude), marked with ▸ beside it.
  wtl_hub_role agent >/dev/null && shown=$(cut -f1 "$(wtl_hub_target_file agent)" 2>/dev/null)
  local hideidle=false
  [[ -f "$HIDE_IDLE" ]] && hideidle=true
  jq -rs --argjson agents "$agents" --arg hub "$hub" --argjson inhub "$inhub" --arg shown "$shown" \
    --argjson hideidle "$hideidle" --arg roots "$WT_ROOTS" --argjson gone "$(gone_dirs "$agents")" \
    --argjson gl "$(jq -nc --arg diff "$G_DIFF" --arg new "$G_NEW" --arg up "$G_UP" --arg down "$G_DOWN" \
      --arg push "$G_PUSH" --arg pull "$G_PULL" --arg alert "$G_ALERT" --arg ok "$G_OK" \
      --arg merge "$G_MERGE" --arg sync "$G_SYNC" '$ARGS.named')" \
    --argjson now "$(date +%s)" '
    def c($code): "\u001b[" + $code + "m";
    def age($ms): (($now - ($ms / 1000)) / 60 | floor) as $m
      | if $m < 60 then "\($m)m" elif $m < 2880 then "\($m / 60 | floor)h" else "\($m / 1440 | floor)d" end;
    def phase: if .state == "failed" then "failed"
      elif .state == "blocked" or .status == "waiting" then "input"
      elif .state == "working" or (.state == null and .status == "busy") then "working"
      else "idle" end;
    def glyph: {input: (c("1;33") + "!"), failed: (c("31") + "✗"), working: (c("32") + "●"), idle: (c("2") + "○")}[.] + c("0");
    def narrow: [8986,8987,9001,9002,9193,9194,9195,9196,9200,9203,9725,9726,9748,9749,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9855,9875,9889,9898,9899,9917,9918,9924,9925,9934,9940,9962,9970,9971,9973,9978,9981,9989,9994,9995,10024,10060,10062,10067,10068,10069,10071,10133,10134,10135,10160,10175,11035,11036,11088,11093,11904,11905,11906,11907,11908,11909,11910,11911,11912,11913,11914,11915,11916,11917,11918,11919,11920,11921,11922,11923,11924,11925,11926,11927,11928,11929,11931,11932,11933,11934,11935,11936,11937,11938,11939,11940,11941,11942,11943,11944,11945,11946,11947,11948,11949,11950,11951,11952,11953,11954,11955,11956,11957,11958,11959,11960,11961,11962,11963,11964,11965,11966,11967,11968,11969,11970,11971,11972,11973,11974,11975,11976,11977,11978,11979,11980,11981,11982,11983,11984,11985,11986,11987,11988,11989,11990,11991,11992,11993,11994,11995,11996,11997,11998,11999,12000,12001,12002,12003,12004,12005,12006,12007,12008,12009,12010,12011,12012,12013,12014,12015,12016,12017,12018,12019,12032,12033,12034,12035,12036,12037,12038,12039,12040,12041,12042,12043,12044,12045,12046,12047,12048,12049,12050,12051,12052,12053,12054,12055,12056,12057,12058,12059,12060,12061,12062,12063,12064,12065,12066,12067,12068,12069,12070,12071,12072,12073,12074,12075,12076,12077,12078,12079,12080,12081,12082,12083,12084,12085,12086,12087,12088,12089,12090,12091,12092,12093,12094,12095,12096,12097,12098,12099,12100,12101,12102,12103,12104,12105,12106,12107,12108,12109,12110,12111,12112,12113,12114,12115,12116,12117,12118,12119,12120,12121,12122,12123,12124,12125,12126,12127,12128,12129,12130,12131,12132,12133,12134,12135,12136,12137,12138,12139,12140,12141,12142,12143,12144,12145,12146,12147,12148,12149,12150,12151,12152,12153,12154,12155,12156,12157,12158,12159,12160,12161,12162,12163,12164,12165,12166,12167,12168,12169,12170,12171,12172,12173,12174,12175,12176,12177,12178,12179,12180,12181,12182,12183,12184,12185,12186,12187,12188,12189,12190,12191,12192,12193,12194,12195,12196,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283] as $wide | explode | map(select(. < 4352 or (. > 4447 and . < 11904) or (. > 42191 and . < 44032) or (. > 55203 and . < 63744) or (. > 64255 and . < 65040) or (. > 65049 and . < 65072) or (. > 65135 and . < 65280) or (. > 65376 and . < 65504) or (. > 65510 and . < 126976)) | select(. != 65039) | select(. as $c | $wide | index([$c]) | not)) | implode;
    def rank: {input: 0, failed: 1, working: 2, idle: 3}[.];
    def shown: $shown != "" and .id == $shown;
    def title: if shown then c("1;36") + (.name | narrow) + c("0") else (.name | narrow) end;
    . as $wts
    | ($wts | map(.path) | sort_by(length) | reverse) as $paths
    | def owner($cwd): first($paths[] | select($cwd == . or ($cwd | startswith(. + "/")))) // "";
      ($agents | map(select(.state != "stopped" and .sessionId != $hub)
        | (.cwd as $d | $gone | any(. == $d)) as $g | . + {gone: $g, wt: (if $g then "" else owner(.cwd) end), phase: phase})) as $ag
    | ($ag | map(.phase)) as $phases
    | (["input", "failed", "working", "idle"] | map(. as $p | ($phases | map(select(. == $p)) | length) as $n
        | select($n > 0) | "\($p | glyph) \($n) \($p)") | join("  ")) as $summary
    # Client › repo › worktree › agent. A client is the folder above the repo; repos right under
    # a root go to "Other" at the bottom. A repo row has its worktrees under it, the main checkout
    # first, then the removed worktrees that still have agents (dim, "(gone)": a folder
    # <repo>.<branch> or one in the repo). Agents in no repo go last, under "no repo". A main
    # checkout without an agent is idle, and so is a repo with only an idle main checkout: both
    # are dim, and hidden with $hideidle (key a).
    | ($roots | split(":") | map(rtrimstr("/"))) as $rootdirs
    | def byrank: sort_by((.phase | rank), -(.startedAt // 0));
      ($wts | map(. as $w | . + {agents: ($ag | map(select(.wt == $w.path)) | byrank)}
                 | . + {idle: (.main and (.agents | length == 0))})
        | group_by(.client + "/" + .repo | ascii_downcase)
        | map(first(.[] | select(.main)) as $main | ($main.path // "//none") as $m
              | {client: .[0].client, repo: .[0].repo, main: $main, trees: .,
                 loose: ($rootdirs | index([$m | sub("/[^/]*$"; "")]) != null),
                 dead: ($ag | map(select(.gone and (.cwd | startswith($m + ".") or startswith($m + "/")))) | group_by(.cwd)
                   | map({path: .[0].cwd, agents: byrank,
                          label: (.[0].cwd | if startswith($m + ".") then .[($m | length) + 1:] else split("/") | last end)}))}
              | . + {idle: (all(.trees[]; .idle) and .dead == [])})
        | map(select(.main != null))) as $repos
    | ($repos | map(select(.idle)) | length) as $idle
    | ($repos | map(select(.idle | not) | .trees[] | select(.idle)) | length) as $idlemain
    | ($repos | [.[].dead[].agents[].sessionId]) as $housed
    | ($ag | map(select(.wt == "" and (.sessionId as $s | $housed | index([$s]) | not))) | byrank) as $stray
    | def lead($col): (" " * ($col - 2)) + (if shown then c("1;36") + "▸ " + c("0") else "  " end);
      def agrow($col; $tail): "ag\t" + .sessionId + "\t" + lead($col) + (.phase | glyph) + " " + title + " " + c("2") + $tail + c("0");
      def bgage: (if .kind == "background" then "bg " else "" end) + age(.startedAt // 0);
      # Git signs (Nerd Font Octicons) with counts: conflicts now, a git operation, uncommitted
      # lines, untracked files, commits ahead of / behind the default branch, to push / to pull,
      # a merge into the default branch would conflict, safe to remove (empty or integrated).
      def safe: .git.state == "empty" or .git.state == "integrated";
      def gitsigns: .git as $g | [
          (if $g.conflicted then c("1;31") + $gl.merge + c("0") else empty end),
          (if $g.operation != null then c("33") + $gl.sync + ($g.operation | tostring) + c("0") else empty end),
          (if $g.added + $g.deleted > 0 or $g.modified or $g.staged then c("33") + $gl.diff + c("0")
             + (if $g.added > 0 then c("32") + "+\($g.added)" else "" end)
             + (if $g.deleted > 0 then c("31") + "-\($g.deleted)" else "" end) + c("0") else empty end),
          (if $g.untracked then c("33") + $gl.new + c("0") else empty end),
          (if $g.ahead > 0 and (safe | not) then c("32") + $gl.up + "\($g.ahead)" + c("0") else empty end),
          (if $g.behind > 0 and (safe | not) then c("31") + $gl.down + "\($g.behind)" + c("0") else empty end),
          (if $g.push > 0 then c("36") + $gl.push + "\($g.push)" + c("0") else empty end),
          (if $g.pull > 0 then c("36") + $gl.pull + "\($g.pull)" + c("0") else empty end),
          (if $g.state == "would_conflict" then c("31") + $gl.alert + c("0") else empty end),
          (if safe then c("2") + $gl.ok + c("0") else empty end)
        ] | join(" ");
      def info: (if .git then gitsigns else c("2") + (.symbols | narrow) end)
        + (if .task != "" then c("2") + " · " + (.task | narrow) else "" end);
      def reporows: select((.idle and $hideidle) | not)
        | ("repo\t" + .main.path + "\t  " + (if .idle then c("2") else c("1") end) + .repo + c("0")),
          (.trees[] | select((.idle and $hideidle) | not)
            | ("wt\t" + .path + "\t    " + (if .idle or (.git and safe) then c("2") else "" end) + (.branch | split("/") | last)
                 + c("0") + " " + info + c("0")),
              (.agents[] | agrow(6; bgage))),
          (.dead[] | ("gone\tgone:" + .path + "\t    " + c("2") + .label + " (gone)" + c("0")),
                     (.agents[] | agrow(6; bgage)));
      def heading($key; $name; $idle): " \tgap:" + $key + "\t ",
        "hdr\thdr:" + $key + "\t" + (if $idle then c("2") else c("1;38;5;173") end) + $name + c("0");
    "sum\tsum\t" + (if $summary == "" then c("2") + "No agents" + c("0") else $summary end),
      (if $inhub then "hub\thub\t" + (if $shown == "" then c("1;36") + "▸ " else "  " end)
         + c("1;36") + "◆ hub" + c("0") + c("2") + "  (this Claude)" + c("0") else empty end),
      ($repos | map(select(.loose | not)) | group_by(.client | ascii_downcase)[]
        | select((all(.[]; .idle) and $hideidle) | not)
        | heading(.[0].client; .[0].client; all(.[]; .idle)), (.[] | reporows)),
      ($repos | map(select(.loose))
        | select((map(select((.idle and $hideidle) | not)) | length) + ($stray | length) > 0)
        | heading("other"; "Other"; all(.[]; .idle) and $stray == []), (.[] | reporows),
          ($stray | select(length > 0)
            | ("hdr\thdr:norepo\t  " + c("2") + "no repo" + c("0")),
              (.[] | agrow(4; .cwd + (if .gone then " (gone)" else "" end))))),
      (if $hideidle and $idle + $idlemain > 0 then " \tgap:idle\t ",
         "idle\tidle\t" + c("2") + "a shows " + ([(if $idle > 0 then "\($idle) idle repo" + (if $idle > 1 then "s" else "" end) else empty end),
                                     (if $idlemain > 0 then "\($idlemain) idle main" else empty end)] | join(", ")) + c("0")
       else empty end)
  ' "$CACHE" | tee >(wc -l | tr -d ' ' >"${WT_SIDEBAR_COUNT:-/dev/null}") \
    >(head -1 | cut -f3 >"${WT_SIDEBAR_SUM:-/dev/null}")
}

# Move the focus from the list $1 columns to the right (the hub's middle column is 1, review
# and files are 2). `move-focus` moves the terminal's focus; `focus-pane-id` does not.
focus_column() {
  wtl_in_hub || return 0
  local i
  for ((i = 0; i < $1; i++)); do zellij action move-focus right >/dev/null 2>&1; done
}

# Pick row kind $1 with id $2. An agent or the hub row always moves the focus to the middle
# column (wtl_hub_show); a worktree with --focus (Enter) moves it to review. A repo row acts as
# its main checkout.
act() {
  case $1 in
    ag) wt-go "$2" >/dev/null 2>&1 ;;
    wt|repo) if wtl_in_hub; then
          wtl_hub_locked wtl_hub_target "$2"
          [[ "${3:-}" == --focus ]] && focus_column 2
        else
          wt-open "$2" >/dev/null 2>&1
        fi ;;
    hub) wtl_hub_locked wtl_hub_show_claude >/dev/null 2>&1 ;;
  esac
  return 0
}

path_of() {
  case $1 in
    wt|repo) printf '%s\n' "$2" ;;
    ag) claude agents --json --all 2>/dev/null | jq -r --arg s "$2" 'first(.[] | select(.sessionId == $s) | .cwd) // empty' ;;
  esac
}

view() {
  local path
  path=$(path_of "$2" "$3")
  [[ -n "$path" ]] || return 0
  case $1 in
    open) wt-open "$path" >/dev/null 2>&1 ;;
  esac
}

# Start an idle background agent from row kind $2 with id $3: $1 = here (in the row's worktree)
# or worktree (a new worktree from the row's repo through `wt new`; asks for the branch). The
# new agent shows in the hub's middle column, where you type its first prompt.
new_agent() {
  local mode=$1 kind=$2 id=$3 path top primary repo branch out agent i
  if [[ "$kind" == hdr || ("$mode" == here && "$kind" == repo) ]]; then
    pause "n starts an agent in a worktree: pick a worktree row. N on a repo or worktree row makes a new worktree of that repo."
    return 0
  fi
  path=$(path_of "$kind" "$id")
  [[ -n "$path" ]] || return 0
  top=$(wtl_toplevel "$path")
  primary=$(wtl_primary "$top")
  IFS=$'\t' read -r _ repo branch _ < <(wtl_describe "$top")
  if [[ "$mode" == worktree ]]; then
    say "New worktree and agent in $repo."
    printf 'Branch, empty to cancel: '
    read -r -e branch </dev/tty
    [[ -n "$branch" ]] || return 0
    say "Starting an agent in a new worktree $branch..."
    out=$(cd "$primary" && wt-new "$branch" --agent 2>&1)
  else
    say "Starting an agent in $repo/${branch##*/}..."
    out=$(cd "$top" && claude --bg --name "$(wtl_tab_name "$repo" "$branch")" 2>&1)
  fi
  # `claude --bg` prints "backgrounded · <short id> · <name> ...".
  agent=$(grep -oE 'backgrounded · [0-9a-f]{8}' <<<"$out" | grep -oE '[0-9a-f]{8}$' | tail -1)
  if [[ -z "$agent" ]]; then
    pause "Not started:

$out"
    return 0
  fi
  for i in $(seq 20); do
    wt-go "$agent" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  pause "Started $agent, but the hub cannot show it yet. Pick it in the list."
}

# The key hints under the list, keys in the headings' orange and labels in the plain text color
# (--color=footer:-1; fzf's own footer color is a dim blue-gray): short ones grouped, and with ?
# the full list, one key per line. Lines stay under 30 columns (the list is about 32 wide).
# --toggle switches between the two.
KEY=$'\e[38;5;173m' OFF=$'\e[0m'
YEL=$'\e[33m' GRN=$'\e[32m' RED=$'\e[31m' CYN=$'\e[36m' DIM=$'\e[2m'
FOOTER_SHORT="${KEY}⏎${OFF} open  ${KEY}n${OFF} new  ${KEY}d${OFF} remove
${KEY}t${OFF} turns/commits  ${KEY}?${OFF} keys"
FOOTER_FULL="${KEY}⏎${OFF}      open, focus moves
${KEY}click${OFF}  open
${KEY}n${OFF}      new agent here
${KEY}N${OFF}      new worktree + agent
${KEY}o${OFF}      own Ghostty tab
${KEY}d${OFF}      remove agent/worktree
${KEY}t${OFF}      turns ⇄ commits
${KEY}a${OFF}      hide/show idle repos
${KEY}p${OFF}      prune dead agents
${KEY}r${OFF}      reload
${KEY}j k${OFF}    move
${KEY}h l${OFF}    narrower / wider
${KEY}q${OFF}      quit
${KEY}?${OFF}      fewer keys
${KEY}e${OFF}      pane 3: files ⇄ review
${KEY}^g 1-3${OFF} pane 1 / 2 / 3
${KEY}^g h l${OFF} pane left / right
${KEY}^g ;${OFF}   last pane
${KEY}▸${OFF}      agent in middle pane
${KEY}◆ hub${OFF}  back to hub Claude
${YEL}${G_DIFF}${GRN}+1${RED}-2${OFF}  uncommitted lines
${YEL}${G_NEW}${OFF}      untracked files
${GRN}${G_UP}3 ${RED}${G_DOWN}2${OFF}  ahead/behind main
${CYN}${G_PUSH}1 ${G_PULL}4${OFF}  to push/to pull
${RED}${G_ALERT}${OFF}      merge would conflict
${DIM}${G_OK}${OFF}      safe to remove"
footer() {
  local flag=${WT_SIDEBAR_HELP:-/dev/null}
  if [[ "${1:-}" == --toggle ]]; then
    if [[ -f "$flag" ]]; then rm -f "$flag"; else : >"$flag"; fi
  fi
  if [[ -f "$flag" ]]; then printf '%s' "$FOOTER_FULL"; else printf '%s' "$FOOTER_SHORT"; fi
}

# Show text $1 on a clear pane, folded to its width.
say() {
  local cols
  cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
  clear
  printf '\n%s\n\n' "$1" | fold -s -w "$(( ${cols:-40} > 10 ? ${cols:-40} - 1 : 40 ))"
}

# Ask $1 and return 0 when the answer is y.
confirm() {
  local answer
  say "$1"
  printf 'y: remove   other key: cancel\n'
  read -rsn1 answer </dev/tty
  [[ "$answer" == y ]]
}

pause() {
  say "$1"
  printf 'Press a key.\n'
  read -rsn1 _ </dev/tty
}

# Remove the agent or worktree in row kind $1 with id $2, after a confirm. Never forced:
# `claude rm` and `wt remove` stop on unpushed or uncommitted work and the list shows why.
remove() {
  local kind=$1 id=$2 agents agent out name short top main branch busy pane
  agents=$(claude agents --json --all 2>/dev/null) || agents='[]'
  case $kind in
    ag)
      agent=$(jq -c --arg s "$id" 'first(.[] | select(.sessionId == $s)) // empty' <<<"$agents")
      [[ -n "$agent" ]] || return 0
      name=$(jq -r '.name // .id' <<<"$agent")
      short=$(jq -r '.id // empty' <<<"$agent")
      if [[ "$(jq -r .kind <<<"$agent")" != background || -z "$short" ]]; then
        pause "\"$name\" is an interactive session. Close it in its own tab."
        return 0
      fi
      confirm "Remove agent \"$name\" ($short)?

This deletes the background session, and the worktree it made, if any. Unpushed commits stop the removal." || return 0
      out=$(claude rm "$short" 2>&1) || pause "Not removed:

$out" ;;
    wt)
      top=$id
      IFS=$'\t' read -r main branch < <(jq -r --arg p "$top" 'select(.path == $p) | "\(.main)\t\(.branch)"' "$CACHE" | head -1)
      if [[ "$main" == true ]]; then
        pause "$top is a main checkout. The list never removes it."
        return 0
      fi
      busy=$(jq -r --arg p "$top" '.[] | (.cwd // "") as $cwd | select(.state != "stopped" and ($cwd == $p or ($cwd | startswith($p + "/"))))
        | "  \(.name // .id)"' <<<"$agents")
      if [[ -n "$busy" ]]; then
        pause "Agents run in this worktree. Remove them first:

$busy"
        return 0
      fi
      confirm "Remove worktree ${branch:-$top}?

$top

The branch is deleted only if it is merged. Uncommitted changes stop the removal." || return 0
      if [[ "$(cut -f1 "$(wtl_hub_target_file review)" 2>/dev/null)" == "$top" ]]; then
        wtl_hub_locked wtl_hub_show_review
        pane=$(wtl_hub_locked wtl_hub_point review "" | cut -f1)
        [[ -n "$pane" ]] && zellij -s "$WT_HUB_SESSION" action rename-pane -p "$pane" review >/dev/null 2>&1
      fi
      out=$(wt -C "$top" remove --foreground 2>&1) || pause "Not removed:

$out"
      refresh_worktrees ;;
  esac
  return 0
}

# Remove the dead agents, after a confirm: background agents whose folder is gone (a removed
# worktree) and that do not run now. `claude rm` deletes the session.
prune() {
  local agents dead id name failed="" out
  agents=$(claude agents --json --all 2>/dev/null) || agents='[]'
  dead=$(jq -r --argjson gone "$(gone_dirs "$agents")" '.[]
    | select(.kind == "background" and .id != null and .state != "stopped"
        and (.state | IN("working", "blocked") | not) and (.status | IN("busy", "waiting") | not))
    | (.cwd // "") as $d | select($gone | index([$d]))
    | [.id, (.name // .id)] | @tsv' <<<"$agents")
  if [[ -z "$dead" ]]; then
    pause "No dead agents: every agent's folder exists, or the agent still runs."
    return 0
  fi
  confirm "Remove these agents? Their folders are gone.

$(cut -f2 <<<"$dead" | sed 's/^/  /')" || return 0
  while IFS=$'\t' read -r id name; do
    out=$(claude rm "$id" 2>&1) || failed+="  $name: $out"$'\n'
  done <<<"$dead"
  [[ -z "$failed" ]] || pause "Not removed:

$failed"
  return 0
}

case ${1:-} in
  --rows) shift; rows "$@"; exit 0 ;;
  --prune) prune; exit 0 ;;
  --act) shift; act "$@"; exit 0 ;;
  --view) shift; view "$@"; exit 0 ;;
  --remove) shift; remove "$@"; exit 0 ;;
  --new) shift; new_agent "$@"; exit 0 ;;
  --toggle) wtl_hub_locked wtl_hub_toggle_review; exit 0 ;;
  --files) wtl_hub_locked wtl_hub_show_files; exit 0 ;;
  --idle) if [[ -f "$HIDE_IDLE" ]]; then rm -f "$HIDE_IDLE"; else : >"$HIDE_IDLE"; fi; exit 0 ;;
  --footer) shift; footer "$@"; exit 0 ;;
  -h|--help) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

sock="$STATE/wt-sidebar.$$.sock"
export WT_SIDEBAR_COUNT="$STATE/wt-sidebar.$$.count" WT_SIDEBAR_SUM="$STATE/wt-sidebar.$$.sum" \
  WT_SIDEBAR_HELP="$STATE/wt-sidebar.$$.help"
post() { curl -s --max-time 2 --unix-socket "$sock" -X POST http://localhost -d "$1" >/dev/null 2>&1 || true; }

# Send the agent counts (the list's first row) to the hub's bar (zjstatus, see wt-hub) when
# they change, and every 30 s for a bar that started again.
last_sum=""
send_sum() {
  local sum
  sum=$(cat "$WT_SIDEBAR_SUM" 2>/dev/null)
  [[ -n "$sum" ]] || return 0
  [[ "$sum" != "$last_sum" || "${1:-}" == --again ]] || return 0
  last_sum=$sum
  (zellij pipe "zjstatus::pipe::pipe_agents::$sum" >/dev/null 2>&1 &)
}

# Save the list's share of the hub's width when it changes (mouse drag, h/l), so `wt hub`
# starts it at that width.
last_cols=""
remember_width() {
  local cols share
  cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
  [[ -n "$cols" && "$cols" != "$last_cols" ]] || return 0
  last_cols=$cols
  share=$(zellij action list-panes -a -j 2>/dev/null | jq --argjson me "${ZELLIJ_PANE_ID:--1}" '
    (map(select(.is_plugin | not)) | map(select(.id == $me)) | first) as $pane
    | select($pane != null)
    | [.[] | select(.tab_id == $pane.tab_id and (.is_floating | not)) | .pane_x + .pane_columns] | max
    | ($pane.pane_columns * 100 / .) | round')
  [[ -n "$share" ]] && printf '%s\n' "$share" >"$STATE/wt-hub-sidebar.pct"
}

(
  tick=0
  while sleep 3; do
    tick=$((tick + 1))
    wtl_in_hub && remember_width
    before=$(cat "$WT_SIDEBAR_COUNT" 2>/dev/null)
    post 'reload-sync(wt-sidebar --rows)'
    sleep 1
    after=$(cat "$WT_SIDEBAR_COUNT" 2>/dev/null)
    if [[ "$before" != "$after" ]] || ((tick % 10 == 0)); then post 'clear-screen'; fi
    if wtl_in_hub; then
      if ((tick % 10 == 0)); then send_sum --again; else send_sum; fi
    fi
  done
) &
loop=$!
trap 'kill $loop 2>/dev/null; rm -f "$sock" "$WT_SIDEBAR_COUNT" "$WT_SIDEBAR_SUM" "$WT_SIDEBAR_HELP"' EXIT

rows | fzf --ansi --listen="$sock" --no-input --no-sort --layout=reverse --info=hidden --no-scrollbar \
  --delimiter=$'\t' --with-nth=3 --track --id-nth=2 --pointer='▌' --gutter=' ' --highlight-line \
  --footer="$(footer)" --color=footer:-1 \
  --bind '?:transform-footer(wt-sidebar --footer --toggle)' \
  --bind 'd:execute(wt-sidebar --remove {1} {2})+reload-sync(wt-sidebar --rows)+clear-screen' \
  --bind 'n:execute(wt-sidebar --new here {1} {2})+reload-sync(wt-sidebar --rows --fresh)+clear-screen' \
  --bind 'N:execute(wt-sidebar --new worktree {1} {2})+reload-sync(wt-sidebar --rows --fresh)+clear-screen' \
  --bind 'enter:execute-silent(wt-sidebar --act {1} {2} --focus)+reload-sync(wt-sidebar --rows)' \
  --bind 'double-click:execute-silent(wt-sidebar --act {1} {2})+reload-sync(wt-sidebar --rows)' \
  --bind 'left-click:execute-silent(wt-sidebar --act {1} {2})+reload-sync(wt-sidebar --rows)' \
  --bind 'r:reload-sync(wt-sidebar --rows --fresh)' \
  --bind 'o:execute-silent(wt-sidebar --view open {1} {2})' \
  --bind 't:execute-silent(wt-sidebar --toggle)' \
  --bind 'a:execute-silent(wt-sidebar --idle)+reload-sync(wt-sidebar --rows)+clear-screen' \
  --bind 'p:execute(wt-sidebar --prune)+reload-sync(wt-sidebar --rows)+clear-screen' \
  --bind 'h:execute-silent(zellij action resize -p "$ZELLIJ_PANE_ID" decrease right)' \
  --bind 'l:execute-silent(zellij action resize -p "$ZELLIJ_PANE_ID" increase right)' \
  --bind 'j:down,k:up,q:abort,esc:ignore'
