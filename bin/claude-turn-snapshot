#!/usr/bin/env bash
# claude-turn-snapshot — Claude Code hook (UserPromptSubmit, Stop, PostToolUse on EnterWorktree
# and ExitWorktree) that records the worktree as a hidden commit chain per agent, one commit per
# agent turn. <id> is a background agent's short id (it stays after a resume or /clear), else
# the first 8 characters of the session id:
#   refs/wt-turns/<id>/base   HEAD when the agent's first snapshot was taken
#   refs/wt-turns/<id>/head   the latest snapshot; each snapshot's parent is the one before
# Review one turn with `tuicr -r <turn>~1..<turn>`, all of them with `tuicr -r base..head`.
# Branch, index and files are never touched: it hashes the tree through a copy of the index.
# --list [path]            list the turn chains of a worktree (default: this folder)
# --prune [--dry-run]      remove the chains of agents that `claude agents --all` no longer
#                          lists, when their worktree is gone or their last turn is older than
#                          7 days (an ended interactive session keeps its turns for a week),
#                          and their lazygit views (wt-hub-lazygit).
set -uo pipefail

if [[ "${1:-}" == --prune ]]; then
  dry=false
  [[ "${2:-}" == --dry-run ]] && dry=true
  state="$HOME/.local/state/wt-turns"
  cache="$HOME/.local/state/wt-worktrees.ndjson"
  week=$((7 * 86400)) now=$(date +%s)
  # Never prune on missing data: no agent list or no repo list, no prune.
  agents=$(claude agents --json --all 2>/dev/null) || exit 0
  listed=$(jq -r '.[] | (.id // empty), .sessionId[0:8]' <<<"$agents" | sort -u)
  [[ -s "$cache" ]] || exit 0
  # remove <repo or empty> <id> <why>: the chain's refs and its state files.
  remove() {
    if $dry; then
      printf 'would remove %s (%s)\n' "$2" "$3"
      return
    fi
    if [[ -n "$1" ]]; then
      git -C "$1" update-ref -d "refs/wt-turns/$2/head" 2>/dev/null
      git -C "$1" update-ref -d "refs/wt-turns/$2/base" 2>/dev/null
    fi
    rm -f "$state/$2".*
    # The chain's view repo for lazygit (wt-hub-lazygit), if any.
    rm -rf "$HOME/.local/state/wt-hub/lazygit/views/$2"
    printf '%s turn chain %s removed (%s)\n' "$(date '+%F %T')" "$2" "$3"
  }
  seen=""
  for repo in $(jq -r 'select(.main == true) | .path' "$cache" | sort -u); do
    while IFS=$'\t' read -r id when; do
      [[ -n "$id" ]] || continue
      seen+=" $id"
      grep -qxF "$id" <<<"$listed" && continue
      wt=$(cat "$state/$id.worktree" 2>/dev/null)
      if [[ -n "$wt" && ! -d "$wt" ]]; then
        remove "$repo" "$id" "worktree gone: $wt"
      elif ((now - when > week)); then
        remove "$repo" "$id" "last turn over 7 days ago"
      fi
    done < <(git -C "$repo" for-each-ref --format='%(refname:lstrip=2)%09%(committerdate:unix)' 'refs/wt-turns/*/head' 2>/dev/null \
      | sed 's#/head\t#\t#')
  done
  # State files of sessions that never got a chain (no turn yet), on the same terms.
  for file in "$state"/*.worktree; do
    [[ -f "$file" ]] || continue
    id=$(basename "$file" .worktree)
    [[ " $seen " == *" $id "* ]] && continue
    grep -qxF "$id" <<<"$listed" && continue
    wt=$(cat "$file" 2>/dev/null)
    if [[ -n "$wt" && ! -d "$wt" ]] || ((now - $(stat -f %m "$file") > week)); then
      remove "" "$id" "no chain"
    fi
  done
  exit 0
fi

if [[ "${1:-}" == --list ]]; then
  top=$(git -C "${2:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || exit 0
  git -C "$top" for-each-ref --format='%(refname)' 'refs/wt-turns/*/head' | while read -r ref; do
    s=${ref#refs/wt-turns/}; s=${s%/head}
    printf '%s\t%s\n' "$s" "$(git -C "$top" log -1 --format='%ar · %s' "$ref")"
  done
  exit 0
fi

input=$(cat)
event=$(jq -r '.hook_event_name // ""' <<<"$input")
cwd=$(jq -r '.cwd // ""' <<<"$input")
sid=$(jq -r '.session_id // ""' <<<"$input")
[[ -n "$cwd" && -n "$sid" ]] || exit 0
top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || exit 0

# A background agent keeps its id when its session id changes (a resume, /clear), so its chain
# is named after the agent: the job folder's id, when the job's state names this session.
short=${sid:0:8}
job=${CLAUDE_JOB_DIR:-}
if [[ -n "$job" ]] && jq -e --arg s "$sid" '.sessionId == $s or .resumeSessionId == $s' "$job/state.json" >/dev/null 2>&1; then
  short=$(basename "$job")
fi
state="$HOME/.local/state/wt-turns"
mkdir -p "$state"
prompt_file="$state/$short.prompt"
worktree_file="$state/$short.worktree"
head_ref="refs/wt-turns/$short/head"
base_ref="refs/wt-turns/$short/base"

# The tree of worktree $1's files, hashed through a copy of its index.
tree_of() {
  local index
  index=$(mktemp "$state/index.XXXXXX")
  cp "$(git -C "$1" rev-parse --path-format=absolute --git-path index)" "$index" 2>/dev/null || true
  GIT_INDEX_FILE="$index" git -C "$1" add -A >/dev/null 2>&1
  GIT_INDEX_FILE="$index" git -C "$1" write-tree 2>/dev/null
  rm -f "$index"
}

# Add a commit with tree $1, subject $2 and body $3 to the chain; none when the tree is the same.
add() {
  local tree=$1 subject=$2 body=${3:-} parent commit
  [[ -n "$tree" ]] || return 0
  # The chain starts at the base, set once. Before the first turn commit there is no head, and
  # an agent that commits its work leaves a clean tree, so the turn shows only against the base.
  if ! parent=$(git -C "$top" rev-parse -q --verify "$head_ref") \
    && ! parent=$(git -C "$top" rev-parse -q --verify "$base_ref"); then
    parent=$(git -C "$top" rev-parse -q --verify HEAD) || return 0
    git -C "$top" update-ref "$base_ref" "$parent"
    printf '%s\n' "$top" >"$worktree_file"
  fi
  [[ "$tree" == "$(git -C "$top" rev-parse "$parent^{tree}")" ]] && return 0
  commit=$(printf '%s\n%s' "$subject" "${body:+$'\n'$body}" | git -C "$top" commit-tree "$tree" -p "$parent") || return 0
  git -C "$top" update-ref "$head_ref" "$commit"
}

# An agent that goes into another worktree of the repo (EnterWorktree, ExitWorktree) keeps its
# chain. A commit `worktree · <folder>` gives the chain the files of the new worktree, so that the
# next turn shows only its own changes, not the difference between the two worktrees. Right after
# the tool (PostToolUse), the changes of the turn in the old worktree get a commit first. A move
# found later (no PostToolUse hook) takes the new worktree's files at the prompt, its HEAD at Stop.
was=$(cat "$worktree_file" 2>/dev/null)
if [[ -n "$was" && ! "$was" -ef "$top" ]] && git -C "$top" rev-parse -q --verify "$base_ref" >/dev/null; then
  prompt=$(cat "$prompt_file" 2>/dev/null)
  if [[ "$event" == PostToolUse && -d "$was" ]] \
    && [[ "$(git -C "$was" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)" ]]; then
    add "$(tree_of "$was")" "turn, in ${was##*/} · ${prompt:-(no prompt)}"
  fi
  if [[ "$event" == Stop ]]; then
    tree=$(git -C "$top" rev-parse -q --verify 'HEAD^{tree}')
  else
    tree=$(tree_of "$top")
  fi
  add "$tree" "worktree · ${top##*/}" "The agent went from $was to $top."
  printf '%s\n' "$top" >"$worktree_file"
fi

case $event in
  UserPromptSubmit)
    jq -r '.prompt // ""' <<<"$input" | tr '\n' ' ' | cut -c1-100 >"$prompt_file"
    add "$(tree_of "$top")" "between turns · edits made outside the agent"
    ;;
  Stop)
    prompt=$(cat "$prompt_file" 2>/dev/null)
    result=$(jq -r '.last_assistant_message // ""' <<<"$input" | awk '
      /^(result|needs input|failed):/ { flagged = $0 }
      NF && !first { first = $0 }
      END { print (flagged != "" ? flagged : first) }' | cut -c1-200)
    add "$(tree_of "$top")" "turn · ${prompt:-(no prompt)}" "$result"
    ;;
esac
exit 0
