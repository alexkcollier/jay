#!/usr/bin/env bash
# jay all [-a]   worktrees of every repo, grouped by client, with agents and task notes
# jay pick [-a]  the same list in fzf; Enter runs `jay open` on the row
# jay all --json one JSON object per worktree (for the hub sidebar); implies -a
#   -a  also show repos that only have their main checkout and no agent
set -euo pipefail
source "$HOME/.local/lib/jay-lib.sh"

show_all=false json=false
case ${1:-} in
  -a) show_all=true ;;
  --json) show_all=true json=true ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

repos() {
  local root
  IFS=: read -ra roots <<<"$JAY_ROOTS"
  for root in "${roots[@]}"; do
    find "$root" -mindepth 2 -maxdepth 3 -name node_modules -prune -o -type d -name .git -print 2>/dev/null
  done | sed 's#/.git$##' | sort -u
}

# Commits to push / to pull for the worktrees of repo $1 (wt list JSON $2) whose branch has no
# tracking branch but is on origin (pushed without -u, as a PR branch can be): one JSON object
# per worktree path. Local refs only, no fetch.
remote_counts() {
  local repo=$1 path branch sha counts
  jq -r '.items[] | select(.worktree.path != null and .upstream == null and .branch != null)
    | [.worktree.path, .branch, .head.sha] | @tsv' "$2" | while IFS=$'\t' read -r path branch sha; do
    git -C "$repo" rev-parse --verify -q "refs/remotes/origin/$branch" >/dev/null || continue
    counts=$(git -C "$repo" rev-list --left-right --count "refs/remotes/origin/$branch...$sha" 2>/dev/null) || continue
    jq -nc --arg p "$path" --argjson pull "${counts%%[[:space:]]*}" --argjson push "${counts##*[[:space:]]}" \
      '{path: $p, push: $push, pull: $pull}'
  done
}

jay-agents --json >"$tmp/agents.json" 2>/dev/null || echo '[]' >"$tmp/agents.json" &
i=0
while IFS= read -r repo; do
  i=$((i + 1))
  { printf '%s\t%s\n' "$repo" "$(jay_client "$repo")" >"$tmp/$i.meta"
    wt -C "$repo" list --format json >"$tmp/$i.json" 2>/dev/null || echo '{"items":[]}' >"$tmp/$i.json"
    remote_counts "$repo" "$tmp/$i.json" >"$tmp/$i.remote"; } &
done < <(repos)
wait

rows=$(
  for meta in "$tmp"/*.meta; do
    IFS=$'\t' read -r repo client <"$meta"
    jq -c --arg repo "$(basename "$repo")" --arg client "$client" --slurpfile remote "${meta%.meta}.remote" '
      ($remote | map({(.path): .}) | add // {}) as $origin
      | .items[] | select(.worktree.path != null) | $origin[.worktree.path] as $o | {
        client: $client, repo: $repo, branch: (.branch // "(detached)"),
        path: .worktree.path, main: (.worktree.main // false),
        symbols: (.display.symbols // ""),
        git: {
          added: (.worktree.changes.diff.added // 0), deleted: (.worktree.changes.diff.deleted // 0),
          staged: (.worktree.changes.staged // false), modified: (.worktree.changes.modified // false),
          untracked: (.worktree.changes.untracked // false), conflicted: (.worktree.changes.conflicted // false),
          operation: .worktree.operation, state: (.display.state // ""),
          ahead: (.default_branch.ahead // 0), behind: (.default_branch.behind // 0),
          # The branch on the remote: its tracking branch, else origin/<branch>.
          remote: (.upstream != null or $o != null),
          push: (.upstream.ahead // $o.push // 0), pull: (.upstream.behind // $o.pull // 0)
        },
        task: (.display.columns.Task // .vars.task // "")
      }' "${meta%.meta}.json"
  done | jq -rs --slurpfile agents "$tmp/agents.json" --argjson all "$show_all" --argjson json "$json" '
    . as $rows
    | ($rows | map(.path) | sort_by(length) | reverse) as $paths
    | def owner($cwd): first($paths[] | select($cwd == . or ($cwd | startswith(. + "/"))));
      # .phase from `jay agents --json` (jay_agent_phases), the rule of the list and the mod.
      ($agents[0] | map(select(.state != "stopped") | . + {wt: owner(.cwd)})) as $ag
    | map(. as $r | ($ag | map(select(.wt == $r.path) | .phase // "idle")) as $mine
        | $r + (["input", "failed", "unread", "working", "idle"]
                | map(. as $p | {($p): ($mine | map(select(. == $p)) | length)}) | add))
    | group_by(.client + "/" + .repo)
    | map(select($all or length > 1 or any(.[]; .input + .failed + .unread + .working + .idle > 0)))
    | flatten
    | sort_by(.client, .repo, (.main | not), .branch)
    | .[]
    | if $json then tojson else . end
    | if $json then . else (def pad($n): (. + (" " * $n))[:$n];
      [ (.client | pad(10)), (.repo | pad(18)), (.branch | pad(44)), (.symbols | pad(6)),
        ([ (if .input > 0 then "\(.input) input" else empty end),
           (if .failed > 0 then "\(.failed) failed" else empty end),
           (if .unread > 0 then "\(.unread) unread" else empty end),
           (if .working > 0 then "\(.working) working" else empty end),
           (if .idle > 0 then "\(.idle) idle" else empty end) ] | join(" ") | pad(30)),
        .task, .path ] | @tsv) end'
)

if $json; then
  [[ -n "$rows" ]] && printf '%s\n' "$rows"
  exit 0
fi
[[ -n "$rows" ]] || { echo "No worktrees found under $JAY_ROOTS"; exit 0; }

render() {
  awk -F'\t' '
    BEGIN { bold = "\033[1m"; dim = "\033[2m"; yellow = "\033[33m"; reset = "\033[0m" }
    {
      agents = $5; if (agents ~ /input/) agents = yellow agents reset
      printf "%s%s%s %s %s %s %s %s%s%s\t%s\n", bold, $1, reset, $2, $3, $4, agents, dim, $6, reset, $7
    }'
}

if [[ "$(basename "$0")" == jay-pick ]]; then
  choice=$(render <<<"$rows" | fzf --ansi --delimiter=$'\t' --with-nth=1 --no-sort --layout=reverse \
    --header='Enter: open its Ghostty tab   Ctrl-A: agents in this worktree' \
    --preview='git -C {2} status -sb | head -15; echo; git -C {2} log --oneline -8 --color=always' \
    --preview-window=down,45% \
    --bind='ctrl-a:become(jay-agents {2})') || exit 0
  exec jay-open "$(cut -f2 <<<"$choice")"
fi

render <<<"$rows" | cut -f1
