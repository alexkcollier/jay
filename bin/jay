#!/usr/bin/env bash
# jay — the hub, session "jay" in zellij (default) or in jay's own tmux server (JAY_MUX=tmux):
# the live worktree list (left), the picked agent (middle; at start the hub Claude) and review +
# files (right); a tasks tab per worktree for dev servers (jay run). Goes to the hub's Ghostty
# tab when it has one, else opens the hub in this terminal; a new tab only without a terminal
# or from inside another session of the same multiplexer. A running hub gets back its list,
# agent or review pane when that is gone.
# --here: in this terminal.  --tab: in a new tab.  --print-layout: the layout it starts.
# --print-tasks-tab <worktree> <name>: the zellij layout of a worktree's tasks tab.
# jay <command> [args]: runs jay-<command> (jay --help lists them).
set -euo pipefail

usage() {
  cat <<'EOF'
jay: a worktree and agent hub (it was wt-hub).

  jay                       open the hub (session "jay"): its Ghostty tab, else this
                            terminal, else a new tab. JAY_MUX=tmux: the tmux hub
                            (beside a zellij one); tmux -L jay kill-server ends it.
                            A list, agent or review pane that is gone comes back
  jay --here | --tab        open it in this terminal | in a new Ghostty tab
  jay --print-layout        print the hub's layout
  jay <command> [args]      run jay-<command>; jay <command> -h shows its help

Commands:
  new <branch|pr:N> [-b base] [-t task] [-a] [-- prompt]
                            a worktree for a change, and a background agent in it
  go <agent>                bring an agent in front (id, name, part of a name; hub: the hub Claude)
  agents [path]             the Claude sessions in JAY_ROOTS in fzf (--json, --orchestrators)
  all [-a] | --json         the worktrees of every repo, with agents and task notes
  pick [-a]                 the same in fzf; Enter: jay open
  open [branch|path]        the worktree's own zellij session in a Ghostty tab
  edit <file or folder>     open it in your editor, in its project
  run <command...>          a task (dev server, watcher) in the hub's tasks tab;
                            also run ls, log, wait, stop, restart, port
  c [prompt]                Claude here as a background agent, attached (c is short for it)
  clear <id>                a fresh context (/clear) for an idle background agent
  renew <id|name>           a fresh context with jay's current prompt for an orchestrator
                            or the hub Claude: a new agent, same name; the old one goes
  respawn [<id> | --idle]   agents on an old Claude Code: list them, or move them onto the
                            installed one when they are quiet (--force <id>: also when not)
  snapshot --list | --prune the turn chains of a worktree; remove the old ones
  setup [path]              copy ignored files and install dependencies in a worktree

The hub's internal commands: sidebar, pane, keys, lazygit, diff, and the hooks notify,
snapshot, guard and run --hook. Worktree operations stay worktrunk's: wt switch, wt list, wt merge,
wt remove.
EOF
}

case ${1:-} in
  -h | --help) usage; exit 0 ;;
  "" | --here | --tab | --print-layout | --print-tasks-tab) ;;
  -*) echo "jay: unknown option $1 (jay --help)" >&2; exit 2 ;;
  *)
    # Git style: jay-<command> from PATH, else from ~/.local/bin (a notice click has launchd's
    # PATH).
    cmd="jay-$1"
    shift
    command -v "$cmd" >/dev/null 2>&1 && exec "$cmd" "$@"
    [[ -x "$HOME/.local/bin/$cmd" ]] && exec "$HOME/.local/bin/$cmd" "$@"
    echo "jay: no command ${cmd#jay-} (jay --help)" >&2
    exit 2 ;;
esac

source "$HOME/.local/lib/jay-lib.sh"

root=${JAY_ROOTS%%:*}

# The hub of wt-hub (jay's old name) is the zellij session "hub", with the list pane
# "worktrees". A second hub next to it would share the hub Claude and the agents' marks: the old
# one quits first.
no_old_hub() {
  jay_mux_old_hub || return 0
  echo "jay: the hub of wt-hub still runs (zellij session hub). Quit it first: Ctrl g, then Ctrl q in it (the agents keep running). Then run jay again." >&2
  exit 1
}

# Only a running hub that answers is reused (jay_mux_alive). Any other is removed, and the hub
# starts fresh from the layout.
fresh_start() {
  no_old_hub
  jay_mux_kill
  jay_state_dir
  jay_hub_reset
}

if [[ "${1:-}" == --print-layout ]]; then
  jay_mux_print_layout
  exit 0
fi
# The layout of a worktree's tasks tab, as older versions of jay run asked for it.
if [[ "${1:-}" == --print-tasks-tab ]]; then
  [[ -n "${2:-}" && -n "${3:-}" ]] || { echo "jay --print-tasks-tab <worktree> <name>" >&2; exit 2; }
  _jay_zj_tasks_layout "$(sed 's/[\\"]/\\&/g' <<<"$2")" "$3"
  exit 0
fi

where=${1:-}

# A running hub whose list, agent or review pane is gone (closed, or its program ended) gets it
# back first, in its column (jay_hub_repair).
if jay_mux_alive; then
  jay_hub_locked jay_hub_repair >/dev/null || true
fi

# A hub that runs in a Ghostty tab: go to that tab.
if [[ "$where" != --here ]] && jay_mux_alive && tab=$(jay_mux_gh_tab); then
  jay_gh_select "$tab"
  exit 0
fi

# Else in this terminal (no new tab by default). Not possible without a terminal (an
# agent, a script) or inside a zellij session (nested; its Ctrl g would take jay's keys), or for
# the tmux hub inside a tmux session: then a new tab.
nested=false
[[ -n "${ZELLIJ:-}" || ( "$JAY_MUX" == tmux && -n "${TMUX:-}" ) ]] && nested=true
if [[ "$where" == --here ]] || [[ "$where" != --tab && -t 0 && -t 1 && $nested == false ]]; then
  jay_mux_alive && jay_mux_attach
  fresh_start
  # The hub's panes inherit the server's environment. A Ghostty started by an agent passes that
  # agent's CLAUDE_* variables to every tab, and in the hub they make jay_in_hub false.
  for var in $(compgen -e | grep -E '^(CLAUDE|ANTHROPIC)'); do unset "$var"; done
  jay_mux_start
fi

# A new tab needs tab control (Ghostty only, see jay_gh_ok).
if ! jay_gh_ok; then
  echo "jay: a new tab needs Ghostty. Run jay in a terminal, outside zellij." >&2
  exit 1
fi

if jay_mux_alive; then
  jay_gh_new_tab "$root" "$(jay_mux_attach_cmd)" >/dev/null
else
  no_old_hub
  jay_gh_new_tab "$root" "JAY_MUX=$JAY_MUX $HOME/.local/bin/jay --here" >/dev/null
fi
