#!/usr/bin/env bash
# jay go <agent id | session id | name, or a part of a name | hub (the hub Claude)>
# Bring a Claude session in front. While the hub runs, a background one opens in the
# hub's agent pane (from anywhere, also from an agent) and the hub's Ghostty tab comes
# to the front; with no hub, in a Ghostty tab running `claude attach`.
# An interactive one: its own Ghostty tab (and zellij pane).
set -euo pipefail
source "$HOME/.local/lib/jay-lib.sh"

[[ -n "${1:-}" && "$1" != -h && "$1" != --help ]] || { sed -n '2,5s/^# \{0,1\}//p' "$0"; exit 0; }

query="$*"
query=${query#[\"\']}; query=${query%[\"\']}
# hub: the hub Claude (started when it has none).
hubid=$(jay_hub_claude_id)
if [[ "$query" == hub ]]; then
  hubid=$(jay_hub_claude) || { echo "Could not start the hub Claude." >&2; exit 1; }
  query=$hubid
fi
# Match order: id or session id (exact, then prefix), exact name, then a part of a name (any
# case). Several name matches: the live ones win, but never over an agent with the same name (the
# hub gives each new agent its own name, but `claude --bg --name` outside it can repeat one).
# Still several is an error that lists their ids.
agents=$(claude agents --json --all 2>/dev/null) || agents='[]'
matches=$(jq -c --arg q "$query" '
  ($q | ascii_downcase) as $l
  | def lname: .name // "" | ascii_downcase;
  [.[] | select(.id == $q or .sessionId == $q)] as $same
  | [.[] | select(.sessionId // "" | startswith($q))] as $prefix
  | [.[] | select(lname == $l)] as $exact
  | [.[] | select(lname | contains($l))] as $part
  | (if ($same | length) > 0 then $same[:1] elif ($prefix | length) > 0 then $prefix
     elif ($exact | length) > 0 then $exact else $part end) as $found
  | ([$found[] | select(.state != "done" and .state != "failed")]) as $live
  | ([$found[] | select(.state == "done" or .state == "failed") | lname]) as $ended
  | if ($found | length) > 1 and ($live | length) > 0
       and all($live[]; lname as $n | $ended | index([$n]) | not) then $live else $found end
  | .[]' <<<"$agents")
[[ -n "$matches" ]] || { echo "No Claude session matches \"$query\"" >&2; exit 1; }
if (( $(wc -l <<<"$matches") > 1 )); then
  echo "Several Claude sessions match \"$query\". Give an id: jay go <id>" >&2
  jq -r '"  \(.id // .sessionId[0:8])  \(.name // "")  \(.state // .status // "")  \(.cwd // "" | sub("^" + env.HOME; "~"))"' <<<"$matches" >&2
  exit 1
fi
agent=$matches
# Another agent with the same name (made outside the hub): its title in the hub has the id too.
title=$(jq -r --argjson a "$agent" '($a.name // "" | ascii_downcase) as $n
  | ($a.name // $a.id // $a.sessionId[0:8]) + (if $n != "" and ([.[] | select((.name // "" | ascii_downcase) == $n)] | length) > 1
                         then " " + ($a.id // $a.sessionId[0:8]) else "" end)' <<<"$agents")

kind=$(jq -r .kind <<<"$agent")
id=$(jq -r '.id // empty' <<<"$agent")
sid=$(jq -r .sessionId <<<"$agent")
cwd=$(jq -r .cwd <<<"$agent")
pid=$(jq -r '.pid // empty' <<<"$agent")

if [[ "$kind" == background ]] && { jay_in_hub || jay_hub_live; }; then
  # The turn chain of a background agent is named after its id (see jay-snapshot). The
  # hub Claude works in no worktree: review stays on what it shows.
  hub_pick() {
    jay_hub_show "$id" "$title" "$cwd" || return
    [[ "$id" == "$hubid" ]] || jay_hub_target "$cwd" "$id"
  }
  jay_hub_locked hub_pick || { echo "Could not show $id in the hub." >&2; exit 1; }
  # The list's cursor follows (a list pick has it there already). Detached: called from a list
  # key (n), the list's fzf answers only after this script ends.
  row=$sid
  [[ "$id" == "$hubid" ]] && row=hub
  [[ -n "${JAY_LIST_PICK:-}" ]] || (jay_list_follow "$row" &) >/dev/null 2>&1
  if ! jay_in_hub && tab=$(jay_gh_tab_for_session "$JAY_SESSION"); then
    jay_gh_select "$tab"
  fi
  exit 0
fi

# Without the hub, the agent comes in front through a tab (Ghostty only, see jay_gh_ok). The user
# sees it there: not unread (jay_agent_phases). In the hub, jay_hub_show marks it.
if ! jay_gh_ok; then
  if [[ "$kind" == background ]]; then
    echo "Bringing $id in front needs the hub or Ghostty. Attach in a terminal: claude attach $id" >&2
  else
    echo "Session $sid runs in its own terminal (pid $pid). Bringing it in front needs Ghostty." >&2
  fi
  exit 1
fi
jay_mark seen "${id:-$sid}"

if [[ "$kind" == background ]]; then
  if tab=$(jay_gh_tab_for_command "^claude attach $id"); then
    jay_gh_select "$tab"
  else
    jay_gh_new_tab "$cwd" "claude attach $id" >/dev/null
  fi
  exit 0
fi

tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
if [[ -n "$tty" && "$tty" != "??" ]] && tab=$(jay_gh_tab_for_tty "$tty"); then
  jay_gh_select "$tab"
  exit 0
fi

top=$(jay_toplevel "$cwd")
while IFS= read -r session; do
  pane=$(jay_panes_in "$session" "$top" '^claude' | head -1)
  [[ -n "$pane" ]] || continue
  if tab=$(jay_gh_tab_for_session "$session"); then
    jay_gh_select "$tab"
  else
    jay_gh_new_tab "$top" "zellij attach $session" >/dev/null
  fi
  jay_focus_pane "$session" "$(jq -r .id <<<"$pane")" "$(jq -r .tab_name <<<"$pane")"
  exit 0
done < <(jay_live_sessions)

echo "Session $sid runs (pid $pid) but not in a Ghostty tab or zellij pane I can find." >&2
exit 1
