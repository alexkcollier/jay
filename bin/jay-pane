#!/usr/bin/env bash
# jay-pane agent|review|files — a pane of the hub that follows its target.
# The target is a line in ~/.local/state/jay/<role>.target (jay_hub_point writes it and stops
# the running program, so the pane starts it again for the new target).
# agent:  `claude attach` on the picked agent, in the middle column; the pane never closes. A
#         fresh hub opens on the hub Claude (a background agent, see jay_hub_claude).
#         When you leave the agent (Ctrl+Z, or ←: the list is the agent view here), it keeps
#         running and Enter opens it again. An interactive agent runs in its own terminal tab:
#         the pane says so. When attach fails at once (say the agent's worktree is gone), its
#         error stays on screen.
# review: tuicr in one of two modes (review.mode), switched with `t` (jay-keys); the
#         title starts with the mode.
#         turns: the agent's turn chain (refs/wt-turns/<agent id or session8>), else the newest
#         chain in the worktree, else tuicr's own target picker. A chain opens on its last
#         turn, or on the running turn (live) while the agent works; `(` shows all turns.
#         commits: the branch's own commits (since it left main), else tuicr's picker.
#         q in tuicr starts it again (back to the picker or the last turn). e shows files.
#         A new turn (or commit) starts tuicr again by itself, on the newest turn; also over
#         the picker, when the first turn (or running turn) comes. A running turn that moves
#         does not: q shows its newest state.
#         JAY_REVIEW=lazygit: lazygit in the same two modes instead (jay-lazygit). It follows
#         new turns without a restart; its t and e are its own custom commands.
# files:  yazi in the worktree. It covers review; e or q quits yazi and review comes back
#         (e from the hub's yazi keymap, config/yazi).
set -uo pipefail
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
JAY_SESSION=${ZELLIJ_SESSION_NAME:-${JAY_SESSION:-${WT_HUB_SESSION:-jay}}}
source "$HOME/.local/lib/jay-lib.sh"
reviewer=tuicr
[[ "${JAY_REVIEW:-}" == lazygit ]] && reviewer=lazygit

role=$1
target_file=$(jay_hub_target_file "$role")
self=$(jay_mux_self)
jay_hub_pane_record "$self" "$role" $$
trap 'jay_hub_pane_gone "$role" $$' EXIT

target() { cat "$target_file" 2>/dev/null; }

# Programs stopped by a retarget can leave mouse modes or the other screen on. With `keep`, the
# text on screen stays.
reset_screen() {
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?2004l\e[?1049l\e[?25h'
  stty sane 2>/dev/null
  [[ "${1:-}" == keep ]] || clear
}

# Wait until the target changes (0) or Enter is pressed (1).
wait_change() {
  local rc
  while [[ "$(target)" == "$1" ]]; do
    read -r -t 1 _ && return 1
    rc=$?
    ((rc > 128)) || sleep 0.5
  done
  return 0
}

# The turn chain of agent $1 (id or session id), else the newest chain of this worktree: one
# with a turn (head) or a running turn (live).
chain() {
  local session=${1:0:8} candidate here
  if [[ -n "$session" ]]; then
    tip "$session" >/dev/null && printf '%s\n' "$session"
    return
  fi
  here=$(pwd -P)
  git for-each-ref --sort=-committerdate --format='%(refname)' 'refs/wt-turns/*/head' 'refs/wt-turns/*/live' \
    | sed -E 's#^refs/wt-turns/([^/]+)/(head|live)$#\1#' | while read -r candidate; do
      [[ "$(cat "$JAY_STATE/turns/$candidate.worktree" 2>/dev/null)" -ef "$here" ]] && { printf '%s\n' "$candidate"; break; }
    done
}

# The newest commit of chain $1: the running turn (live), else the last turn (head).
tip() {
  local r
  for r in live head; do
    git rev-parse -q --verify "refs/wt-turns/$1/$r" >/dev/null && { printf 'refs/wt-turns/%s/%s\n' "$1" "$r"; return 0; }
  done
  return 1
}

# tuicr opens a turn chain with all turns selected and has no option to start on the newest;
# `(` selects it (and pressed again, all turns). Wait until the review shows its Commits panel
# (the header can be cut off in a narrow pane), then type `(` into this pane. A hidden review
# (Ctrl g v) has no size and shows nothing: wait until it is shown. A retarget kills this helper
# with tuicr.
select_last_turn() {
  local i=0
  [[ -n "$self" ]] || return 0
  while ((i < 40)); do
    sleep 0.25
    [[ -f "$JAY_HIDDEN" ]] || i=$((i + 1))
    [[ "$(target)" == "$1" ]] || return 0
    if jay_mux_read "$self" | head -4 | grep -q '┌ Commits ─'; then
      jay_mux_type "$self" '('
      return 0
    fi
  done
}

# What review follows in turns mode: the agent's chain head ($1, an agent id or session id), or
# for a worktree pick the newest chain of the worktree and its head. A running turn (live) moves
# often, so only its start counts, and only on a chain with no head yet: when the chain comes
# after review opened (an agent's first turn), it opens over tuicr's picker.
turns_state() {
  local id=${1:0:8} head
  [[ -n "$id" ]] || id=$(chain "")
  head=$(git rev-parse -q --verify "refs/wt-turns/$id/head")
  [[ -z "$head" ]] && git rev-parse -q --verify "refs/wt-turns/$id/live" >/dev/null && head=live
  printf '%s %s\n' "$id" "$head"
}

# New turns come in by themselves: when the output of "$@" changes (turns_state: a turn's
# snapshot or a new chain; in commits mode HEAD: a new commit), stop tuicr so the loop starts it
# again on the newest turn. Only while tuicr's status line shows NORMAL or SELECT (also on its
# picker): never over a comment being typed (it waits until then).
follow() {
  local was p
  was=$("$@")
  while sleep 2; do
    [[ "$("$@")" == "$was" ]] && continue
    jay_mux_read "$self" | grep -v '^[[:space:]]*$' | tail -1 \
      | grep -qE '^[[:space:]]*(NORMAL|SELECT)' || continue
    for p in $(pgrep -P $$ -f jay-keys); do
      jay_kill_children "$p"
      kill -TERM "$p" 2>/dev/null
    done
    return 0
  done
}

# tuicr on range $1 (empty: tuicr's picker) that starts again when the output of the rest
# changes (follow). Returns tuicr's status (99: jay-keys' `t`).
review_range() {
  local range=$1 watcher rc
  shift
  follow "$@" &
  watcher=$!
  "$HOME/.local/bin/jay-keys" tuicr --no-update-check ${range:+-r "$range"}
  rc=$?
  kill "$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null # no "Terminated" line on the screen
  return $rc
}

# The commit the worktree's branch left its main branch at; empty when it has no commits of its
# own (or there is no main branch).
branch_base() {
  local main base
  main=$(git rev-parse -q --abbrev-ref origin/HEAD 2>/dev/null)
  if [[ -z "$main" || "$main" == origin/HEAD ]]; then
    main=""
    for base in main master; do
      git rev-parse -q --verify "refs/heads/$base" >/dev/null && { main=$base; break; }
    done
  fi
  [[ -n "$main" ]] || return 0
  base=$(git merge-base HEAD "$main" 2>/dev/null) || return 0
  [[ "$base" != "$(git rev-parse HEAD)" ]] && printf '%s\n' "$base"
}

# ← in `claude attach` turns it into Claude's agent view (`claude agents`, same process). In
# the hub the list is that view, so it is stopped, as if you left the agent.
leave_agent_view() {
  while sleep 0.5; do
    pkill -TERM -P $$ -f 'claude agents' && return 0
  done
}

# Run the role's program for target line $1 in the foreground.
run() {
  local id path session base kind name rc last=""
  case $role in
    agent)
      IFS=$'\t' read -r id path kind name <<<"$1"
      cd "$path" 2>/dev/null || cd "$HOME"
      if [[ "$kind" == interactive ]]; then
        printf '\n  %s runs in its own terminal tab.\n\n  o in the list: go to that tab.\n  b in the list: make it a background agent.\n  Review shows its turns.\n' "$name"
        wait_change "$1"
        return 0
      fi
      leave_agent_view &
      claude attach "$id"
      rc=$?
      kill $! 2>/dev/null
      wait $! 2>/dev/null # no "Terminated" line on the screen
      return $rc ;;
    review)
      IFS=$'\t' read -r path session <<<"$1"
      cd "$path" || return
      # lazygit (JAY_REVIEW=lazygit): its `t` toggles the mode itself and stops it. An agent
      # with no chain yet gets its view at once: it fills when the first (running) turn comes.
      if [[ "$reviewer" == lazygit ]]; then
        if [[ "$(jay_hub_mode)" == commits ]]; then
          "$HOME/.local/bin/jay-lazygit" commits
        else
          id=$(chain "$session")
          "$HOME/.local/bin/jay-lazygit" turns "${id:-${session:0:8}}"
        fi
        return
      fi
      # jay-keys exits 99 for `t` (toggle turns ⇄ commits).
      # With nothing to review yet, tuicr's picker opens, and review follows on as well: a
      # branch's first commit, an agent's first turn.
      if [[ "$(jay_hub_mode)" == commits ]]; then
        base=$(branch_base)
        review_range "${base:+$base..HEAD}" git rev-parse -q --verify HEAD
        return
      fi
      id=$(chain "$session")
      [[ -n "$id" ]] && last=$(tip "$id")
      if [[ -n "$id" ]] && (($(git rev-list --count "refs/wt-turns/$id/base..$last") > 1)); then
        select_last_turn "$1" &
      fi
      review_range "${id:+refs/wt-turns/$id/base..$last}" turns_state "$session" ;;
    files)
      cd "$1" || return
      YAZI_CONFIG_HOME="$HOME/.config/jay/yazi" yazi "$1" ;;
  esac
}

# A fresh hub opens on the hub Claude (jay_hub_claude starts it when it has none). Review stays
# empty: the hub Claude works in no worktree.
if [[ "$role" == agent && -z "$(target)" ]]; then
  printf '\n  Opening the hub Claude...\n'
  if hubid=$(jay_hub_claude 2>/dev/null); then
    [[ -z "$(target)" ]] && jay_hub_write_target agent "$(printf '%s\t%s' "$hubid" "${JAY_ROOTS%%:*}")"
  fi
  clear
fi

while :; do
  now=$(target)
  if [[ -z "$now" ]]; then
    if [[ "$role" == agent ]]; then
      printf '\n  Agent\n\n  Pick an agent in the list.\n  ◆ hub: the hub Claude.\n  n in the list: a new agent.\n'
    else
      printf '\n  Review\n\n  Pick a worktree or an agent in the list.\n  %s opens here for its turns.\n  e in %s: files (yazi); e in files: review.\n' "$reviewer" "$reviewer"
    fi
    wait_change "" || true
    clear
    continue
  fi
  started=$SECONDS mode=$(jay_hub_mode)
  run "$now"
  rc=$?
  # 143: stopped (← in attach, see leave_agent_view), not failed.
  if [[ "$role" == agent && "$(target)" == "$now" ]] && ((rc != 0 && rc != 143 && SECONDS - started < 5)); then
    reset_screen keep
    printf '\n  Could not open this agent (see above).\n  Pick another agent, or Enter: try again.\n'
    wait_change "$now" || true
    clear
    continue
  fi
  reset_screen
  [[ "$(target)" != "$now" ]] && continue
  # You left the agent (or pressed Enter on an interactive agent's note). The target is cleared,
  # so a pick of the same agent opens it again too.
  if [[ "$role" == agent ]]; then
    IFS=$'\t' read -r _ _ kind _ <<<"$now"
    if [[ "$kind" != interactive ]]; then
      jay_hub_write_target agent ""
      printf '\n  You left this agent. It keeps running.\n\n  Enter: open it again.\n  Or pick an agent in the list.\n'
      wait_change "" || jay_hub_write_target agent "$now"
      clear
    fi
    continue
  fi
  if [[ "$role" == review ]]; then
    ((rc == 99)) && jay_hub_toggle_mode
    # A toggle (t) starts tuicr again in the other mode, under a new title.
    if [[ "$(jay_hub_mode)" != "$mode" ]]; then
      jay_hub_retitle review
      continue
    fi
  fi
  # q in tuicr (q_quits, config/tuicr/config.toml) means "back": start it again at once, so a
  # review opened from tuicr's start screen returns to it. A quick exit is an error: ask first.
  [[ "$role" == review ]] && ((SECONDS - started >= 2)) && continue
  # You left the program yourself: the pane closes and the one under it comes back. Review
  # gets its title after that (the delay outlives the pane, so HUP is ignored).
  if [[ "$role" == files ]]; then
    (trap '' HUP; sleep 0.5; jay_hub_retitle review) >/dev/null 2>&1 &
  fi
  [[ "$role" == review ]] || exit 0
  printf '\n  %s closed. Enter: open it again (it re-reads the turns).\n' "$reviewer"
  wait_change "$now" || true
  clear
done
